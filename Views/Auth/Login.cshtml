<script src="/assets/toast.js" asp-append-version="true"></script>
<script>
  const LSTEP_RING = 'M3 12c0 -4.97 4.03 -9 9 -9c4.97 0 9 4.03 9 9c0 4.97 -4.03 9 -9 9c-4.97 0 -9 -4.03 -9 -9Z';
  const LSTEP_CURRENT = `<svg viewBox="0 0 24 24" width="100%" height="100%"><path fill="currentColor" fill-opacity="0" stroke="currentColor" stroke-dasharray="60" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="60;0"/><animate fill="freeze" attributeName="fill-opacity" begin="0.6s" dur="0.15s" to=".3"/></path></svg>`;
  const LSTEP_UPCOMING = `<svg viewBox="0 0 24 24" width="100%" height="100%"><path fill="none" stroke="currentColor" stroke-dasharray="60" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="60;0"/></path></svg>`;
  const LSTEP_UPCOMING_TO_CURRENT = `<svg viewBox="0 0 24 24" width="100%" height="100%"><g><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="1;0"/></g><g opacity="0"><path fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="0;1"/></g></svg>`;
  const LSTEP_CURRENT_TO_UPCOMING = `<svg viewBox="0 0 24 24" width="100%" height="100%"><g><path fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="1;0"/></g><g opacity="0"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="0;1"/></g></svg>`;
  function lstepDone(suffix, animate){
    const maskId = 'lstepDoneMask' + suffix;
    const checkPath = animate
      ? '<path fill="none" stroke="#000" stroke-dasharray="14" d="M8 12l3 3l5 -5"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.2s" values="14;0"/></path>'
      : '<path fill="none" stroke="#000" d="M8 12l3 3l5 -5"/>';
    return `<svg viewBox="0 0 24 24" width="100%" height="100%"><defs><mask id="${maskId}"><g stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path fill="#fff" stroke="#fff" d="${LSTEP_RING}"/>${checkPath}</g></mask></defs><path fill="currentColor" d="M0 0h24v24H0z" mask="url(#${maskId})"/></svg>`;
  }

  function lstepDoneToCurrent(suffix){
    const maskId = 'lstepDoneToCurrentMask' + suffix;
    return `<svg viewBox="0 0 24 24" width="100%" height="100%"><defs><mask id="${maskId}"><g stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path fill="#fff" stroke="#fff" d="${LSTEP_RING}"/><path fill="none" stroke="#000" stroke-dasharray="14" d="M8 12l3 3l5 -5"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.2s" values="0;14"/></path></g></mask></defs><g><path fill="currentColor" d="M0 0h24v24H0z" mask="url(#${maskId})"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="1;0"/></g><g opacity="0"><path fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${LSTEP_RING}"/><animate fill="freeze" attributeName="opacity" begin="0.35s" dur="0.25s" values="0;1"/></g></svg>`;
  }

  const lstepAnimated = new Set();

  function markLoginStepDone(){
    const node2 = document.getElementById('lnode2');
    if(!node2) return;
    node2.classList.remove('active');
    node2.classList.add('done');
    renderLoginStepper();
  }

  function renderLoginStepper(){
    document.querySelectorAll('.lstepper .lnode').forEach((node,i)=>{
      const newState = node.classList.contains('done') ? 'done'
        : (node.classList.contains('active') ? 'current' : 'upcoming');
      const oldState = node.dataset.state || null;
      if(newState === oldState) return; 

      const circle = node.querySelector('.lcircle');
      if(newState === 'done'){
        circle.innerHTML = lstepDone(i, !lstepAnimated.has(i));
        lstepAnimated.add(i);
      } else if(newState === 'current'){
        if(oldState === 'done') circle.innerHTML = lstepDoneToCurrent(i);
        else if(oldState === 'upcoming') circle.innerHTML = LSTEP_UPCOMING_TO_CURRENT;
        else circle.innerHTML = LSTEP_CURRENT;
      } else {
        circle.innerHTML = oldState === 'current' ? LSTEP_CURRENT_TO_UPCOMING : LSTEP_UPCOMING;
      }
      node.dataset.state = newState;
    });
  }
  renderLoginStepper();

  let selectedRole = null;

  const METHODS = {
    beneficiary: [
      {key:'nafath', label:'الدخول عبر نفاذ', desc:'باستخدام حسابك الموحد في النفاذ الوطني', icon:'nafath'},
      {key:'email', label:'البريد الإلكتروني للعمل', desc:'بريد شركتك وكلمة المرور', icon:'email'}
    ],
    o3p: [
      {key:'nafath', label:'الدخول عبر نفاذ', desc:'باستخدام حسابك الموحد في النفاذ الوطني', icon:'nafath'},
      {key:'ad', label:'حساب الدخول الموحد (AD)', desc:'اسم المستخدم وكلمة المرور الخاصة بالأمانة', icon:'ad'},
      {key:'email', label:'البريد الإلكتروني الرسمي', desc:'بريد madinah.gov.sa وكلمة المرور', icon:'email'}
    ],
    admin: [
      {key:'nafath', label:'الدخول عبر نفاذ', desc:'باستخدام حسابك الموحد في النفاذ الوطني', icon:'nafath'},
      {key:'ad', label:'حساب الدخول الموحد (AD)', desc:'اسم المستخدم وكلمة المرور الخاصة بالأمانة', icon:'ad'},
      {key:'email', label:'البريد الإلكتروني الرسمي', desc:'بريد madinah.gov.sa وكلمة المرور', icon:'email'}
    ]
  };
  const ICON = {
