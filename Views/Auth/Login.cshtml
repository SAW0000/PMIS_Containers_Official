  const SPIN_RING_SM = '<svg viewBox="0 0 24 24" width="16" height="16" style="flex-shrink:0"><g stroke="currentColor"><circle cx="12" cy="12" r="9.5" fill="none" stroke-linecap="round" stroke-width="3"><animate attributeName="stroke-dasharray" calcMode="spline" dur="1.5s" keySplines="0.42,0,0.58,1;0.42,0,0.58,1;0.42,0,0.58,1" keyTimes="0;0.475;0.95;1" repeatCount="indefinite" values="0 150;42 150;42 150;42 150"/><animate attributeName="stroke-dashoffset" calcMode="spline" dur="1.5s" keySplines="0.42,0,0.58,1;0.42,0,0.58,1;0.42,0,0.58,1" keyTimes="0;0.475;0.95;1" repeatCount="indefinite" values="0;-16;-59;-59"/></circle><animateTransform attributeName="transform" dur="2s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12"/></g></svg>';

  function csrfToken(){
    const meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.content : '';
  }

  function replaySvgAnimations(container){
    if(!container) return;
    const svg = container.querySelector('svg');
    if(!svg) return;
    const clone = svg.cloneNode(true);
    svg.replaceWith(clone);
  }

  function selectRole(role){
    selectedRole = role;
    document.querySelectorAll('.role-opt').forEach(el=>{
      const isMatch = el.getAttribute('data-role')===role;
      el.classList.toggle('selected', isMatch);
      if(isMatch){
        replaySvgAnimations(el.querySelector('.role-ic'));
        replaySvgAnimations(el.querySelector('.role-check'));
      }
    });
    document.getElementById('continueBtn').disabled = false;
  }

  function goToStep2(){
    if(!selectedRole) return;
    document.getElementById('lpanel1').classList.remove('active');
    document.getElementById('lpanel2').classList.add('active');
    document.getElementById('lnode1').classList.add('done');
    document.getElementById('lnode1').classList.remove('active');
    document.getElementById('lnode2').classList.add('active');
    renderLoginStepper();
    document.getElementById('panel2Hint').textContent = selectedRole==='beneficiary'
      ? 'اختر طريقة الدخول المناسبة لحسابك'
      : 'اختر طريقة الدخول المعتمدة لموظفي الأمانة';

    const list = document.getElementById('methodList');
    list.classList.remove('has-active');
    list.innerHTML = METHODS[selectedRole].map((m,i)=>`
      <div class="method-row" data-method-row="${m.key}">
        <button type="button" class="method-opt" data-method="${m.key}" onclick="toggleMethod('${m.key}')">
          <div class="method-ic">${ICON[m.icon]}</div>
          <div class="method-text"><b>${m.label}</b><span>${m.desc}</span></div>
          <svg class="chev" viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-dasharray="12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M12 16l-7 -7M12 16l7 -7"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="12;0"/></path></svg>
        </button>
        <div class="method-form" id="form-${m.key}">${renderMethodForm(m.key)}</div>
      </div>
    `).join('');
  }

  function renderMethodForm(key){
    if(key==='nafath'){
      return `<div class="method-form-inner">
        <button type="button" class="pill-btn pill-primary" id="nafathBtn" onclick="startNafath()">
          متابعة عبر نفاذ
          <svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-dasharray="12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M8 12l7 -7M8 12l7 7"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="12;0"/></path></svg>
        </button>
      </div>`;
    }
    if(key==='ad'){
      return `<div class="method-form-inner">
        <div class="field-pill">
          <div class="fic"><svg viewBox="0 0 24 24" width="17" height="17"><g fill="none" stroke="currentColor" stroke-dasharray="28" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 21v-1c0 -3.31 2.69 -6 6 -6h4c3.31 0 6 2.69 6 6v1"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="28;0"/></path><path stroke-dashoffset="28" d="M12 11c-2.21 0 -4 -1.79 -4 -4c0 -2.21 1.79 -4 4 -4c2.21 0 4 1.79 4 4c0 2.21 -1.79 4 -4 4Z"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.4s" dur="0.4s" to="0"/></path></g></svg></div>
          <input type="text" placeholder="اسم المستخدم" autocomplete="username">
        </div>
        <div class="field-pill">
          <div class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg></div>
          <input type="password" placeholder="كلمة المرور" autocomplete="current-password">
          <button type="button" class="toggle-eye" onclick="toggleEye(this)">${iconEyeSlashed()}</button>
        </div>
        <button type="button" class="pill-btn pill-primary" onclick="finishLogin(this)">تسجيل الدخول</button>
      </div>`;
    }
    return `<div class="method-form-inner">
      <div class="field-pill">
        <div class="fic"><svg viewBox="0 0 24 24" width="17" height="17"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="66" d="M4 5h16c0.55 0 1 0.45 1 1v12c0 0.55 -0.45 1 -1 1h-16c-0.55 0 -1 -0.45 -1 -1v-12c0 -0.55 0.45 -1 1 -1Z"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="66;0"/></path><path stroke-dasharray="24" stroke-dashoffset="24" d="M3 6.5l9 5.5l9 -5.5"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.6s" dur="0.3s" to="0"/></path></g></svg></div>
        <input type="email" id="emailLoginEmail" placeholder="${selectedRole==='beneficiary'?'name@@company.com':'name@@madinah.gov.sa'}" autocomplete="username">
      </div>
      <div class="field-pill">
        <div class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg></div>
        <input type="password" id="emailLoginPassword" placeholder="كلمة المرور" autocomplete="current-password">
        <button type="button" class="toggle-eye" onclick="toggleEye(this)">${iconEyeSlashed()}</button>
      </div>
      <div class="form-error" id="emailLoginError" style="display:none;color:var(--danger,#c0392b);font-size:12.5px;"></div>
      <button type="button" class="pill-btn pill-primary" onclick="finishLogin(this,'email')">تسجيل الدخول</button>
      <div class="forgot-row">
        <a href="#" onclick="return false;">نسيت كلمة المرور؟</a>${selectedRole==='beneficiary' ? '<span class="forgot-sep">·</span><a href="#" onclick="startRegisterViaNafath();return false;">إنشاء حساب جديد</a>' : ''}
      </div>
    </div>`;
  }

  const DISABLED_METHOD_MESSAGES = {
    email: 'تسجيل دخول عن طريق الإيميل غير متاح حاليا',
    ad: 'تسجيل دخول عن طريقة اكسيس دايريكتوري غير متاح حاليا'
  };

  function toggleMethod(key){
    if(DISABLED_METHOD_MESSAGES[key]){
      showToast(DISABLED_METHOD_MESSAGES[key], 'warning');
      return;
    }

    const list = document.getElementById('methodList');
    const alreadyActive = document.querySelector(`.method-opt[data-method="${key}"]`).classList.contains('active');
    const nextKey = alreadyActive ? null : key;

    list.classList.toggle('has-active', !!nextKey);
    document.querySelectorAll('.method-row').forEach(el=>{
      el.classList.toggle('is-active', el.getAttribute('data-method-row')===nextKey);
    });
    document.querySelectorAll('.method-opt').forEach(el=>{
      const isMatch = el.getAttribute('data-method')===nextKey;
      el.classList.toggle('active', isMatch);
      if(isMatch) replaySvgAnimations(el.querySelector('.method-ic'));
    });
    document.querySelectorAll('.method-form').forEach(el=>el.classList.toggle('open', el.id==='form-'+nextKey));
    if(nextKey==='nafath') showNafathBrand();
    else if(!nextKey) showAmanaBrand();
  }

  function showNafathBrand(){
    document.querySelector('.brand-panel .brand-logo').style.display = 'none';
    document.querySelector('.brand-panel .brand-wordmark').style.display = 'none';
    const nafathWrap = document.getElementById('nafathLogoWrap');
    nafathWrap.classList.add('active');
    replaySvgAnimations(nafathWrap);
  }

  function showAmanaBrand(){
    document.getElementById('nafathLogoWrap').classList.remove('active');
    const logoWrap = document.querySelector('.brand-panel .brand-logo');
    const wordmarkWrap = document.querySelector('.brand-panel .brand-wordmark');
    logoWrap.style.display = '';
    wordmarkWrap.style.display = '';
    replaySvgAnimations(logoWrap);
    replaySvgAnimations(wordmarkWrap);
  }

  function iconEyeOpen(){
    const mid = 'icEyeOpen'+(iconEyeOpen.seq=(iconEyeOpen.seq||0)+1);
    return `<svg viewBox="0 0 24 24" width="16" height="16"><defs><mask id="${mid}"><path fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12c1.72 -3.83 5.53 -6.5 10 -6.5c4.47 0 8.28 2.67 10 6.5c-1.72 3.83 -5.53 6.5 -10 6.5c-4.47 0 -8.28 -2.67 -10 -6.5Z"/><circle cx="12" cy="12" r="3" fill="#fff"/><path fill="none" stroke="#000" stroke-dasharray="26" stroke-dashoffset="0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 11h24" transform="rotate(45 12 12)"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.05s" dur="0.3s" to="26"/></path></mask></defs><path fill="currentColor" d="M0 0h24v24H0z" mask="url(#${mid})"/><path fill="none" stroke="currentColor" stroke-dasharray="26" stroke-dashoffset="0" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 13h24" transform="rotate(45 12 12)"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.05s" dur="0.3s" to="26"/></path></svg>`;
  }
  function iconEyeSlashed(){
    const mid = 'icEyeSlashed'+(iconEyeSlashed.seq=(iconEyeSlashed.seq||0)+1);
    return `<svg viewBox="0 0 24 24" width="16" height="16"><defs><mask id="${mid}"><path fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12c1.72 -3.83 5.53 -6.5 10 -6.5c4.47 0 8.28 2.67 10 6.5c-1.72 3.83 -5.53 6.5 -10 6.5c-4.47 0 -8.28 -2.67 -10 -6.5Z"/><circle cx="12" cy="12" r="3" fill="#fff"/><path fill="none" stroke="#000" stroke-dasharray="26" stroke-dashoffset="26" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 11h24" transform="rotate(45 12 12)"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.05s" dur="0.3s" to="0"/></path></mask></defs><path fill="currentColor" d="M0 0h24v24H0z" mask="url(#${mid})"/><path fill="none" stroke="currentColor" stroke-dasharray="26" stroke-dashoffset="26" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 13h24" transform="rotate(45 12 12)"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.05s" dur="0.3s" to="0"/></path></svg>`;
  }
  function toggleEye(btn){
    const input = btn.previousElementSibling;
    const reveal = input.type === 'password';
    input.type = reveal ? 'text' : 'password';
    btn.innerHTML = reveal ? iconEyeOpen() : iconEyeSlashed();
  }

  const NAFATH_ROLE_PARAM = {beneficiary:'ContractorConsultant', o3p:'P3OOfficer', admin:'SystemAdministrator'};

  function startNafath(){
    const btn = document.getElementById('nafathBtn');
    if(btn){
      btn.disabled = true;
      btn.innerHTML = `${SPIN_RING_SM}جارٍ التحويل إلى نفاذ...`;
    }
    markNafathAttemptPending();
    window.location.href = '/login/nafath?role=' + encodeURIComponent(NAFATH_ROLE_PARAM[selectedRole]);
  }

  function startRegisterViaNafath(){
    showToast('لإنشاء حساب جديد يرجى التحقق من خلال نفاذ اولا', 'warning');
    selectedRole = 'beneficiary';
    setTimeout(startNafath, 900);
  }

  function finishLogin(btn, method){
    if(method==='email'){
      emailLogin(btn);
      return;
    }
    const go = () => {
      markLoginStepDone();
      showToast('تم تسجيل الدخول بنجاح — جاري التحويل...', true);
      setTimeout(()=>{ window.location.href = '/app'; }, 700);
    };
    if(btn){
      btn.disabled = true;
      btn.innerHTML = `${SPIN_RING_SM}جارٍ تسجيل الدخول...`;
      setTimeout(go, 600);
    } else {
      go();
    }
  }

  async function emailLogin(btn){
    const emailEl = document.getElementById('emailLoginEmail');
    const passwordEl = document.getElementById('emailLoginPassword');
    const errorEl = document.getElementById('emailLoginError');
    errorEl.style.display = 'none';

    const email = emailEl.value.trim();
    const password = passwordEl.value;
    if(!email || !password){
      errorEl.textContent = 'البريد الإلكتروني وكلمة المرور مطلوبان';
      errorEl.style.display = 'block';
      return;
    }

    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `${SPIN_RING_SM}جارٍ تسجيل الدخول...`;

    try{
      const res = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
        body: JSON.stringify({ email, password, role: NAFATH_ROLE_PARAM[selectedRole] })
      });
      const data = await res.json().catch(()=>({}));

      if(!res.ok){
        errorEl.textContent = selectedRole === 'beneficiary'
          ? 'الحساب غير موجود يرجى الدخول عن طريق نفاذ اولا'
          : (data.message || 'تعذر تسجيل الدخول');
        errorEl.style.display = 'block';
        btn.disabled = false;
        btn.innerHTML = originalHtml;
        return;
      }

      markLoginStepDone();
      showToast('تم تسجيل الدخول بنجاح — جاري التحويل...', true);
