  function otpResendCooldownSeconds(){
    const meta = document.querySelector('meta[name="otp-resend-cooldown-seconds"]');
    const parsed = meta ? parseInt(meta.content, 10) : NaN;
    return Number.isFinite(parsed) && parsed > 0 ? parsed : 45;
  }

  async function submitCompleteProfile(btn){
    const email = document.getElementById('regEmail').value.trim();
    const mobile = document.getElementById('regMobile').value.trim();
    const errorEl = document.getElementById('registerError');
    errorEl.style.display = 'none';

    if(!email || !mobile){
      errorEl.textContent = 'جميع الحقول (باستثناء الصورة الشخصية) مطلوبة';
      errorEl.style.display = 'block';
      return;
    }

    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `${SPIN_RING_SM}جارٍ الإرسال...`;

    try{
      const res = await fetch('/register/send-verification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
        body: JSON.stringify({ email, mobile })
      });
      const data = await res.json().catch(()=>({}));

      if(!res.ok){
        showToast(data.message || 'تعذر إرسال رمز التحقق', 'warning');
        return;
      }

      document.getElementById('verifyEmailValue').textContent = email;
      document.getElementById('verifyMobileValue').textContent = mobile;

      document.getElementById('lpanelCompleteProfile').classList.remove('active');
      document.getElementById('lpanelVerify').classList.add('active');
      document.querySelector('.auth-top').style.display = 'none';

      resetVerifyPanel();
      startVerifyResendTimer(otpResendCooldownSeconds());
    } catch(err){
      showToast('توجد مشكلة في عملية التحقق', 'warning');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  }

  let verifyResendIntervalId = null;

  function resetVerifyPanel(){
    document.getElementById('verifyError').style.display = 'none';
    document.getElementById('verifyStatusMsg').textContent = 'لم يصلك الرمز؟';
    document.getElementById('verifyStatusMsg').classList.remove('err');
    document.querySelectorAll('#lpanelVerify .otp-inputs input').forEach(inp=>{
      inp.value = '';
      inp.classList.remove('filled');
    });
    document.querySelectorAll('#lpanelVerify .otp-inputs').forEach(g=>g.classList.remove('shake'));
    const verifyBtn = document.getElementById('verifyBtn');
    verifyBtn.disabled = false;
    verifyBtn.innerHTML = 'تأكيد<svg viewBox="0 0 24 24" width="16" height="16"><path fill="none" stroke="currentColor" stroke-dasharray="12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.6" d="M8 12l7 -7M8 12l7 7"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="12;0"/></path></svg>';

    const emailInputs = document.querySelectorAll('#otpEmailGroup input');
    emailInputs[emailInputs.length - 1].focus();
  }

  function stopVerifyResendTimer(){
    if(verifyResendIntervalId){
      clearInterval(verifyResendIntervalId);
      verifyResendIntervalId = null;
    }
  }

  function startVerifyResendTimer(seconds){
    stopVerifyResendTimer();
    let remaining = seconds || otpResendCooldownSeconds();
    const resendBtn = document.getElementById('verifyResendBtn');
    resendBtn.disabled = true;
    resendBtn.innerHTML = 'إعادة الإرسال خلال <span class="timer" id="verifyResendTimer">00:00</span>';
    const timerEl = document.getElementById('verifyResendTimer');

    const render = ()=>{
      const m = String(Math.floor(remaining / 60)).padStart(2, '0');
      const s = String(remaining % 60).padStart(2, '0');
      timerEl.textContent = `${m}:${s}`;
    };
    render();

    verifyResendIntervalId = setInterval(()=>{
      remaining--;
      if(remaining <= 0){
        stopVerifyResendTimer();
        resendBtn.disabled = false;
        resendBtn.innerHTML = 'إعادة الإرسال';
        return;
      }
      render();
    }, 1000);
  }

  async function resendVerifyCodes(){
    const resendBtn = document.getElementById('verifyResendBtn');
    if(resendBtn.disabled) return;

    const email = document.getElementById('regEmail').value.trim();
    const mobile = document.getElementById('regMobile').value.trim();
    const originalHtml = resendBtn.innerHTML;
    resendBtn.disabled = true;

    try{
      const res = await fetch('/register/resend-verification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
        body: JSON.stringify({ email, mobile })
      });
      const data = await res.json().catch(()=>({}));

      if(!res.ok){
        showToast(data.message || 'توجد مشكلة في عملية التحقق', 'warning');
        resendBtn.disabled = false;
        resendBtn.innerHTML = originalHtml;
        return;
      }

      startVerifyResendTimer(otpResendCooldownSeconds());
      showToast('تم إرسال رمزين جديدين إلى بريدك وجوالك', false);
    } catch(err){
      showToast('توجد مشكلة في عملية التحقق', 'warning');
      resendBtn.disabled = false;
      resendBtn.innerHTML = originalHtml;
    }
  }

  async function confirmVerification(btn){
    const emailCode = getOtpValue('otpEmailGroup');
    const mobileCode = getOtpValue('otpMobileGroup');
    const errorEl = document.getElementById('verifyError');
    errorEl.style.display = 'none';

    if(emailCode.length < 6 || mobileCode.length < 6){
      errorEl.textContent = 'يرجى إدخال الرمزين المكونين من 6 أرقام كاملين';
      errorEl.style.display = 'block';
      return;
    }

    const email = document.getElementById('regEmail').value.trim();
    const mobile = document.getElementById('regMobile').value.trim();

    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `${SPIN_RING_SM}جارٍ إنشاء الحساب...`;

    try{
      const formData = new FormData();
      formData.append('email', email);
      formData.append('mobile', mobile);
      formData.append('emailCode', emailCode);
      formData.append('mobileCode', mobileCode);
      const photoInput = document.getElementById('regPhoto');
      if(photoInput.files && photoInput.files[0]){
        formData.append('photo', photoInput.files[0]);
      }

      const res = await fetch('/register/complete-profile', { method: 'POST', headers: { 'X-CSRF-TOKEN': csrfToken() }, body: formData });
      const data = await res.json().catch(()=>({}));

      if(!res.ok){
        if(data.message === 'خطأ في عملية التحقق'){
          errorEl.textContent = data.message;
          errorEl.style.display = 'block';
          document.querySelectorAll('#lpanelVerify .otp-inputs').forEach(g=>{
            g.classList.remove('shake');
            void g.offsetWidth;
            g.classList.add('shake');
          });
        } else {
          showToast(data.message || 'توجد مشكلة في عملية التحقق', 'warning');
        }
        return;
      }

      stopVerifyResendTimer();
      showToast('تم إنشاء الحساب بنجاح — جاري التحويل...', true);
      setTimeout(()=>{ window.location.href = data.redirectUrl || '/app'; }, 500);
    } catch(err){
      showToast('توجد مشكلة في عملية التحقق', 'warning');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  }

  function getOtpValue(groupId){
    return [...document.querySelectorAll(`#${groupId} input`)]
      .map(inp=>inp.value)
      .join('');
  }

  document.querySelectorAll('.otp-inputs').forEach(group=>{
    const inputs = [...group.querySelectorAll('input')];
    inputs.forEach((inp, i)=>{
      inp.addEventListener('input', ()=>{
        inp.value = inp.value.replace(/[^0-9]/g, '').slice(0, 1);
        inp.classList.toggle('filled', inp.value.length > 0);
        if(inp.value && inputs[i - 1]) inputs[i - 1].focus();
      });
      inp.addEventListener('keydown', e=>{
        if(e.key === 'Backspace' && !inp.value && inputs[i + 1]) inputs[i + 1].focus();
        if(e.key === 'Tab' && !e.shiftKey){
          e.preventDefault();
          if(inputs[i - 1]) inputs[i - 1].focus();
          else focusNextFieldAfterOtpGroup(group);
        } else if(e.key === 'Tab' && e.shiftKey){
          e.preventDefault();
          if(inputs[i + 1]) inputs[i + 1].focus();
          else focusPrevFieldBeforeOtpGroup(group);
        }
      });
    });
  });

  function focusNextFieldAfterOtpGroup(group){
    const groups = [...document.querySelectorAll('#lpanelVerify .otp-inputs')];
    const idx = groups.indexOf(group);
    if(groups[idx + 1]){
      const nextInputs = groups[idx + 1].querySelectorAll('input');
      nextInputs[nextInputs.length - 1].focus();
    } else {
      document.getElementById('verifyBtn').focus();
    }
  }

  function focusPrevFieldBeforeOtpGroup(group){
    const groups = [...document.querySelectorAll('#lpanelVerify .otp-inputs')];
    const idx = groups.indexOf(group);
    if(groups[idx - 1]){
      groups[idx - 1].querySelector('input').focus();
    }
  }

  document.querySelectorAll('#lpanelCompleteProfile input').forEach(inp=>{
    inp.addEventListener('keydown', e=>{
      if(e.key === 'Enter'){ e.preventDefault(); submitCompleteProfile(document.getElementById('registerBtn')); }
    });
  });
  document.querySelectorAll('#lpanelVerify .otp-inputs input').forEach(inp=>{
    inp.addEventListener('keydown', e=>{
      if(e.key === 'Enter'){ e.preventDefault(); confirmVerification(document.getElementById('verifyBtn')); }
    });
  });

