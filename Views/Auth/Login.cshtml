    document.getElementById('pendingArabicGrandFatherName').textContent = pendingArabicGrandFatherName || '—';
    document.getElementById('pendingArabicFamilyName').textContent = pendingArabicFamilyName || '—';
    document.getElementById('pendingArabicNationality').textContent = pendingArabicNationality || '—';
    document.getElementById('pendingGender').textContent = pendingGender || '—';
    document.querySelector('.lstepper').style.display = 'none';
    document.getElementById('lpanel1').classList.remove('active');
    document.getElementById('lpanelCompleteProfile').classList.add('active');
    document.getElementById('topTitle').textContent = 'إكمال بيانات الحساب';
  }

  const nafathOutcomeHandled = Boolean(nafathError) || loggedOut || Boolean(confirmReauthRole)
    || Boolean(pendingNationalId) || Boolean(pendingFullName);
  if(nafathOutcomeHandled){
    clearNafathAttemptPending();
  } else {
    try {
      const pendingSince = parseInt(localStorage.getItem(NAFATH_PENDING_KEY) || '', 10);
      if(pendingSince && (Date.now() - pendingSince) < NAFATH_PENDING_MAX_AGE_MS){
        showToast('حدثت مشكلة اثناء عملية التحقق, الرجاء المحاولة مرة اخرى', 'warning');
      }
    } catch(e) {}
    clearNafathAttemptPending();
  }
</script>
</body>
</html>
