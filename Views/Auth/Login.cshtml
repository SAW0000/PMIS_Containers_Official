@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="@ViewBag.AntiForgeryToken">
<meta name="otp-resend-cooldown-seconds" content="@ViewBag.OtpResendCooldownSeconds">
<title>تسجيل الدخول — خدمة طلب شراء رخص نظام إدارة المشاريع</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" asp-append-version="true">
<link rel="stylesheet" href="/assets/styles.css" asp-append-version="true">
<script src="/assets/lockdown.js" asp-append-version="true" defer></script>
<script>
  try{ if(localStorage.getItem('pmis-theme')==='dark') document.documentElement.setAttribute('data-theme','dark'); }catch(e){}
  try{ const b=localStorage.getItem('pmis-brand'); if(b!=='blue') document.documentElement.setAttribute('data-brand', 'amana'); }catch(e){}
</script>
<style>
  html{height:auto;min-height:100%;overflow-y:auto;touch-action:pan-y;overscroll-behavior:auto;}
  body{
    min-height:100vh;
    height:auto;overflow-y:auto;overflow-x:hidden;
    touch-action:pan-y;
    overscroll-behavior:auto;
    display:flex;
    align-items:safe center;
    justify-content:center;
    padding:28px 16px;
    background:var(--bg);
    position:relative;
  }
  body::before{
    content:"";position:fixed;z-index:0;pointer-events:none;
    border-radius:50%;
    will-change:transform,opacity;
    top:-10%;left:-10%;width:60vw;height:60vw;
    background:radial-gradient(circle, var(--bg-glow-a) 0%, transparent 70%);
    animation:bg-breathe-a 16s ease-in-out infinite;
  }
  @@keyframes bg-breathe-a{
    0%,100%{transform:scale(1) translate(0,0);opacity:.85;}
    50%{transform:scale(1.15) translate(-2%,2%);opacity:1;}
  }
  .login-layout,.theme-toggle-float{position:relative;z-index:1;}
  .theme-toggle-float{
    position:fixed;bottom:18px;right:18px;
    width:40px;height:40px;border-radius:11px;border:1px solid var(--border);
    background:var(--card);color:var(--text-mid);display:flex;align-items:center;justify-content:center;
    cursor:pointer;box-shadow:var(--shadow);
  }
  :root[data-theme="dark"] .theme-toggle-float{border-color:transparent;}
  .theme-toggle-float svg{width:18px;height:18px;}

  .login-layout{display:flex;align-items:center;justify-content:center;gap:56px;direction:ltr;}
  .brand-panel{
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
    flex-shrink:0;
    width:280px;
    position:relative;
    transform:translateX(-34px);
  }
  .brand-panel .brand-logo{width:280px;height:auto;}
  .brand-panel .brand-logo svg{width:100%;height:auto;display:block;transform:scale(2.4);}
  .brand-panel .brand-wordmark{width:320px;height:auto;margin-top:56px;}
  .brand-panel .brand-wordmark svg{width:100%;height:auto;display:block;}
  .brand-panel .nafath-logo{
    width:400px;height:auto;display:none;
    position:absolute;top:50%;left:50%;
    transform:translate(-50%,-50%) translateX(-24px);
  }
  .brand-panel .nafath-logo svg{width:100%;height:auto;display:block;}
  .brand-panel .nafath-logo.active{display:block;}

  @@media (max-width:980px){
    .login-layout{flex-direction:column;gap:26px;}
  }

  .auth-shell{width:100%;max-width:452px;min-width:452px;}
  @@media (max-width:980px){
    .auth-shell{min-width:0;}
  }
  .auth-card{
    direction:rtl;
    background:var(--glass-bg);backdrop-filter:var(--glass-blur);-webkit-backdrop-filter:var(--glass-blur);
    border-radius:22px;box-shadow:var(--shadow-lg);
    border:1px solid var(--glass-border);
    animation:auth-card-fadein 1.6s ease;
    display:flex;flex-direction:column;
    max-height:calc(100vh - 56px);
  }
  @@keyframes auth-card-fadein{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
  .auth-top{
    padding:30px 28px 4px;position:relative;color:var(--text-dark);
    text-align:center;flex-shrink:0;
    border-radius:22px 22px 0 0;overflow:hidden;
  }
  .auth-top h1{font-size:clamp(11px,4vw,20px);margin:0;font-weight:800;white-space:nowrap;}

  .auth-bottom{
    padding:22px 28px 30px;position:relative;
    overflow-y:auto;border-radius:0 0 22px 22px;
    scrollbar-width:none;-ms-overflow-style:none;
  }
  .auth-bottom::-webkit-scrollbar{display:none;}

  .lstepper{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:0;margin-bottom:22px;}
  .lnode{display:flex;flex-direction:column;align-items:center;gap:6px;}
  .lcircle{
    width:28px;height:28px;border-radius:50%;color:var(--text-faint);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:4px;
  }
  .lnode.active .lcircle,.lnode.done .lcircle{color:var(--brand-900);}
  .llabel{font-size:10.5px;font-weight:700;color:var(--text-light);}
  .lnode.active .llabel,.lnode.done .llabel{color:var(--text-dark);}
  .lline{width:52px;height:2px;background:var(--border);margin:0 6px 18px;position:relative;overflow:hidden;}
  .lline::after{
    content:"";position:absolute;inset:0;background:var(--brand-800);
    transform:scaleX(0);transform-origin:right center;
    transition:transform .5s ease;
  }
  .lnode.done + .lline::after{transform:scaleX(1);}

  .lpanel{display:none;}
  .lpanel.active{display:block;animation:fadein .2s ease;}
  .panel-hint{font-size:12.5px;color:var(--text-mid);margin:0 0 16px;text-align:center;}

  .role-list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
  .role-opt{
    display:flex;align-items:center;gap:12px;
    appearance:none;-webkit-appearance:none;
    border:1.5px solid transparent;border-radius:13px;padding:13px 14px;
    cursor:pointer;background:none;text-align:right;width:100%;
    outline:none;
  }
  .role-opt .role-ic{
    width:38px;height:38px;border-radius:10px;color:var(--brand-800);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .role-opt .role-ic svg{width:19px;height:19px;}
  .role-opt .role-text{flex:1;display:flex;flex-direction:column;gap:2px;}
  .role-opt .role-text b{font-size:13.5px;color:var(--text-dark);}
  .role-opt .role-text span{font-size:11.5px;color:var(--text-mid);}
  .role-opt .role-check{
    width:20px;height:20px;border-radius:50%;border:2px solid var(--text-mid);
    display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;
  }
  .role-opt .role-check svg{width:11px;height:11px;opacity:0;}
  .role-opt.selected{background:var(--brand-tint);}
  .role-opt.selected .role-ic{background:var(--brand-800);color:#fff;}
  .role-opt.selected .role-check{background:var(--brand-800);border-color:var(--brand-800);}
  .role-opt.selected .role-check svg{opacity:1;}

  .pill-btn{
    display:flex;align-items:center;justify-content:center;gap:8px;
    width:100%;padding:13px;border-radius:12px;border:none;
    font-size:13.5px;font-weight:700;cursor:pointer;
  }
  .pill-primary{background:var(--brand-800);color:#fff;}
  .pill-primary:hover{background:var(--brand-900);}
  .pill-primary:disabled{opacity:.4;cursor:not-allowed;}
  .pill-primary svg{width:16px;height:16px;}

  .method-list{display:flex;flex-direction:column;gap:10px;}
  .method-row{overflow:hidden;padding-top:4px;transition:max-height .35s ease, opacity .3s ease, margin-top .35s ease;max-height:600px;opacity:1;}
  .method-list.has-active .method-row:not(.is-active){max-height:0;opacity:0;margin-top:-10px;pointer-events:none;}
  .method-opt{
    display:flex;align-items:center;gap:12px;
    appearance:none;-webkit-appearance:none;
    border:1.5px solid transparent;border-radius:13px;padding:13px 14px;
    cursor:pointer;background:none;text-align:right;width:100%;
    margin-top:-2px;
    transition:border-color .15s ease, background-color .15s ease;
    outline:none;
  }
  .method-opt.active{border-color:var(--brand-800);}
  .method-ic{width:36px;height:36px;border-radius:9px;color:var(--brand-800);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:visible;}
  .method-opt.active .method-ic{background:var(--brand-800);color:#fff;}
  .method-ic svg{width:18px;height:18px;}
  .method-ic svg.ic-nafath{width:34px;height:23.5px;}

  :root[data-theme="dark"] .role-opt:not(.selected),
  :root[data-theme="dark"] .method-opt:not(.active){border-color:transparent;}
  .method-text{flex:1;display:flex;flex-direction:column;gap:2px;}
  .method-text b{font-size:13px;color:var(--text-dark);}
  .method-text span{font-size:11px;color:var(--text-mid);}
  .chev{width:16px;height:16px;color:var(--text-faint);flex-shrink:0;transition:transform .15s;}
  .method-opt.active .chev{transform:rotate(-90deg);color:var(--brand-800);}
  .method-opt[data-method="email"],.method-opt[data-method="ad"]{cursor:not-allowed;}

  .method-form{display:none;padding:14px 2px 2px;}
  .method-form.open{display:block;animation:fadein .2s ease;}
  .field-pill{
    display:flex;align-items:center;gap:9px;border:1px solid var(--border);border-radius:11px;
    padding:11px 13px;background:none;margin-bottom:10px;
  }
  .field-pill .fic{color:var(--text-light);display:flex;flex-shrink:0;}
  .field-pill .fic svg{width:17px;height:17px;}
  .field-pill input{border:none;background:transparent;outline:none;font-family:inherit;font-size:13px;flex:1;color:var(--text-dark);}
  .field-pill-readonly{background:var(--surface-2,rgba(127,127,127,.06));}
  .field-pill-readonly span:not(.fic){font-size:13px;color:var(--text-mid);}
  .toggle-eye{border:none;background:none;color:var(--text-light);cursor:pointer;display:flex;flex-shrink:0;}
  .toggle-eye svg{width:16px;height:16px;}
  .forgot-row{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:6px;margin-top:10px;}
  .forgot-row a{font-size:12px;color:var(--brand-800);font-weight:700;}
  .forgot-row .forgot-sep{font-size:12px;color:var(--text-light);}

  .nafath-box{
    text-align:center;background:var(--brand-tint);border-radius:12px;padding:20px;margin-top:6px;display:none;
  }
  .nafath-num{font-size:30px;font-weight:900;color:var(--brand-800);letter-spacing:2px;margin-bottom:8px;}
  .nafath-box p{font-size:12px;color:var(--text-mid);margin:0 0 12px;}

  .nafath-success{display:none;text-align:center;padding:6px 0;}
  .nafath-success .tick{
    color:var(--brand-800);
    display:flex;align-items:center;justify-content:center;margin:0 auto 12px;
  }
  .nafath-success .tick svg{width:40px;height:40px;}

  .back-link{
    display:flex;align-items:center;justify-content:center;gap:6px;
    margin-top:16px;border:none;background:none;color:var(--text-mid);
    font-size:12.5px;font-weight:700;cursor:pointer;width:100%;padding:8px;
  }
  .back-link:hover{color:var(--brand-800);}
  .back-link svg{width:15px;height:15px;}

  .reg-back{
    display:flex;align-items:center;gap:6px;border:none;background:none;color:var(--text-mid);
    font-size:12px;font-weight:700;cursor:pointer;padding:0 0 16px;font-family:inherit;
  }
  .reg-back:hover{color:var(--brand-800);}
  .reg-back svg{width:14px;height:14px;}
  .reg-lead{font-size:12px;color:var(--text-mid);margin:0 0 18px;text-align:center;line-height:1.6;}
  .reg-lead b{color:var(--text-dark);}

  .avatar-row{display:flex;justify-content:center;margin-bottom:20px;}
  .avatar-upload{
    display:block;position:relative;width:78px;height:78px;
    cursor:pointer;
  }
  .avatar-photo{
    position:absolute;inset:0;border-radius:50%;overflow:hidden;
    background:var(--surface);border:1.5px dashed var(--border);
    display:flex;align-items:center;justify-content:center;color:var(--text-light);
  }
  .avatar-upload svg{width:24px;height:24px;}
  .avatar-upload .cam-badge{
    position:absolute;bottom:-2px;left:-2px;width:26px;height:26px;border-radius:50%;
    background:var(--brand-800);color:#fff;display:flex;align-items:center;justify-content:center;
    border:2.5px solid var(--card);
  }
  .avatar-upload .cam-badge svg{width:12px;height:12px;}
  .avatar-hint{font-size:10.5px;color:var(--text-faint);text-align:center;margin-top:8px;}

  .field-group{margin-bottom:14px;}
  .field-row{display:flex;flex-direction:column;gap:14px;margin-bottom:14px;}
  .field-row .field-group{flex:1;margin-bottom:0;}
  .field-label{display:block;font-size:11.5px;font-weight:700;color:var(--text-mid);margin-bottom:6px;}
  .field-label .req{color:var(--danger,#c0392b);margin-inline-start:2px;}
  .field-hint{font-size:10.5px;color:var(--text-faint);margin-top:5px;}

  .signin-row{text-align:center;margin-top:16px;font-size:12px;color:var(--text-mid);}
  .signin-row a{color:var(--brand-800);font-weight:700;}
  .signin-row button{
    background:none;border:none;padding:0;margin:0;font:inherit;cursor:pointer;
    color:var(--brand-800);font-weight:700;
  }

  .verify-icon-wrap{display:flex;justify-content:center;margin-bottom:16px;}
  .verify-icon{width:120px;height:120px;display:flex;align-items:center;justify-content:center;}
  .verify-icon svg{width:85px;height:85px;}
  .verify-title{text-align:center;font-size:17px;font-weight:800;color:var(--text-dark);margin:0 0 8px;}
  .verify-sub{text-align:center;font-size:12px;line-height:1.65;color:var(--text-mid);margin:0 0 20px;}

  .verify-dest-row{display:flex;flex-direction:column;gap:8px;margin-bottom:20px;}
  .verify-dest{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:9px 11px;}
  .verify-dest .dic{width:20px;height:20px;color:var(--brand-800);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .verify-dest .dic svg{width:16px;height:16px;}
  .verify-dest .dtext{flex:1;min-width:0;}
  .verify-dest .dtext .dlabel{font-size:10.5px;color:var(--text-light);font-weight:600;}
  .verify-dest .dtext .dvalue{font-size:12px;color:var(--text-dark);font-weight:700;direction:ltr;text-align:right;unicode-bidi:isolate;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;}
  .verify-dest .dstatus{flex-shrink:0;color:var(--brand-800);}
  .verify-dest .dstatus svg{width:16px;height:16px;}

  .otp-block{margin-bottom:6px;border:0;padding:0;min-width:0;}
  .otp-block-label{display:flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;color:var(--text-mid);margin-bottom:9px;padding:0;width:100%;}
  .otp-chan-ic{width:15px;height:15px;color:var(--brand-800);flex-shrink:0;}
  .otp-chan-ic svg{width:100%;height:100%;display:block;}

  .otp-inputs{display:flex;flex-direction:row-reverse;gap:5px;direction:ltr;margin-bottom:8px;width:100%;}
  .otp-inputs input{
    flex:1;width:0;min-width:0;height:44px;text-align:center;
    font-family:inherit;font-size:16px;font-weight:700;color:var(--text-dark);
    background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius-sm);
    outline:none;transition:border-color .18s,background .18s,box-shadow .18s;
  }
  .otp-inputs input:focus{border-color:var(--brand-800);background:var(--card);box-shadow:0 0 0 3px var(--brand-tint);}
  .otp-inputs input.filled{border-color:var(--brand-700);background:var(--card);}

  @@keyframes verifyShake{
    10%,90%{transform:translateX(-1px);}
    20%,80%{transform:translateX(2px);}
    30%,50%,70%{transform:translateX(-4px);}
    40%,60%{transform:translateX(4px);}
  }
  .otp-inputs.shake{animation:verifyShake .5s;}
  .otp-inputs.shake input{border-color:var(--danger,#c0392b);}

  .otp-meta-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;min-height:18px;gap:8px;}
  .otp-status-msg{font-size:11px;font-weight:600;color:var(--text-light);}
  .otp-status-msg.err{color:var(--danger,#c0392b);}
  .otp-resend{background:none;border:none;cursor:pointer;font-family:inherit;font-size:11px;font-weight:700;color:var(--brand-800);padding:0;}
  .otp-resend:disabled{color:var(--text-faint);cursor:default;}
  .otp-resend .timer{direction:ltr;unicode-bidi:isolate;font-variant-numeric:tabular-nums;}

  @@media (max-width:1024px){
    html{scrollbar-width:none;-ms-overflow-style:none;}
    html::-webkit-scrollbar{display:none;}
    body{padding:20px 16px;}
    .theme-toggle-float{display:none;}
    .login-layout{flex-direction:column;gap:20px;}
    .brand-panel{flex-direction:row-reverse;width:auto;gap:12px;transform:none;}
    .brand-panel .brand-logo{width:75px;}
    .brand-panel .brand-wordmark{width:210px;margin-top:0;}
    .brand-panel .nafath-logo{position:static;transform:none;width:320px;}
    .auth-shell{max-width:380px;}
    .auth-card{border-radius:18px;}
    .auth-top{padding:22px 22px 4px;}
    .auth-top h1{font-size:clamp(10px,3.2vw,15px);}
    .auth-bottom{padding:18px 22px 24px;}
    .lstepper{margin-bottom:16px;}
    .lcircle{width:25px;height:25px;padding:3px;}
    .llabel{font-size:9px;}
    .lline{width:42px;margin:0 5px 15px;}
    .panel-hint{font-size:11px;margin-bottom:13px;}
    .role-list{gap:8px;margin-bottom:16px;}
    .role-opt,.method-opt{padding:11px 12px;}
    .role-opt .role-ic,.method-ic{width:33px;height:33px;}
    .role-opt .role-ic svg,.method-ic svg{width:16px;height:16px;}
    .method-ic svg.ic-nafath{width:30px;height:20.8px;}
    .role-opt .role-text b{font-size:10.5px;}
    .method-text b{font-size:11.5px;}
    .role-text span,.method-text span{font-size:10px;}
    .role-opt .role-check{width:18px;height:18px;}
    .pill-btn{padding:12px;font-size:11.5px;}
    .avatar-upload{width:66px;height:66px;}
    .verify-icon{width:54px;height:54px;}
    .verify-icon svg{width:40px;height:40px;}
    .verify-title{font-size:15px;}
    .verify-sub{font-size:11px;margin-bottom:16px;}
    .verify-dest-row{gap:7px;margin-bottom:16px;}
    .verify-dest{padding:8px 10px;}
    .otp-block-label{font-size:10.5px;margin-bottom:7px;}
    .otp-inputs{gap:4px;}
    .otp-inputs input{height:38px;font-size:14px;}
    .otp-meta-row{margin-bottom:16px;}
  }
  @@media (max-width:560px){
    body{padding:16px 12px;}
    .theme-toggle-float{bottom:12px;right:12px;width:36px;height:36px;}
    .brand-panel{gap:10px;}
    .brand-panel .brand-logo{width:50px;}
    .brand-panel .brand-wordmark{width:126px;}
    .brand-panel .nafath-logo{width:190px;}
    .auth-shell{max-width:100%;}
    .auth-card{border-radius:14px;}
    .auth-top{padding:13px 14px 3px;}
    .auth-top h1{font-size:clamp(10px,3.1vw,13px);}
    .auth-bottom{padding:11px 14px 15px;}
    .lstepper{margin-bottom:9px;}
    .lcircle{width:20px;height:20px;padding:2px;}
    .llabel{font-size:8.5px;}
    .lline{width:24px;margin:0 4px 11px;}
    .panel-hint{margin-bottom:8px;font-size:10px;}
    .role-list{gap:6px;margin-bottom:11px;}
    .method-list{gap:6px;}
    .role-opt,.method-opt{padding:8px 10px;gap:9px;}
    .role-opt .role-ic,.method-ic{width:27px;height:27px;}
    .role-opt .role-ic svg,.method-ic svg{width:14px;height:14px;}
    .method-ic svg.ic-nafath{width:25px;height:17.3px;}
    .role-opt .role-text b{font-size:12.5px;}
    .method-text b{font-size:12.5px;}
    .role-text span,.method-text span{font-size:9px;}
    .role-opt .role-check{width:16px;height:16px;}
    .role-opt .role-check svg{width:9px;height:9px;}
    .chev{width:13px;height:13px;}
    .pill-btn{padding:10px;font-size:11px;gap:6px;}
    .pill-btn svg{width:14px;height:14px;}
    .field-pill{padding:9px 11px;margin-bottom:8px;}
    .field-pill input{font-size:11px;}
    .field-pill .fic svg{width:15px;height:15px;}
    .back-link{font-size:10.5px;margin-top:12px;padding:6px;}
    .back-link svg{width:13px;height:13px;}
    .nafath-box{padding:11px;margin-top:4px;}
    .nafath-num{font-size:18px;margin-bottom:3px;}
    .nafath-box p{margin-bottom:6px;font-size:10px;}
    .nafath-box svg{width:28px;height:28px;}
    .nafath-success{padding:2px 0;}
    .nafath-success .tick{margin-bottom:6px;}
    .nafath-success .tick svg{width:26px;height:26px;}
    .verify-icon{width:44px;height:44px;margin-bottom:2px;}
    .verify-icon svg{width:32px;height:32px;}
    .verify-icon-wrap{margin-bottom:10px;}
    .verify-title{font-size:13.5px;margin-bottom:5px;}
    .verify-sub{font-size:10px;margin-bottom:12px;}
    .verify-dest-row{gap:6px;margin-bottom:12px;}
    .verify-dest{padding:7px 9px;gap:8px;}
    .verify-dest .dic{width:16px;height:16px;}
    .verify-dest .dic svg{width:13px;height:13px;}
    .verify-dest .dtext .dlabel{font-size:9px;}
    .verify-dest .dtext .dvalue{font-size:10.5px;}
    .verify-dest .dstatus svg{width:13px;height:13px;}
    .otp-block{margin-bottom:3px;}
    .otp-block-label{font-size:9.5px;gap:5px;margin-bottom:6px;}
    .otp-chan-ic{width:12px;height:12px;}
    .otp-inputs{gap:3px;margin-bottom:6px;}
    .otp-inputs input{height:32px;font-size:12px;border-radius:7px;}
    .otp-meta-row{margin-bottom:12px;min-height:14px;}
    .otp-status-msg{font-size:9.5px;}
    .otp-resend{font-size:9.5px;}
  }

  @@media (max-height:700px){
    .brand-panel .nafath-logo{width:150px;}
    .auth-top{padding:14px 16px 2px;}
    .lstepper{margin-bottom:8px;}
    .verify-icon-wrap{margin-bottom:6px;}
    .verify-sub{margin-bottom:10px;}
    .verify-dest-row{margin-bottom:10px;}
    .otp-meta-row{margin-bottom:10px;}
  }
  @@media (max-height:600px){
    .brand-panel .nafath-logo{width:120px;}
    .auth-top h1{font-size:13px;}
    .lstepper{margin-bottom:6px;}
    .panel-hint{margin-bottom:6px;font-size:11.5px;}
    .method-opt.active .method-text span{display:none;}
    .nafath-box{padding:10px;}
    .nafath-box p{font-size:11px;margin-bottom:6px;}
    .verify-icon{width:36px;height:36px;}
    .verify-icon svg{width:26px;height:26px;}
    .verify-icon-wrap{margin-bottom:4px;}
    .verify-title{font-size:12.5px;margin-bottom:3px;}
    .verify-sub{font-size:9.5px;margin-bottom:8px;}
    .verify-dest-row{margin-bottom:8px;}
    .otp-meta-row{margin-bottom:8px;}
  }
</style>
</head>
