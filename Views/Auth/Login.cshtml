        <svg viewBox="-127.5 -105.5 835.6 530.34" xmlns="http://www.w3.org/2000/svg" style="background:transparent; overflow:visible;">
        <style>
          .nafath-logo path{
            transform-box: fill-box;
            transform-origin: center;
            opacity:0;
            animation-duration: 1.1s, var(--idle-dur, 4.2s);
            animation-timing-function: cubic-bezier(.22,1,.36,1), cubic-bezier(.37,0,.63,1);
            animation-iteration-count: 1, infinite;
            animation-fill-mode: both, forwards;
            animation-name: nafath-reveal-once, nafath-idle-breathe;
          }
          @@keyframes nafath-reveal-once{
            0%{   opacity:0; transform: scale(0.25) rotate(-18deg); }
            60%{  opacity:1; transform: scale(1.08) rotate(3deg); }
            100%{ opacity:1; transform: scale(1) rotate(0deg); }
          }
          @@keyframes nafath-idle-breathe{
            0%{   transform: scale(1);    opacity:1;    }
            50%{  transform: scale(1.08); opacity:0.88; }
            100%{ transform: scale(1);    opacity:1;    }
          }
