let _svgIdSeq = 0;
function uniqueSvgIds(svg){
  const seen = new Map();
  return svg
    .replace(/\bid="([^"]+)"/g, (m, id) => {
      if(!seen.has(id)) seen.set(id, `${id}_${++_svgIdSeq}`);
      return `id="${seen.get(id)}"`;
    })
    .replace(/url\(#([^)]+)\)/g, (m, id) => `url(#${seen.get(id) || id})`)
    .replace(/href="#([^"]+)"/g, (m, id) => `href="#${seen.get(id) || id}"`);
}
