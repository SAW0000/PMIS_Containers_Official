function renderAvatarInto(el, opts){
  if(!el) return;
  el.innerHTML = DEFAULT_AVATAR_ICON_SVG;   

  if(!opts.hasPhoto || !opts.userId) return;

  const img = document.createElement('img');
  img.className = 'avatar-photo';
  img.alt = '';           
  img.decoding = 'async';
  img.addEventListener('load', () => el.replaceChildren(img), {once:true});
