    user: document.getElementById('payUser').value.trim(),
    amount: document.getElementById('payAmount').value.trim(),
    purpose: document.getElementById('payPurpose').value.trim()
  };
  const err = document.getElementById('payError');
  if(!item.iban || !item.bank || !item.user || !item.amount || !item.purpose){
    err.textContent = 'جميع الحقول مطلوبة';
    err.style.display = 'block';
    return;
  }
  err.style.display = 'none';

  const isEdit = payEditingId !== null;
  const editedId = payEditingId;
  const btn = document.querySelector('#payModal .btn-primary');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ الحفظ...`;

  try{
    const res = await fetch(isEdit ? `/app/bank-accounts/${encodeURIComponent(editedId)}` : '/app/bank-accounts', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ iban: item.iban, bankName: item.bank, accountHolderName: item.user, transferAmount: item.amount, purposeDescription: item.purpose })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      err.textContent = data.message || 'تعذر حفظ الحساب';
      err.style.display = 'block';
      return;
    }

    await refreshPayAccounts();
    closePayModal();
    renderPayList();
    showToast(isEdit ? 'تم تعديل الحساب' : 'تمت إضافة الحساب');
  } catch(e){
    err.textContent = 'تعذر الاتصال بالخادم';
    err.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
async function deleteFromPayModal(){
  if(!payEditingId) return;
  const ok = await confirmDialog(
    'سيتم حذف هذا الحساب من قائمة معلومات الدفع. هل تريد المتابعة؟',
    'حذف حساب الدفع'
  );
  if(!ok) return;

  const id = payEditingId;
  try{
    const res = await fetch(`/app/bank-accounts/${encodeURIComponent(id)}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-TOKEN': csrfToken() }
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر حذف الحساب', 'warning');
      return;
    }

    await refreshPayAccounts();
    closePayModal();
    renderPayList();
    showToast('تم حذف الحساب');
  } catch(e){
    showToast('تعذر الاتصال بالخادم', 'warning');
  }
}

