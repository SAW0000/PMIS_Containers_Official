function relativeArabicTime(isoDate){
  const then = new Date(isoDate).getTime();
  const diffMs = Date.now() - then;
  const minute = 60000, hour = 3600000, day = 86400000, week = day*7, month = day*30;
  if(diffMs < minute) return 'الآن';
  if(diffMs < hour){ const m = Math.floor(diffMs/minute); return m===1 ? 'قبل دقيقة' : `قبل ${m} ${m===2?'دقيقتين':'دقائق'}`; }
  if(diffMs < day){ const h = Math.floor(diffMs/hour); return h===1 ? 'قبل ساعة' : `قبل ${h} ${h===2?'ساعتين':'ساعات'}`; }
  if(diffMs < 2*day) return 'أمس';
  if(diffMs < week){ const d = Math.floor(diffMs/day); return `قبل ${d} أيام`; }
  if(diffMs < month){ const w = Math.floor(diffMs/week); return w===1 ? 'قبل أسبوع' : `قبل ${w} أسابيع`; }
  const mo = Math.floor(diffMs/month);
  return mo===1 ? 'قبل شهر' : `قبل ${mo} أشهر`;
}
