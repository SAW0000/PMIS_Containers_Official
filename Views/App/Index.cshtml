const ATTACHMENT_TYPE_LABELS = {
  CommercialRegistration: 'السجل التجاري ساري المفعول',
  VatCertificate: 'شهادة ضريبة القيمة المضافة (VAT)',
  NationalAddress: 'شهادة العنوان الوطني',
  IbanCertificate: 'شهادة الآيبان البنكي',
