async function renderAdminUsers(clickedPageBtn){
  const openBtn = document.getElementById('adminUsersOpenBtn');
  if(openBtn && !openBtn.querySelector('svg')){
    openBtn.insertAdjacentHTML('afterbegin', ICONS.chevronLeft);
  }
  document.querySelectorAll('#adminUsersHead th.sortable').forEach(th=>{
    const col = th.getAttribute('data-sort');
    const active = adminUsersSort.col===col;
    th.classList.toggle('active', active);
    th.classList.toggle('desc', active && adminUsersSort.dir==='desc');
    th.onclick = ()=>setAdminUsersSort(col);
    const arrow = active && adminUsersSort.dir==='desc' ? ICONS.sortArrowDown : ICONS.sortArrowUp;
    let ic = th.querySelector('.sort-ic');
    if(!ic){ th.insertAdjacentHTML('beforeend', `<span class="sort-ic">${arrow}</span>`); }
    else{ ic.innerHTML = arrow; }
  });
  syncAdminUsersFilterBadge();
  showCardLoading('adminUsersCardBody');
  const { data, isStale } = await fetchAdminUsersPage({
    page: adminUsersPage, pageSize: PAGE_SIZE, search: adminUsersSearch,
    roles: adminUsersFilterRoles, active: adminUsersFilterActive,
    sortCol: adminUsersSort.col, sortDir: adminUsersSort.dir
  });
  if(isStale) return;
  hideCardLoading('adminUsersCardBody');
  if(!data){ showToast('تعذر تحميل قائمة المستخدمين', 'warning'); return; }

  ADMIN_USERS = data.items;
  adminUsersTotalCount = data.totalCount;
  const totalPages = Math.max(1, Math.ceil(adminUsersTotalCount / PAGE_SIZE));
  if(adminUsersPage>totalPages){ adminUsersPage = totalPages; return renderAdminUsers(clickedPageBtn); }
  if(openBtn){
    const isHandheld = window.matchMedia(SNAP_BREAKPOINT).matches;
    const isEmpty = !adminUsersTotalCount;
    const showAddUser = !isHandheld || isEmpty;
