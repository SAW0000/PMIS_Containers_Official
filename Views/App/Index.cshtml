  if(isHandheld){
    dismissLoadingToast = showToast('جارٍ الحفظ...', 'loading');
    btns.forEach(b => { b.disabled = true; b.innerHTML = SPIN_RING; });
  } else {
    btns.forEach(b => { b.disabled = true; b.innerHTML = `${SPIN_RING}جارٍ الحفظ...`; });
  }

  const termsAndConditionsText = document.getElementById('settingsTermsBody').value;
  const termsAgreementLabel = document.getElementById('settingsTermsAck').value;
  const payload = {
    licenseValidityMonths: Number(document.getElementById('settingsLicenseValidityMonths').value),
    responseSlaBusinessDays: Number(document.getElementById('settingsResponseSlaBusinessDays').value),
    maxActiveRequestsPerUser: Number(document.getElementById('settingsMaxActiveRequestsPerUser').value),
    maxUploadSizeMb: Number(document.getElementById('settingsMaxUploadSizeMb').value),
    allowedAttachmentExtensions: selectedExtensions(),
    allowedProfilePhotoExtensions: selectedPhotoExtensions(),
    maxLoginAttempts: Number(document.getElementById('settingsMaxLoginAttempts').value),
    loginLockoutMinutes: Number(document.getElementById('settingsLoginLockoutMinutes').value),
    otpExpiryMinutes: Number(document.getElementById('settingsOtpExpiryMinutes').value),
    otpResendCooldownSeconds: Number(document.getElementById('settingsOtpResendCooldownSeconds').value),
    otpMaxResendCount: Number(document.getElementById('settingsOtpMaxResendCount').value),
    otpEmailMessageTemplate: document.getElementById('settingsOtpEmailTemplate').value,
    otpSmsMessageTemplate: document.getElementById('settingsOtpSmsTemplate').value,
    auditLogRetentionDays: Number(document.getElementById('settingsAuditLogRetentionDays').value),
    notificationRetentionDays: Number(document.getElementById('settingsNotificationRetentionDays').value),
    auditLogMaxCount: Number(document.getElementById('settingsAuditLogMaxCount').value),
    notificationMaxCount: Number(document.getElementById('settingsNotificationMaxCount').value),
    termsAndConditionsText,
    termsAgreementLabel
  };

  try{
    const res = await fetch('/app/admin/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify(payload)
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر حفظ الإعدادات', 'warning');
    } else {
      TERMS_AND_CONDITIONS_TEXT = termsAndConditionsText;
      TERMS_AGREEMENT_LABEL = termsAgreementLabel;
      showToast('تم حفظ الإعدادات');
    }
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    if(dismissLoadingToast) dismissLoadingToast();
    btns.forEach((b, i) => { b.disabled = false; b.innerHTML = originalHtml[i]; });
  }
}
let ADMIN_LOGS = [];
let adminLogTotalCount = 0;
async function fetchAdminLogPage(){
  showCardLoading('adminLogCardBody');
  const res = await fetch(`/app/audit-log?page=${adminLogPage}&pageSize=${PAGE_SIZE}`);
  hideCardLoading('adminLogCardBody');
  if(!res.ok) return;
  const data = await res.json();
  ADMIN_LOGS = data.items;
  adminLogTotalCount = data.totalCount;
}
async function goAdminLogPage(p, btn){
  adminLogPage = p;
  await fetchAdminLogPage();
  renderAdminLog(btn);
}
function renderAdminLog(clickedPageBtn){
  document.querySelectorAll('#adminLogHead th.sortable').forEach(th=>{
    const col = th.getAttribute('data-sort');
    const active = adminLogSort.col===col;
    th.classList.toggle('active', active);
    th.classList.toggle('desc', active && adminLogSort.dir==='desc');
    th.onclick = ()=>setAdminLogSort(col);
    const arrow = active && adminLogSort.dir==='desc' ? ICONS.sortArrowDown : ICONS.sortArrowUp;
    let ic = th.querySelector('.sort-ic');
    if(!ic){ th.insertAdjacentHTML('beforeend', `<span class="sort-ic">${arrow}</span>`); }
    else{ ic.innerHTML = arrow; }
  });
  const sorted = ADMIN_LOGS.slice().sort(sortRequestsFn(adminLogSort.col, adminLogSort.dir, ADMIN_LOG_SORT_KEYS));
  const adminLogTable = document.getElementById('adminLogTable');
  const adminLogEmptyState = document.getElementById('adminLogEmptyState');
  adminLogTable.style.display = sorted.length ? '' : 'none';
  adminLogEmptyState.style.display = sorted.length ? 'none' : 'flex';
  document.getElementById('adminLogBody').innerHTML = sorted.length ? sorted.map(l=>`
    <tr>
      <td class="mono" data-label="الوقت">${cellClip(l[0])}</td>
      <td data-label="المستخدم">${cellClip(l[1])}</td>
      <td data-label="العملية">${cellClip(l[2])}</td>
      <td class="mono" data-label="رقم الطلب">${cellClip(l[3])}</td>
      <td class="mono" data-label="عنوان IP">${cellClip(l[4])}</td>
    </tr>
  `).join('') : '';
  if(!sorted.length){ adminLogEmptyState.innerHTML = `${ICONS.logEmpty()}<div>لا يوجد سجل عمليات</div>`; forceViewRepaint('admin-log'); }
  renderPagination('adminLogPagination', adminLogTotalCount, adminLogPage, goAdminLogPage, undefined, clickedPageBtn, true);
  initCardCarousel('adminLogBody', 'adminLogDots');
}

function showToast(msg, type){
  return sharedShowToast(msg, type, SPIN_RING);
}

