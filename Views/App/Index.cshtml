      <td data-label="الجنس">${cellClip(u.gender || '—')}</td>
      <td data-label="جنسية">${cellClip(u.arabicNationality || '—')}</td>
      <td class="mono" data-label="رقم الجوال">${cellClip(u.mobile || '—')}</td>
      <td data-label="الحالة">${u.active?`<span class="badge" style="color:var(--success)"><span class="dot"></span>نشط</span>`:`<span class="badge" style="color:var(--st-draft)"><span class="dot"></span>موقوف</span>`}</td>
    </tr>
  `).join('') : '';
  if(!list.length){ adminUsersEmptyState.innerHTML = `${ICONS.usersEmpty()}<div>لا يوجد مستخدمون مطابقون</div>`; forceViewRepaint('admin-users'); }
