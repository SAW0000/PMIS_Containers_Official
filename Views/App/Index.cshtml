function checkProfHeaderFit(){
  const nameEl = document.getElementById('profName');
  const statRow = document.getElementById('profStatRow');
  if(!nameEl || !statRow) return;
  const cells = Array.from(statRow.children);
  cells.forEach(c=>c.classList.remove('prof-stat-hidden'));
  const overlaps = ()=>{
    const nameRect = nameEl.getBoundingClientRect();
    const statRect = statRow.getBoundingClientRect();
    return nameRect.right > statRect.left && nameRect.left < statRect.right;
  };
  let hideCount = 0;
  while(overlaps() && hideCount < cells.length){
    cells[hideCount].classList.add('prof-stat-hidden');
    hideCount++;
  }
}

