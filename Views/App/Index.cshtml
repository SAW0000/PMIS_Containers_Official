async function refreshNotificationsData(){
  const [listRes, unreadRes] = await Promise.all([
    fetch(`/app/notifications?page=${notifPage}&pageSize=${PAGE_SIZE}`),
    fetch('/app/notifications/unread')
  ]);
  if(listRes.ok){
    const data = await listRes.json();
    notifications = data.items.map(n => ({
      id: n.id, icon: n.icon, title: n.title, text: n.text,
      time: relativeArabicTime(n.createdDate), unread: n.unread
    }));
    notifTotalCount = data.totalCount;
  }
  if(unreadRes.ok){
    const unreadData = await unreadRes.json();
    notifPopoverUnread = unreadData.map(n => ({
