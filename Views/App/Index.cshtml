function animateCountUp(el, dur){
  const target = +el.getAttribute('data-val');
  const start = performance.now();
  dur = dur || 800;
  function step(now){
    const t = Math.min(1, (now-start)/dur);
    el.textContent = Math.round(target * (1 - Math.pow(1-t, 2)));
    if(t < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function animateStatValues(containerId){
  const grid = document.getElementById(containerId);
  if(!grid) return;
  grid.querySelectorAll('.val[data-val], .n[data-val]').forEach(el=>animateCountUp(el));
}

