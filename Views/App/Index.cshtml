@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="@ViewBag.AntiForgeryToken">
<title>خدمة طلب شراء رخص نظام إدارة المشاريع</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" asp-append-version="true">
<link rel="stylesheet" href="/assets/styles.css" asp-append-version="true">
<script src="/assets/lockdown.js" asp-append-version="true" defer></script>
<script>
  try{ if(localStorage.getItem('pmis-theme')==='dark') document.documentElement.setAttribute('data-theme','dark'); }catch(e){}
  try{ const b=localStorage.getItem('pmis-brand'); if(b!=='blue') document.documentElement.setAttribute('data-brand', 'amana'); }catch(e){}
  try{ localStorage.removeItem('pmisNafathPending'); }catch(e){}
</script>
</head>
<body>

<div class="ctx-menu" id="ctxMenu">
  <button type="button" class="ctx-menu-item" id="ctxRefreshBtn"><span id="ctxRefreshIcon"></span><span>تحديث</span></button>
  <button type="button" class="ctx-menu-item" id="ctxBrandBtn"><span id="ctxBrandIcon"></span><span id="ctxBrandLabel"></span></button>
  <button type="button" class="ctx-menu-item" id="ctxThemeBtn"><span id="ctxThemeIcon"></span><span id="ctxThemeLabel"></span></button>
</div>

<div class="app-shell">
  <aside class="sidebar">
    <div class="brand">
      <button type="button" class="brand-mark" onclick="goHome()" title="الرئيسية" aria-label="الرئيسية"><svg viewBox="-40 -40 135 131" style="background:transparent; overflow:visible;">
        <style>
          .brand-mark path{
            transform-box: view-box;
            opacity:0;
            animation-duration: 1.1s, 6.5s;
            animation-timing-function: cubic-bezier(.22,1,.36,1), ease-in-out;
            animation-iteration-count: 1, infinite;
            animation-fill-mode: both, forwards;
            animation-name: brand-reveal-once, brand-glow-pulse;
          }
          @@keyframes brand-reveal-once{
            0%{   opacity:0; transform: scale(0.25) rotate(-18deg); }
            60%{  opacity:1; transform: scale(1.08) rotate(3deg); }
            100%{ opacity:1; transform: scale(1) rotate(0deg); }
          }
          @@keyframes brand-glow-pulse{
            0%{    filter: brightness(1)   drop-shadow(0 0 0px rgba(0,150,138,0)); }
            30%{   filter: brightness(1.3) drop-shadow(0 0 3px rgba(0,150,138,0.6)); }
            60%{   filter: brightness(1)   drop-shadow(0 0 0px rgba(0,150,138,0)); }
            100%{  filter: brightness(1)   drop-shadow(0 0 0px rgba(0,150,138,0)); }
          }
          .brand-mark path:nth-of-type(1){ transform-origin: 27.422px 38.977px; animation-delay: 0.0s, calc(0.0s + 1.1s + 0.00s); }
          .brand-mark path:nth-of-type(2){ transform-origin: 15.299px 25.289px; animation-delay: 0.1s, calc(0.1s + 1.1s + 0.55s); }
          .brand-mark path:nth-of-type(3){ transform-origin: 8.325px 36.392px;  animation-delay: 0.2s, calc(0.2s + 1.1s + 1.10s); }
          .brand-mark path:nth-of-type(4){ transform-origin: 27.444px 9.672px;  animation-delay: 0.3s, calc(0.3s + 1.1s + 1.65s); }
          .brand-mark path:nth-of-type(5){ transform-origin: 46.555px 36.392px; animation-delay: 0.4s, calc(0.4s + 1.1s + 2.20s); }
          .brand-mark path:nth-of-type(6){ transform-origin: 39.556px 25.323px; animation-delay: 0.5s, calc(0.5s + 1.1s + 2.75s); }
        </style>
        <path fill="#007167" d="m33.472,50.5121l-0.023,-0.5103c-0.397,-8.0748 -2.141,-15.1291 -5.321,-21.6067l-0.706,-1.442l-0.707,1.442c-3.18,6.4554 -4.924,13.5319 -5.321,21.6067l-0.023,0.5103c1.966,0.3105 3.975,0.488 6.051,0.488c2.075,0 4.106,-0.1775 6.05,-0.488z"/>
        <path fill="#00958A" d="m6.908,21.0522c2.959,3.8599 7.287,9.8938 10.489,17.6359l0.949,2.3071l0.552,-2.4402c1.237,-5.4794 3.18,-10.4485 5.918,-15.1292l0.243,-0.4215l-0.287,-0.4215c-1.657,-2.4624 -3.511,-4.7916 -5.83,-7.3427c-1.656,-1.7525 -3.466,-3.505 -5.343,-5.1688l-0.552,-0.488l-0.53,0.5324c-2.738,2.7285 -4.924,5.5902 -6.713,8.7403l-0.265,0.4658l0.354,0.4215c0.331,0.4437 0.662,0.8874 1.015,1.3089z"/>
        <path fill="#007167" d="m16.649,49.4472l-0.066,-0.2662c-2.716,-11.3358 -8.214,-19.5215 -12.1,-24.6903l-0.861,-1.1535l-0.508,1.3532c-1.546,4.0817 -2.584,8.7181 -3.114,13.8203c3.997,5.0357 9.804,8.9178 16.649,10.9365z"/>
        <path fill="#6ABF4B" d="m21.857,12.5115c1.877,2.0631 3.511,4.0153 4.924,5.9674l0.64,0.8652l0.641,-0.8652c1.435,-1.9521 3.025,-3.8821 4.924,-5.9452c1.589,-1.6638 3.312,-3.34971 5.1,-4.94692l0.707,-0.64333l-0.751,-0.57677c-4.328,-3.34972 -8.302,-5.32405 -10.267,-6.21139l-0.332,-0.15529l-0.331,0.15529c-1.987,0.88734 -5.939,2.88386 -10.267,6.21139l-0.751,0.57677l0.707,0.64333c1.766,1.59721 3.466,3.26102 5.056,4.92472z"/>
        <path fill="#007167" d="m54.89,38.5107c-0.552,-5.1022 -1.59,-9.7608 -3.136,-13.8203l-0.507,-1.3532l-0.862,1.1535c-3.886,5.1688 -9.362,13.3323 -12.1,24.6903l-0.066,0.2662c6.823,-2.0187 12.652,-5.9008 16.671,-10.9365z"/>
        <path fill="#00958A" d="m35.902,15.2845c-2.297,2.5067 -4.195,4.9026 -5.829,7.3206l-0.287,0.4215l0.242,0.4214c2.738,4.703 4.659,9.6499 5.918,15.1292l0.552,2.4402l0.949,-2.3071c3.202,-7.742 7.508,-13.7538 10.467,-17.6137c0.353,-0.4437 0.706,-0.8652 1.059,-1.3088l0.354,-0.4215l-0.265,-0.4659c-1.789,-3.1501 -3.975,-6.0117 -6.713,-8.7403l-0.53,-0.5324l-0.552,0.488c-1.899,1.6638 -3.687,3.3941 -5.365,5.1688z"/>
      </svg></button>
      <div class="brand-text"><b>أمانة المدينة المنورة</b><span>خـــدمــــة طــلــب شراء رخـصـة</span><span>نـــــظـــام إدارة الـــــمشاريــــع</span></div>
    </div>

    <div id="sidebarNavGroups"></div>

    <div class="sidebar-foot">
      <button type="button" class="logout" onclick="logout()">
        <svg viewBox="0 0 24 24" width="18" height="18"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="34" d="M12 4h-7c-0.55 0 -1 0.45 -1 1v14c0 0.55 0.45 1 1 1h7"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="34;0"/></path><path stroke-dasharray="14" stroke-dashoffset="14" d="M9 12h11.5"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.5s" dur="0.2s" to="0"/></path><path stroke-dasharray="8" stroke-dashoffset="8" d="M20.5 12l-3.5 -3.5M20.5 12l-3.5 3.5"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.7s" dur="0.2s" to="0"/></path></g></svg>
        تسجيل الخروج
      </button>
    </div>
  </aside>

  <div class="topbar">
    <div class="mobile-brand">
      <svg viewBox="0 0 55 51" width="22" height="22"><path fill="#007167" d="m33.472,50.5121l-0.023,-0.5103c-0.397,-8.0748 -2.141,-15.1291 -5.321,-21.6067l-0.706,-1.442l-0.707,1.442c-3.18,6.4554 -4.924,13.5319 -5.321,21.6067l-0.023,0.5103c1.966,0.3105 3.975,0.488 6.051,0.488c2.075,0 4.106,-0.1775 6.05,-0.488z"/><path fill="#00958A" d="m6.908,21.0522c2.959,3.8599 7.287,9.8938 10.489,17.6359l0.949,2.3071l0.552,-2.4402c1.237,-5.4794 3.18,-10.4485 5.918,-15.1292l0.243,-0.4215l-0.287,-0.4215c-1.657,-2.4624 -3.511,-4.7916 -5.83,-7.3427c-1.656,-1.7525 -3.466,-3.505 -5.343,-5.1688l-0.552,-0.488l-0.53,0.5324c-2.738,2.7285 -4.924,5.5902 -6.713,8.7403l-0.265,0.4658l0.354,0.4215c0.331,0.4437 0.662,0.8874 1.015,1.3089z"/><path fill="#007167" d="m16.649,49.4472l-0.066,-0.2662c-2.716,-11.3358 -8.214,-19.5215 -12.1,-24.6903l-0.861,-1.1535l-0.508,1.3532c-1.546,4.0817 -2.584,8.7181 -3.114,13.8203c3.997,5.0357 9.804,8.9178 16.649,10.9365z"/><path fill="#6ABF4B" d="m21.857,12.5115c1.877,2.0631 3.511,4.0153 4.924,5.9674l0.64,0.8652l0.641,-0.8652c1.435,-1.9521 3.025,-3.8821 4.924,-5.9452c1.589,-1.6638 3.312,-3.34971 5.1,-4.94692l0.707,-0.64333l-0.751,-0.57677c-4.328,-3.34972 -8.302,-5.32405 -10.267,-6.21139l-0.332,-0.15529l-0.331,0.15529c-1.987,0.88734 -5.939,2.88386 -10.267,6.21139l-0.751,0.57677l0.707,0.64333c1.766,1.59721 3.466,3.26102 5.056,4.92472z"/><path fill="#007167" d="m54.89,38.5107c-0.552,-5.1022 -1.59,-9.7608 -3.136,-13.8203l-0.507,-1.3532l-0.862,1.1535c-3.886,5.1688 -9.362,13.3323 -12.1,24.6903l-0.066,0.2662c6.823,-2.0187 12.652,-5.9008 16.671,-10.9365z"/><path fill="#00958A" d="m35.902,15.2845c-2.297,2.5067 -4.195,4.9026 -5.829,7.3206l-0.287,0.4215l0.242,0.4214c2.738,4.703 4.659,9.6499 5.918,15.1292l0.552,2.4402l0.949,-2.3071c3.202,-7.742 7.508,-13.7538 10.467,-17.6137c0.353,-0.4437 0.706,-0.8652 1.059,-1.3088l0.354,-0.4215l-0.265,-0.4659c-1.789,-3.1501 -3.975,-6.0117 -6.713,-8.7403l-0.53,-0.5324l-0.552,0.488c-1.899,1.6638 -3.687,3.3941 -5.365,5.1688z"/></svg>
      <span>أمانة المدينة المنورة</span>
    </div>

    <div class="tb-path" id="topbarPath"></div>

    <div class="topbar-right">
      <button class="icon-btn theme-toggle" id="themeToggle" title="تبديل المظهر"></button>
      <div class="notif-pop-wrap" id="notifPopWrap">
        <button class="icon-btn" id="topbarNotifBtn" title="الإشعارات">
          <span id="topbarNotifIcon"></span>
          <span class="badge-dot" id="notifCount" style="display:none"></span>
        </button>
        <div class="notif-popover" id="notifPopover">
          <div class="notif-pop-head">
            <h4>الإشعارات</h4>
            <button type="button" onclick="markAllNotificationsRead()">تعليم الكل كمقروء</button>
          </div>
          <div class="notif-pop-list" id="notifPopList"></div>
          <div class="notif-pop-foot">
            <button type="button" onclick="closeNotifPopover();openView('notifications')">
              عرض كل الإشعارات
              <svg viewBox="0 0 24 24" width="14" height="14"><path fill="none" stroke="currentColor" stroke-dasharray="12" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M8 12l7 -7M8 12l7 7"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="12;0"/></path></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="profile" id="profileToggle">
        <div class="avatar" id="userAvatar"><svg viewBox="0 0 24 24" width="60%" height="60%"><path fill="currentColor" d="M12 2a5 5 0 1 0 0 10a5 5 0 1 0 0-10M4 22h16c.55 0 1-.45 1-1v-1c0-3.86-3.14-7-7-7h-4c-3.86 0-7 3.14-7 7v1c0 .55.45 1 1 1"/></svg></div>
        <div class="who"><b id="userName"></b><span id="userRoleLabel"></span></div>
        <div class="profile-menu" id="profileMenu">
          <button type="button" id="profileAccountBtn" onclick="openView('my-profile')">الملف الشخصي</button>
          <button type="button" id="profileSettingsBtn" onclick="openView('account-settings')">إعدادات الحساب</button>
          <div class="theme-pick-wrap" id="themePickWrap">
            <button type="button" id="profileThemeBtn" onclick="event.stopPropagation();toggleThemePicker();">
              <span id="profileThemeIcon"></span><span>مظهر النظام</span>
            </button>
            <div class="theme-picker-popover" id="themePickerPopover">
              <h4>اختيار الثيم</h4>
              <p>خصص مظهر النظام باختيار الثيم المناسب لك</p>
              <div class="theme-swatch-row">
                <button type="button" class="theme-swatch-opt active" data-theme-choice="amanah" onclick="event.stopPropagation();selectThemeSwatch(this);">
                  <span class="theme-ring theme-ring-amanah"></span>
                  <span class="theme-swatch-label">ثيم الأمانه</span>
                </button>
                <button type="button" class="theme-swatch-opt" data-theme-choice="blue" onclick="event.stopPropagation();selectThemeSwatch(this);">
                  <span class="theme-ring theme-ring-blue"></span>
                  <span class="theme-swatch-label">ثيم الأزرق</span>
                </button>
              </div>
            </div>
          </div>
          <button type="button" id="profileLogoutBtn" onclick="logout()">تسجيل الخروج</button>
        </div>
      </div>
    </div>
  </div>

  <div class="main" id="mainArea">
   <div class="main-inner">

    <section class="view" id="view-dashboard">
      <div class="page-head">
        <div>
          <h1>لوحة المؤشرات</h1>
          <p id="dashSub"></p>
        </div>
        <button class="btn btn-primary" onclick="startNewRequest()">
          <svg viewBox="0 0 24 24" width="15" height="15"><g fill="none" stroke="currentColor" stroke-dasharray="16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.5s" values="16;0"/></path><path stroke-dashoffset="16" d="M12 5v14"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.5s" dur="0.5s" to="0"/></path></g></svg>
          طلب شراء رخصة جديد
        </button>
      </div>

      <div class="page-head page-head-newreq" id="dashNewReqSection">
        <div>
          <h1>طلب رخصة جديدة</h1>
          <p>ابدأ بتقديم طلب شراء رخصة جديدة</p>
        </div>
        <button class="btn btn-primary" onclick="startNewRequest()">
          <svg viewBox="0 0 24 24" width="15" height="15"><g fill="none" stroke="currentColor" stroke-dasharray="16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M5 12h14"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.5s" values="16;0"/></path><path stroke-dashoffset="16" d="M12 5v14"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.5s" dur="0.5s" to="0"/></path></g></svg>
          طلب شراء رخصة جديد
        </button>
      </div>

      <div class="card">
        <div class="card-head overview-head">
          <div>
            <h3>نظرة عامة على طلباتي</h3>
            <div class="overview-sub" id="benOverviewSub"></div>
          </div>
          <div class="period-pop-wrap" id="benPeriodWrap">
            <button type="button" class="period-pill" id="benPeriodBtn"></button>
            <div class="period-popover" id="benPeriodPopover"></div>
          </div>
        </div>
        <div class="stat-strip" id="benStatGrid"></div>
      </div>

      <div class="two-col even" id="benOverviewRow">
        <div class="card">
          <div class="card-head"><h3>توزيع طلباتي حسب الحالة</h3></div>
          <div class="card-body card-body-fixed card-body-static" id="benStatusBars" style="display:flex;align-items:center;"></div>
        </div>
        <div class="card">
          <div class="card-head"><h3>مؤشرات على طلباتي</h3></div>
          <div class="card-body card-body-fixed card-body-static" id="benDonuts" style="display:flex;align-items:center;justify-content:space-evenly;"></div>
        </div>
      </div>

      <div class="two-col">
        <div>
          <div class="card" id="benActionCard">
            <div class="card-head"><h3>بحاجة إلى إجراء</h3><button type="button" class="user-row-hint ben-action-head-hint" id="benActionHeadOpenBtn" onclick="openCurrentBenActionItem()"></button></div>
            <div class="card-body card-body-fixed" id="benActionBody"></div>
            <div class="carousel-dots" id="benActionDots"></div>
            <button type="button" class="user-row-hint" id="benActionOpenBtn" onclick="openCurrentBenActionItem()"></button>
            <div class="pagination" id="benActionPagination"></div>
          </div>
          <div class="card" id="benLicensesCard">
            <div class="card-head"><h3>تراخيصي المفعّلة</h3></div>
            <div class="card-body card-body-fixed" id="benLicensesBody"></div>
            <div class="carousel-dots" id="benLicensesDots"></div>
            <div class="pagination" id="benLicensesPagination"></div>
          </div>
        </div>

        <div>
          <div class="card" id="benActivityCard">
            <div class="card-head"><h3>آخر النشاطات</h3><button type="button" class="user-row-hint ben-activity-head-hint" id="benActivityHeadOpenBtn" onclick="openView('activity')">عرض التفاصيل</button></div>
            <div class="card-body card-body-fixed" id="benActivityBody">
              <div class="timeline" id="benActivityTimeline"></div>
            </div>
            <button type="button" class="user-row-hint" id="benActivityOpenBtn" onclick="openView('activity')">عرض التفاصيل</button>
            <div class="pagination" id="benActivityCardPagination"></div>
          </div>
          <div class="card" id="benQuickLinksCard">
            <div class="card-head"><h3>روابط سريعة</h3></div>
            <div class="card-body card-body-fixed" id="benQuickLinks" style="display:flex;flex-direction:column;gap:8px;"></div>
            <div class="pagination" id="benQuickLinksPagination"></div>
          </div>
        </div>
      </div>

    </section>

    <section class="view" id="view-myrequests">
      <div class="page-head"><div><h1>طلباتي</h1><p>عرض كافة الطلبات الخاصة بك</p></div></div>
      <div class="card" id="benRequestsCard">
        <div class="card-head">
          <h3>طلباتي</h3>
          <div class="tbl-tools" id="benTableTools">
            <div class="tbl-search-wrap" id="benSearchWrap">
              <input type="text" class="tbl-search-input" id="benSearchInput" placeholder="ابحث برقم الطلب أو المشروع…" aria-label="ابحث برقم الطلب أو المشروع" oninput="setBenSearch(this.value)">
              <button type="button" class="icon-btn" id="benSearchBtn" title="بحث" onclick="event.stopPropagation();toggleBenSearch();">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16"><path d="M0 0h16v16H0z" fill="none"/><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="m11.25 11.25 3 3"/><circle cx="7.5" cy="7.5" r="4.75"/></g></svg>
              </button>
            </div>
            <div class="period-pop-wrap" id="benFilterWrap">
              <button type="button" class="icon-btn" id="benFilterBtn" title="تصفية" onclick="event.stopPropagation();toggleBenFilterPopover();">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path fill="currentColor" d="M21 3H5a1 1 0 0 0-1 1v2.59c0 .523.213 1.037.583 1.407L10 13.414V21a1 1 0 0 0 1.447.895l4-2c.339-.17.553-.516.553-.895v-5.586l5.417-5.417c.37-.37.583-.884.583-1.407V4a1 1 0 0 0-1-1m-6.707 9.293A1 1 0 0 0 14 13v5.382l-2 1V13a1 1 0 0 0-.293-.707L6 6.59V5h14.001l.002 1.583z"/></svg>
                <span class="filter-badge" id="benFilterBadge" hidden></span>
              </button>
              <div class="period-popover filter-popover" id="benFilterPopover"></div>
            </div>
          </div>
        </div>
        <div class="card-body" id="benRequestsBody" style="padding:0;">
          <table class="fixed-cols mtable" id="benTable">
            <colgroup>
              <col style="width:18%"><col style="width:13%"><col style="width:37%"><col style="width:16%"><col style="width:16%">
            </colgroup>
            <thead><tr id="benTableHead">
              <th class="sortable" data-sort="id">رقم الطلب</th><th class="sortable" data-sort="system">النظام</th><th class="sortable" data-sort="project">المشروع</th><th class="sortable" data-sort="date">تاريخ التقديم</th><th class="sortable" data-sort="status">الحالة</th>
            </tr></thead>
            <tbody id="benTableBody"></tbody>
