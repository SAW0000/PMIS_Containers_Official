  document.getElementById('adminUsersBody').innerHTML = list.length ? list.map(u=>`
    <tr tabindex="0" role="button" aria-haspopup="dialog" data-id="${escapeAttr(u.id)}" onclick="openUserModal('${escapeJsString(u.id)}')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openUserModal('${escapeJsString(u.id)}');}">
      <td data-label="الاسم"><b>${cellClip(u.name)}</b></td>
      <td class="mono" data-label="البريد الإلكتروني">${cellClip(u.email)}</td>
