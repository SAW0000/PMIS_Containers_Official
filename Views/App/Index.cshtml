    } else if(r.status==='approved'){
      html += `<p style="font-size:13px;color:var(--text-mid);margin:0 0 12px;">تم تأكيد السداد. يُتاح تفعيل الرخصة يدويًا على منصة نظام إدارة المشاريع، على أن يتم ذلك خلال (${RESPONSE_SLA_BUSINESS_DAYS}) أيام عمل من تاريخ تأكيد السداد.</p>`;
      html += actionBtn('success','تفعيل الرخصة يدويًا','check',()=>callRequestAction(r.id,'activate','تم تفعيل الرخصة وإشعار المستفيد'));
    } else {
      html += `<div class="empty-state" style="padding:20px;">${ICONS.actionsUnavailable()}<div>لا يوجد إجراء متاح حاليًا لهذه الحالة</div></div>`;
    }
  }
  return html || `<div class="empty-state" style="padding:20px;">${ICONS.actionsUnavailable()}<div>لا يوجد إجراء متاح</div></div>`;
}
function actionBtn(type,label,icon,fn,opensModal,alignStart){
