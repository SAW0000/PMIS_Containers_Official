    {label:'رخص مفعّلة', val: stats.activated},
    {label:'بحاجة إلى إجراء', val: stats.needsAction}
  ];
  document.getElementById('benOverviewSub').textContent = `إجمالي ${stats.total} طلبًا مسجّلًا لك في النظام`;
  document.getElementById('benStatGrid').innerHTML = cells.map(s=>statCell(s)).join('');
  animateStatValues('benStatGrid');
  renderPeriodControl('benPeriodWrap','benPeriodBtn','benPeriodPopover', benPeriod, (p)=>{
    benPeriod = p;
    benActionPage = benLicensesPage = benActivityCardPage = 1;
    benPeriod = p;
    renderDashboard();
  });
}
