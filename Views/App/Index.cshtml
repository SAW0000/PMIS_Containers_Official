let wizCurrentRequestId = null;
let wizCurrentRequestNumber = null;
let wizCurrentRequestStatus = null;
async function ensureWizRequestExists(){
  if(wizCurrentRequestStatus === 'ReturnedForCorrection' || wizCurrentRequestId){
    return null;
  }

  const res = await fetch('/app/requests/draft', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
    body: JSON.stringify(collectWizPayload())
  });
  const data = await res.json().catch(()=>({}));
  if(!res.ok) return data.message || 'تعذر حفظ الطلب';
  wizCurrentRequestId = data.requestId;
  wizCurrentRequestNumber = data.requestNumber;
  wizCurrentRequestStatus = 'Draft';
  return null;
}
async function finalizeWizSubmission(){
  if(wizCurrentRequestStatus === 'ReturnedForCorrection'){
    const res = await fetch(`/app/requests/${encodeURIComponent(wizCurrentRequestId)}/resubmit`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify(collectWizPayload())
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok) return data.message || 'تعذر إعادة إرسال الطلب';
    wizCurrentRequestStatus = 'Submitted';
    return null;
  }

  const res = await fetch(`/app/requests/${encodeURIComponent(wizCurrentRequestId)}/submit-draft`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
    body: JSON.stringify({ agreedToTerms: document.getElementById('agreeChk').checked })
  });
  const data = await res.json().catch(()=>({}));
  if(!res.ok) return data.message || 'تعذر إرسال الطلب';
  wizCurrentRequestStatus = 'Submitted';
  return null;
}
async function createRequestAndUploadAttachments(targetStatus){
  const creationError = await ensureWizRequestExists();
  if(creationError) return { error: creationError };

  const failedTypes = await uploadStagedAttachments(wizCurrentRequestId);
  if(failedTypes.length > 0){
    return {
      error: `تم حفظ الطلب، لكن تعذر رفع ${failedTypes.length} من المرفقات — يرجى مراجعة المرفقات التي ظهر عليها خطأ وإعادة رفعها ثم المحاولة مرة أخرى`,
      partial: true
    };
  }

  if(targetStatus === 'Submitted'){
    const submitError = await finalizeWizSubmission();
    if(submitError) return { error: submitError };
  }
  return null;
}
let wizSubmitInFlight = false;
async function saveDraft(){
  if(wizSubmitInFlight) return;
  const firstInvalid = validateWizDraftMinimum();
  if(firstInvalid){
    if(wizStep!==1){ wizStep=1; showWizStep(); }
    scrollWizErrorIntoView(document.getElementById(firstInvalid));
    showToast('يرجى تعبئة الاسم الأول والاسم الأخير والبريد الإلكتروني ورقم الجوال ونوع المستخدم قبل حفظ المسودة', 'warning');
    return;
  }

  wizSubmitInFlight = true;
  const btn = document.getElementById('btnDraft');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ الحفظ...`;

  try{
    const result = await createRequestAndUploadAttachments('Draft');
    if(result){
      showToast(result.error, 'warning');
      return;
    }
    await refreshRequestsData();
    showToast('تم حفظ الطلب كمسودة بنجاح');
    openView('dashboard');
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    wizSubmitInFlight = false;
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
async function submitRequest(){
  if(wizSubmitInFlight) return;
  wizSubmitInFlight = true;
  const btn = document.getElementById('btnNext');
  const originalHtml = btn.innerHTML;
  const loadingLabel = window.matchMedia(SNAP_BREAKPOINT).matches ? 'جار إرسال' : 'جارٍ إرسال الطلب...';
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}${loadingLabel}`;

  try{
    const result = await createRequestAndUploadAttachments('Submitted');
    if(result){
      showToast(result.error, 'warning');
      return;
    }
    await refreshRequestsData();
    document.getElementById('confirmRequestNumber').textContent = wizCurrentRequestNumber;
    document.getElementById('confirmSlaDays').textContent = RESPONSE_SLA_BUSINESS_DAYS;
    openView('confirm');
    showToast('تم إرسال الطلب بنجاح — سيصلك إشعار بالبريد الإلكتروني');
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    wizSubmitInFlight = false;
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}

