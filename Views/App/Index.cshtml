function sortRequestsFn(col, dir, keys){
  const key = keys[col];
  const mult = dir==='asc' ? 1 : -1;
  return (a,b)=>{
    const av = key(a), bv = key(b);
    if(av < bv) return -1*mult;
    if(av > bv) return 1*mult;
    return 0;
  };
}
