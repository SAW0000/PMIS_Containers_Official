function transitionBellFill(iconEl, filled){
  if(!iconEl) return;
  if(filled){
    iconEl.innerHTML = ICONS.bellAlertLoop;
    return;
  }
  const svg = iconEl.querySelector('svg');
  const bodyPath = svg ? svg.querySelector('path[stroke-dasharray="30"]') : null;
  const wasFilled = bodyPath && bodyPath.getAttribute('fill')==='currentColor' && bodyPath.style.fillOpacity!=='0';
  if(!svg || !bodyPath || !wasFilled){
    iconEl.innerHTML = ICONS.bellLoop;
    return;
  }
  bodyPath.querySelector('animate[attributeName="fill-opacity"]')?.remove();
  bodyPath.style.transition = 'fill-opacity .35s ease';
  bodyPath.style.fillOpacity = '0';
  const alertTick1 = svg.querySelector('path[stroke-dasharray="6"]');
  const alertTick2 = svg.querySelector('path[stroke-dasharray="4"][d="M22 14v0.01"]');
  [alertTick1, alertTick2].forEach(tick=>{
    if(!tick) return;
    tick.style.transition = 'opacity .35s ease';
    tick.style.opacity = '0';
    setTimeout(()=>{ tick.remove(); }, 350);
  });
}

function replaySvgAnimations(container){
