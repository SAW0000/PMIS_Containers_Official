let filePreviewObjectUrl = null;
const uploadedAttachmentPreviewCache = new Map();
function filePreviewKind(fileName){
  const ext = '.'+(fileName.split('.').pop()||'').toLowerCase();
  if(['.jpg','.jpeg','.png'].includes(ext)) return 'image';
  if(ext==='.pdf') return 'pdf';
  return 'unsupported';
}
function renderFilePreview(objectUrl, fileName, sizeLabel){
  document.getElementById('filePreviewTitle').textContent = fileName;
  const kind = filePreviewKind(fileName);
  const body = document.getElementById('filePreviewBody');
  const metaHtml = sizeLabel ? `<div class="file-preview-meta">${sizeLabel}</div>` : '';
  if(kind==='image'){
    body.innerHTML = `<img src="${objectUrl}" alt="${escapeAttr(fileName)}">${metaHtml}`;
  } else if(kind==='pdf'){
    body.innerHTML = `<iframe src="${objectUrl}" title="${escapeAttr(fileName)}"></iframe>${metaHtml}`;
  } else {
    body.innerHTML = `<div class="file-preview-unsupported">تعذر عرض معاينة لهذا النوع من الملفات</div>${metaHtml}`;
  }
  document.getElementById('filePreviewModal').classList.add('open');
}
function closeFilePreview(){
  document.getElementById('filePreviewModal').classList.remove('open');
  document.getElementById('filePreviewBody').innerHTML = '';
  filePreviewObjectUrl = null;
}
window.addEventListener('pagehide', () => {
  for(const cached of uploadedAttachmentPreviewCache.values()){
    URL.revokeObjectURL(cached.objectUrl);
  }
  uploadedAttachmentPreviewCache.clear();
});
function previewLocalFile(file){
  if(filePreviewObjectUrl) URL.revokeObjectURL(filePreviewObjectUrl);
  filePreviewObjectUrl = URL.createObjectURL(file);
  const sizeKb = Math.max(1, Math.round(file.size/1024));
  const sizeLabel = sizeKb >= 1024 ? `${(sizeKb/1024).toFixed(1)} MB` : `${sizeKb} KB`;
  renderFilePreview(filePreviewObjectUrl, file.name, sizeLabel);
}
async function previewUploadedAttachment(attachmentId){
  const cached = uploadedAttachmentPreviewCache.get(attachmentId);
  if(cached){
    renderFilePreview(cached.objectUrl, cached.fileName, cached.sizeLabel);
    return;
  }
  const fileName = detAttachmentsCache.items?.find(a => a.id === attachmentId)?.fileName
    || Object.values(wizUploadedFiles).find(a => a.id === attachmentId)?.fileName
    || 'الملف';
  const dismissLoading = showToast('جاري تحميل و فحص المرفق', 'loading');
  try{
    const res = await fetch(`/app/requests/attachments/${encodeURIComponent(attachmentId)}/download`);
    dismissLoading();
    if(!res.ok){
      showToast('تعذر تحميل المرفق', 'warning');
      return;
    }
    const blob = await res.blob();
    const objectUrl = URL.createObjectURL(blob);
    const sizeKb = Math.max(1, Math.round(blob.size/1024));
    const sizeLabel = sizeKb >= 1024 ? `${(sizeKb/1024).toFixed(1)} MB` : `${sizeKb} KB`;
    uploadedAttachmentPreviewCache.set(attachmentId, { objectUrl, fileName, sizeLabel });
    renderFilePreview(objectUrl, fileName, sizeLabel);
  } catch(err){
    dismissLoading();
    showToast('تعذر تحميل المرفق', 'warning');
  }
}
