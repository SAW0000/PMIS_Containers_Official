let adminUsersPageFetchToken = 0;
async function fetchAdminUsersPage({page, pageSize, search, roles, active, sortCol, sortDir}){
  const myToken = ++adminUsersPageFetchToken;
  const params = new URLSearchParams({ page, pageSize, search: search || '', active, sortCol, sortDir });
  roles.forEach(r => params.append('roles', r));
  let data = null;
  try{
    const res = await fetch(`/app/admin/users/page?${params.toString()}`);
    if(res.ok) data = await res.json();
  } catch(err){
  }
  return { data, isStale: myToken !== adminUsersPageFetchToken };
}
