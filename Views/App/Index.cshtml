    const currentBrand = document.documentElement.getAttribute('data-brand')==='amana' ? 'amanah' : 'blue';
    document.querySelectorAll('.theme-swatch-opt').forEach(opt=>{
      opt.classList.toggle('active', opt.dataset.themeChoice===currentBrand);
