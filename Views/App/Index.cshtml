function setModalNoteEnabled(enabled){
  const note = document.getElementById('modalNote');
  note.disabled = !enabled;
  note.placeholder = enabled ? 'اكتب ملاحظتك هنا...' : 'اختر سببًا أولًا لتفعيل حقل الملاحظة...';
