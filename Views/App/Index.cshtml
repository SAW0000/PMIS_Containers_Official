async function saveReasonOption(){
  const title = document.getElementById('newReasonTitle').value.trim();
  const note = document.getElementById('newReasonNote').value.trim();
  if(!title || !note){
    showToast('يرجى إدخال عنوان السبب والوصف الافتراضي', 'warning');
    return;
  }

  const isEdit = editingReasonId !== null;
  const editedId = editingReasonId;
  const btn = document.getElementById('modalConfirmBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ الحفظ...`;

  try{
    const res = await fetch(isEdit ? `/app/rejection-reasons/${encodeURIComponent(editedId)}` : '/app/rejection-reasons', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ label: title, defaultNote: note })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر حفظ السبب', 'warning');
      return;
    }

    await refreshReasonOptions();
    const targetId = isEdit ? editedId : (data && data.id);
    closeAddReasonStep();
    renderReasonPanel();
    const optEl = document.querySelector(`#modalReasonPanel .reason-opt[data-value="${targetId}"]`);
    if(optEl) pickReason(optEl);
    showToast(isEdit ? 'تم تعديل السبب' : 'تمت إضافة السبب الجديد');
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
async function deleteReasonOption(id){
  const option = reasonOptions.find(o=>o.id===id);
  if(!option) return;

  const confirmed = await confirmDialog(
    `سيتم حذف السبب "${option.label}" نهائيًا من قائمة الأسباب لدى جميع الموظفين. هل تريد المتابعة؟`,
    'حذف السبب');
  if(!confirmed) return;

  try{
    const res = await fetch(`/app/rejection-reasons/${encodeURIComponent(id)}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-TOKEN': csrfToken() }
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر حذف السبب', 'warning');
      return;
    }

    const wasSelected = modalAction && modalAction.reason === id;
    await refreshReasonOptions();
    renderReasonPanel();
    if(wasSelected) resetReasonSelect();
    showToast('تم حذف السبب');
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  }
}
