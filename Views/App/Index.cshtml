function renderTrendChart(containerId, trendPoints){
  const container = document.getElementById(containerId);
  const points = trendPoints.map(p=>({label: p.label, avg: p.avgDays}));

  if(window.matchMedia(SNAP_BREAKPOINT).matches){
    renderTrendBars(container, points);
    return;
  }

  const W = 560, H = 176, padL = 28, padR = 10, padT = 30, padB = 26;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const vals = points.map(p=>p.avg).filter(v=>v!==null);
  const maxVal = Math.max(1, ...vals);
  const n = points.length;
  const xAt = i => padL + (n===1 ? plotW/2 : (i/(n-1))*plotW);
  const yAt = v => padT + plotH - (v/maxVal)*plotH;

  const withVals = points.map((p,i)=>({...p, i})).filter(p=>p.avg!==null);
  const linePath = withVals.map((p,idx)=>`${idx===0?'M':'L'}${xAt(p.i).toFixed(1)},${yAt(p.avg).toFixed(1)}`).join(' ');
  const areaPath = withVals.length ? `${linePath} L${xAt(withVals[withVals.length-1].i).toFixed(1)},${(padT+plotH).toFixed(1)} L${xAt(withVals[0].i).toFixed(1)},${(padT+plotH).toFixed(1)} Z` : '';

  const gridLines = [0,.5,1].map(t=>{
    const y = padT + plotH*t;
    return `<line class="trend-gridline" x1="${padL}" y1="${y.toFixed(1)}" x2="${W-padR}" y2="${y.toFixed(1)}"/>`;
  }).join('');

  const DRAW_DUR = 1.1; 
  const dots = withVals.map((p,idx)=>{
    const delay = (DRAW_DUR * (withVals.length<=1 ? 1 : idx/(withVals.length-1))).toFixed(2);
    return `
    <circle class="trend-dot" style="animation-delay:${delay}s" cx="${xAt(p.i).toFixed(1)}" cy="${yAt(p.avg).toFixed(1)}" r="4"/>
    <text class="trend-value" style="animation-delay:${delay}s" x="${xAt(p.i).toFixed(1)}" y="${(yAt(p.avg)-10).toFixed(1)}" text-anchor="middle">${p.avg}</text>
  `;}).join('');
  const labels = points.map((p,i)=>`<text class="trend-label" style="animation-delay:${(DRAW_DUR*.3).toFixed(2)}s" x="${xAt(i).toFixed(1)}" y="${H-6}" text-anchor="middle">${p.label}</text>`).join('');

  container.innerHTML = `<div class="trend-chart">
    <svg viewBox="0 0 ${W} ${H}">
      <defs>
        <linearGradient id="trendFillGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--brand-800)" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="var(--brand-800)" stop-opacity="0"/>
        </linearGradient>
      </defs>
      ${gridLines}
      ${areaPath ? `<path class="trend-fill" style="animation-delay:${(DRAW_DUR*.5).toFixed(2)}s" d="${areaPath}"/>` : ''}
      ${linePath ? `<path class="trend-line" pathLength="1" style="animation-duration:${DRAW_DUR}s" d="${linePath}"/>` : ''}
      ${dots}
      ${labels}
    </svg>
  </div>`;
}

function renderTrendBars(container, points){
  const maxVal = Math.max(1, ...points.filter(p=>p.avg!==null).map(p=>p.avg));
  const STAGGER = 0.07;
  const rows = points.map((p,i)=>{
    const pct = p.avg===null ? 0 : Math.max(6, Math.round((p.avg/maxVal)*100));
    const delay = (i*STAGGER).toFixed(2);
    return `
    <div class="bar-row">
      <div class="bar-month">${p.label}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;animation-delay:${delay}s"></div></div>
      <div class="bar-value">${p.avg===null?'—':p.avg}</div>
    </div>`;
  }).join('');
  container.innerHTML = `<div class="trend-bars">${rows}</div>`;
}

function renderSlaCardFromDto(containerId, sla){
  const container = document.getElementById(containerId);
  const { targetDays, withinCount: within, totalRespondedCount: total, pct } = sla;

  const R = 54, C = 2*Math.PI*R;
  const offset = C - (pct/100)*C;

  container.innerHTML = `
    <div class="sla-ring-wrap">
      <svg viewBox="0 0 132 132">
        <circle class="sla-ring-track" cx="66" cy="66" r="${R}"/>
        <circle class="sla-ring-val" cx="66" cy="66" r="${R}" stroke-dasharray="${C.toFixed(1)}" stroke-dashoffset="${C.toFixed(1)}" data-offset="${offset.toFixed(1)}"/>
      </svg>
      <div class="sla-ring-center"><b data-val="${pct}">0%</b><span>ضمن ${targetDays} أيام عمل</span></div>
    </div>
    <div class="sla-legend">
      <div class="sla-legend-item"><span class="sla-legend-dot" style="background:var(--brand-800)"></span>ضمن المهلة (${within})</div>
      <div class="sla-legend-item"><span class="sla-legend-dot" style="background:var(--border)"></span>تجاوز المهلة (${total-within})</div>
    </div>
  `;
  const valEl = container.querySelector('.sla-ring-center b');
  requestAnimationFrame(()=>{
    setTimeout(()=>{
      const ring = container.querySelector('.sla-ring-val');
      ring.style.strokeDashoffset = ring.getAttribute('data-offset');
      const target = pct, start = performance.now(), dur = 900;
      (function step(now){
        const t = Math.min(1, (now-start)/dur);
        valEl.textContent = Math.round(target * (1 - Math.pow(1-t, 2))) + '%';
        if(t < 1) requestAnimationFrame(step);
      })(performance.now());
    }, 50);
  });
}

