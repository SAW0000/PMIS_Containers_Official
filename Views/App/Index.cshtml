      return `<button type="button" class="nav-item" onclick="toggleMenuPop(this)">
        ${ICONS[it.icon]}<span class="nav-label">${it.label}</span>
      </button>`;
    }
    let count = '';
    if(it.countKey==='notif') count = notifPopoverUnread.length;
    if(it.countKey==='review') count = submittedCount;
    const icon = it.icon==='bell' ? (hasUnread ? ICONS.bellAlertLoop : ICONS.bellLoop) : ICONS[it.icon];
    return `<button type="button" class="nav-item" data-view="${it.view}" onclick="closeMenuPop();${it.action||`openView('${it.view}')`}">
      ${icon}<span class="nav-label">${it.label}</span>${count>0?`<span class="count">${count}</span>`:''}
    </button>`;
  }).join('');
  document.getElementById('bottomNav').innerHTML = html;
  const activeBtn = document.querySelector(`#bottomNav .nav-item[data-view="${currentView}"]`);
  if(activeBtn) activeBtn.classList.add('active');
