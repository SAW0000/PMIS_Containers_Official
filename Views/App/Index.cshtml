    .forEach(el => el.classList.remove('error'));
  document.querySelectorAll('#view-newrequest .field-error-msg').forEach(el => el.style.display = 'none');
}
function wireWizLiveValidation(){
  const textFieldMap = {
    wizFirstName:'fieldWizFirstName', wizLastName:'fieldWizLastName',
    wizCompanyName:'fieldWizCompanyName', wizCommercialNo:'fieldWizCommercialNo',
    wizProjectName:'fieldWizProjectName', wizContractNumber:'fieldWizContractNumber'
  };
  Object.entries(textFieldMap).forEach(([inputId, fieldId])=>{
    document.getElementById(inputId)?.addEventListener('input', ()=>{
      if(document.getElementById(inputId).value.trim() !== '') setWizFieldError(fieldId, false);
    });
  });
  document.getElementById('wizEmail')?.addEventListener('input', function(){
    const val = this.value.trim();
    if(val !== '' && WIZ_EMAIL_REGEX.test(val)) setWizFieldError('fieldWizEmail', false, 'errWizEmail');
  });
  document.getElementById('wizMobile')?.addEventListener('input', function(){
    const val = this.value.trim();
    if(val !== '' && WIZ_MOBILE_REGEX.test(val)) setWizFieldError('fieldWizMobile', false, 'errWizMobile');
  });
  document.getElementById('agreeChk')?.addEventListener('change', function(){
    if(this.checked) setWizFieldError('fieldAgreeChk', false, 'errAgreeChk');
  });
}
function renderWizSystemOptions(){
  const row = document.getElementById('wizSystemRadioRow');
  if(!row) return;
  row.innerHTML = TARGET_SYSTEMS.map((s,i)=>`
    <label class="radio-opt${i===0?' checked':''}" style="flex:0 0 240px;">
      <input type="radio" name="sys" value="${escapeAttr(s.id)}"${i===0?' checked':''}> ${escapeHtml(s.systemName)}
    </label>
  `).join('');
}
document.addEventListener('change', e=>{
  const input = e.target;
  if(input.type!=='radio') return;
  document.querySelectorAll(`input[type="radio"][name="${input.name}"]`).forEach(r=>{
    r.closest('.radio-opt')?.classList.toggle('checked', r.checked);
  });
  if(input.name==='utype') setWizFieldError('fieldWizUtype', false);
  if(input.name==='sys') setWizFieldError('fieldWizSystem', false);
});
function renderStepper(){
  const titleEl = document.getElementById('stepperTitle');
  if(titleEl) titleEl.textContent = wizSteps[wizStep-1];
  const descEl = document.getElementById('stepperDesc');
  if(descEl) descEl.textContent = wizStepDescriptions[wizStep] || WIZ_DESC_PLACEHOLDER;

  const bar = document.getElementById('stepperBar');
  let stepEls = bar.querySelectorAll(':scope > .step');

  if(stepEls.length !== wizSteps.length){
    let html = '';
    wizSteps.forEach((label,i)=>{
      const n = i+1;
      html += `<div class="step" data-n="${n}"><div class="circle"></div></div>`;
      if(n<wizSteps.length) html += `<div class="step-line"></div>`;
    });
    bar.innerHTML = html;
    stepEls = bar.querySelectorAll(':scope > .step');
  }

  stepEls.forEach(stepEl=>{
    const n = parseInt(stepEl.dataset.n, 10);
    const newState = n<wizStep?'done':(n===wizStep?'current':'upcoming');
    const oldState = stepEl.dataset.state || null;
    if(newState===oldState) return; 

    const circle = stepEl.querySelector('.circle');
    if(newState==='done'){
      circle.innerHTML = iconStepDone(n, !wizAnimatedSteps.has(n));
      wizAnimatedSteps.add(n);
    } else if(newState==='current'){
      if(oldState==='done') circle.innerHTML = iconStepDoneToCurrent(n);
      else if(oldState==='upcoming') circle.innerHTML = ICONS.stepUpcomingToCurrent;
      else circle.innerHTML = ICONS.stepCurrent;
    } else {
      circle.innerHTML = oldState==='current' ? ICONS.stepCurrentToUpcoming : ICONS.stepUpcoming;
    }
    stepEl.className = newState==='upcoming' ? 'step' : `step ${newState}`;
    stepEl.dataset.state = newState;
  });

  bar.querySelector('.step.current')?.scrollIntoView({block:'nearest', inline:'nearest'});
}
function wizGotoStep(){
  const track = document.getElementById('wizTrack');
  if(!track) return;
  track.style.transform = window.matchMedia(SNAP_BREAKPOINT).matches
    ? `translateY(${-(wizStep-1)*100}%)`
    : '';
}
function showWizStep(){
  document.querySelectorAll('.wiz-step').forEach(s=>{
    const isActive = parseInt(s.getAttribute('data-step'))===wizStep;
    s.style.display = isActive ? 'block':'none';
  });
  wizGotoStep();
  document.getElementById('btnPrev').style.display = wizStep>1 ? 'inline-flex':'none';
  const isLast = wizStep>=wizSteps.length;
  const sendLabel = window.matchMedia(SNAP_BREAKPOINT).matches ? 'إرسال' : 'إرسال الطلب';
  if(isLast !== showWizStep.lastIconWasSend){
    document.getElementById('btnNext').innerHTML = isLast
      ? `<span class="btn-label">${sendLabel}</span>${ICONS.send}`
      : `<span class="btn-label">التالي</span>${ICONS.chevronLeft}`;
    showWizStep.lastIconWasSend = isLast;
  } else {
    const nextLabel = document.querySelector('#btnNext .btn-label');
    if(nextLabel) nextLabel.textContent = isLast ? sendLabel : 'التالي';
  }
  if(wizStep===5){ renderAttachGrid(); renderAttachAllowedExtHint(); }
  if(wizStep===6) renderWizBankAccounts();
  if(wizStep===7) renderWizTermsAndConditions();
  if(wizStep===8) renderWizFinalReview();
  renderStepper();
}
function renderWizTermsAndConditions(){
  const listEl = document.getElementById('wizTermsList');
  if(listEl){
    const lines = TERMS_AND_CONDITIONS_TEXT.split('\n').map(line => line.trim()).filter(Boolean);
    listEl.innerHTML = lines.map(line => `<li>${escapeHtml(line)}</li>`).join('');
  }
  const labelEl = document.getElementById('wizTermsAgreementLabel');
  if(labelEl) labelEl.textContent = TERMS_AGREEMENT_LABEL;
}
const WIZ_EMAIL_REGEX = /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/;
const WIZ_MOBILE_REGEX = /^05\d{8}$/;
function setWizFieldError(fieldId, hasError, msgId){
  const el = document.getElementById(fieldId);
  if(el) el.classList.toggle('error', hasError);
  if(msgId){
    const msgEl = document.getElementById(msgId);
    if(msgEl) msgEl.style.display = hasError ? 'block' : 'none';
  }
}
function validateWizDraftMinimum(){
  let firstInvalid = null;
  const markRequired = (fieldId, inputId) => {
    const val = document.getElementById(inputId).value.trim();
    const invalid = val === '';
    setWizFieldError(fieldId, invalid);
    if(invalid && !firstInvalid) firstInvalid = fieldId;
    return !invalid;
  };

  markRequired('fieldWizFirstName','wizFirstName');
  markRequired('fieldWizLastName','wizLastName');
  const email = document.getElementById('wizEmail').value.trim();
  const emailInvalid = email==='' || !WIZ_EMAIL_REGEX.test(email);
  setWizFieldError('fieldWizEmail', emailInvalid, 'errWizEmail');
  document.getElementById('errWizEmail').textContent = email==='' ? 'البريد الإلكتروني مطلوب' : 'صيغة البريد الإلكتروني غير صحيحة';
  if(emailInvalid && !firstInvalid) firstInvalid = 'fieldWizEmail';
  const mobile = document.getElementById('wizMobile').value.trim();
  const mobileInvalid = mobile==='' || !WIZ_MOBILE_REGEX.test(mobile);
  setWizFieldError('fieldWizMobile', mobileInvalid, 'errWizMobile');
  document.getElementById('errWizMobile').textContent = mobile==='' ? 'رقم الجوال مطلوب' : 'رقم الجوال غير صحيح — يجب أن يبدأ بـ 05 ويتكون من 10 أرقام';
  if(mobileInvalid && !firstInvalid) firstInvalid = 'fieldWizMobile';
  const utypeInvalid = !document.querySelector('input[name="utype"]:checked');
  setWizFieldError('fieldWizUtype', utypeInvalid);
  if(utypeInvalid && !firstInvalid) firstInvalid = 'fieldWizUtype';

  return firstInvalid;
}
function validateWizStep(step){
  let firstInvalid = null;
  const markRequired = (fieldId, inputId) => {
    const val = document.getElementById(inputId).value.trim();
    const invalid = val === '';
    setWizFieldError(fieldId, invalid);
    if(invalid && !firstInvalid) firstInvalid = fieldId;
    return !invalid;
  };
  const markFile = (fieldId, attachmentType) => {
    const invalid = !wizStagedFiles[attachmentType] && !wizUploadedFiles[attachmentType];
    setWizFieldError(fieldId, invalid);
    if(invalid && !firstInvalid) firstInvalid = fieldId;
    return !invalid;
  };

  if(step===1){
    firstInvalid = validateWizDraftMinimum();
    markFile('fieldWizSignature','ElectronicSignature');
  } else if(step===2){
    markRequired('fieldWizCompanyName','wizCompanyName');
    markRequired('fieldWizCommercialNo','wizCommercialNo');
    markFile('fieldWizLogo','CompanyLogo');
  } else if(step===3){
    const invalid = !document.querySelector('input[name="sys"]:checked');
    setWizFieldError('fieldWizSystem', invalid);
    if(invalid && !firstInvalid) firstInvalid = 'fieldWizSystem';
  } else if(step===4){
    markRequired('fieldWizProjectName','wizProjectName');
    markRequired('fieldWizContractNumber','wizContractNumber');
  } else if(step===5){
    const gridTypes = WIZ_ATTACHMENT_SLOTS.filter(s => s.boxId === null).map(s => s.type);
    const invalid = gridTypes.some(t => !wizStagedFiles[t] && !wizUploadedFiles[t]);
    const errEl = document.getElementById('errWizAttachGrid');
    if(errEl) errEl.style.display = invalid ? 'block' : 'none';
    if(invalid && !firstInvalid) firstInvalid = 'attachGrid';
  } else if(step===6){
    markFile('fieldWizTransferReceipt','TransferReceipt');
  } else if(step===7){
    const invalid = !document.getElementById('agreeChk').checked;
    setWizFieldError('fieldAgreeChk', invalid, 'errAgreeChk');
    if(invalid && !firstInvalid) firstInvalid = 'fieldAgreeChk';
  }

  if(firstInvalid){
    scrollWizErrorIntoView(document.getElementById(firstInvalid));
    showToast('يرجى التأكد من المدخلات بصورة صحيحة قبل المتابعة', 'warning');
    return false;
  }
  return true;
}
function scrollWizErrorIntoView(fieldEl){
  if(!fieldEl) return;
  const step = fieldEl.closest('.wiz-step');
  if(!step){ fieldEl.scrollIntoView({behavior:'smooth', block:'center'}); return; }
  const stepRect = step.getBoundingClientRect();
  const fieldRect = fieldEl.getBoundingClientRect();
  const delta = (fieldRect.top + fieldRect.height/2) - (stepRect.top + stepRect.height/2);
  step.scrollBy({top: delta, behavior: 'smooth'});
}
function wizNext(){
  if(wizStep<wizSteps.length){
    if(!validateWizStep(wizStep)) return;
    const iconWillRebuild = (wizStep+1>=wizSteps.length) !== showWizStep.lastIconWasSend;
    wizStep++; showWizStep(); window.scrollTo(0,0);
    if(!iconWillRebuild) replaySvgAnimations(document.getElementById('btnNext'));
  }
  else { submitRequest(); }
}
function wizPrev(){
  if(wizStep>1){
    wizStep--; showWizStep(); window.scrollTo(0,0);
    replaySvgAnimations(document.getElementById('btnPrev'));
  }
}
function renderAttachGrid(){
  const gridSlots = WIZ_ATTACHMENT_SLOTS.filter(s => s.boxId === null);
  document.getElementById('attachGrid').innerHTML = gridSlots.map(s => `
    <div id="uploadBox_${s.type}"></div>
    <input type="file" id="fileInput_${s.type}" accept="${WIZ_ALLOWED_EXTENSIONS.join(',')}" style="display:none;" onchange="onWizFileSelected('${s.type}', this)">
  `).join('');
  gridSlots.forEach(s => renderWizUploadBox(s.type, s.label));
}
function renderWizUploadBox(attachmentType, label){
  const box = document.getElementById('uploadBox_'+attachmentType);
  if(!box) return;
  const file = wizStagedFiles[attachmentType];
  const uploaded = wizUploadedFiles[attachmentType];
  const failed = box.dataset.uploadFailed === '1';
  if(!file && !uploaded){
    box.className = 'upload-box';
    box.removeAttribute('onclick');
    box.style.cursor = '';
    box.title = 'خانة المرفق';
    box.innerHTML = `
      <div class="upload-left">
        <div class="upload-ic upload-ic-bare">${ICONS.fileDoc}</div>
        <div><div class="upload-name">${label}</div><div class="upload-sub">لم يتم اختيار ملف بعد</div></div>
      </div>
      <button type="button" class="btn btn-ghost upload-box-btn" title="اختيار ملف" onclick="document.getElementById('fileInput_${attachmentType}').click()">${ICONS.fileUpload}</button>
    `;
    return;
  }
  box.className = 'upload-box filled';
  if(file){
    const sizeKb = Math.max(1, Math.round(file.size/1024));
    const sizeLabel = sizeKb >= 1024 ? `${(sizeKb/1024).toFixed(1)} MB` : `${sizeKb} KB`;
    box.setAttribute('onclick', `previewLocalFile(wizStagedFiles['${attachmentType}'])`);
    box.style.cursor = 'pointer';
    box.title = 'اضغط لعرض المرفق';
    box.innerHTML = `
      <div class="upload-left">
        <div class="upload-ic upload-ic-bare">${ICONS.fileDoc}</div>
        <div><div class="upload-name" title="${escapeHtml(file.name)}">${escapeHtml(file.name)}</div><div class="upload-sub">${failed ? '<span style="color:var(--danger-700, #c0392b);">تعذر رفع الملف — حاول مرة أخرى</span>' : `جاهز للرفع — ${sizeLabel}`}</div></div>
      </div>
      <div class="upload-actions">
        <button type="button" class="btn btn-ghost upload-box-btn" title="استبدال" onclick="event.stopPropagation();document.getElementById('fileInput_${attachmentType}').click()">${ICONS.fileReplace}</button>
        <button type="button" class="btn btn-ghost upload-box-btn" title="حذف" onclick="event.stopPropagation();removeWizStagedFile('${attachmentType}')">${ICONS.fileDelete}</button>
      </div>
    `;
    return;
  }
  const sizeKb = Math.max(1, Math.round(uploaded.fileSize/1024));
  const sizeLabel = sizeKb >= 1024 ? `${(sizeKb/1024).toFixed(1)} MB` : `${sizeKb} KB`;
  box.setAttribute('onclick', `previewUploadedAttachment('${uploaded.id}')`);
  box.style.cursor = 'pointer';
  box.title = 'اضغط لعرض المرفق';
  box.innerHTML = `
    <div class="upload-left">
      <div class="upload-ic upload-ic-bare">${ICONS.fileDoc}</div>
      <div><div class="upload-name" title="${escapeHtml(uploaded.fileName)}">${escapeHtml(uploaded.fileName)}</div><div class="upload-sub">${sizeLabel} · تم الرفع</div></div>
    </div>
    <div class="upload-actions">
      <button type="button" class="btn btn-ghost upload-box-btn" title="استبدال" onclick="event.stopPropagation();document.getElementById('fileInput_${attachmentType}').click()">${ICONS.fileReplace}</button>
      <button type="button" class="btn btn-ghost upload-box-btn" title="حذف" onclick="event.stopPropagation();removeWizStagedFile('${attachmentType}')">${ICONS.fileDelete}</button>
    </div>
  `;
}
async function removeWizStagedFile(attachmentType){
  const slot = WIZ_ATTACHMENT_SLOTS.find(s => s.type===attachmentType);
  const label = slot ? slot.label : attachmentType;

  if(wizStagedFiles[attachmentType]){
    delete wizStagedFiles[attachmentType];
    const box = document.getElementById('uploadBox_'+attachmentType);
    if(box) delete box.dataset.uploadFailed;
    renderWizUploadBox(attachmentType, label);
    return;
  }

  const uploaded = wizUploadedFiles[attachmentType];
  if(!uploaded) return;
  if(!(await confirmDialog(`سيتم حذف الملف "${uploaded.fileName}" نهائيًا.`, 'حذف المرفق'))) return;

  try{
    const res = await fetch(`/app/requests/attachments/${encodeURIComponent(uploaded.id)}`, {
      method: 'DELETE',
      headers: { 'X-CSRF-TOKEN': csrfToken() }
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر حذف المرفق', 'warning');
      return;
    }
    delete wizUploadedFiles[attachmentType];
    renderWizUploadBox(attachmentType, label);
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  }
}
function onWizFileSelected(attachmentType, inputEl){
  const file = inputEl.files && inputEl.files[0];
  inputEl.value = '';
  if(!file) return;

  const ext = '.'+file.name.split('.').pop().toLowerCase();
  if(!WIZ_ALLOWED_EXTENSIONS.includes(ext)){
    showToast('نوع الملف غير مدعوم — يُسمح فقط بـ PDF وJPG وPNG', 'warning');
    return;
  }
  if(file.size > WIZ_MAX_UPLOAD_MB*1024*1024){
    showToast(`حجم الملف يجب ألا يتجاوز ${WIZ_MAX_UPLOAD_MB} ميجابايت`, 'warning');
    return;
  }

  wizStagedFiles[attachmentType] = file;
  const box = document.getElementById('uploadBox_'+attachmentType);
  if(box) delete box.dataset.uploadFailed;
  const slot = WIZ_ATTACHMENT_SLOTS.find(s => s.type===attachmentType);
  renderWizUploadBox(attachmentType, slot ? slot.label : attachmentType);

  const fixedSlotFieldIds = { ElectronicSignature:'fieldWizSignature', CompanyLogo:'fieldWizLogo', TransferReceipt:'fieldWizTransferReceipt' };
  if(fixedSlotFieldIds[attachmentType]){
    setWizFieldError(fixedSlotFieldIds[attachmentType], false);
  } else {
    const gridTypes = WIZ_ATTACHMENT_SLOTS.filter(s => s.boxId === null).map(s => s.type);
    if(gridTypes.every(t => wizStagedFiles[t] || wizUploadedFiles[t])){
      const errEl = document.getElementById('errWizAttachGrid');
      if(errEl) errEl.style.display = 'none';
    }
  }
}
function resetWizAttachments(){
  wizStagedFiles = {};
  wizUploadedFiles = {};
  WIZ_ATTACHMENT_SLOTS.forEach(s=>{
    if(s.boxId) renderWizUploadBox(s.type, s.label);
  });
}
async function loadWizUploadedAttachments(requestId){
  wizUploadedFiles = {};
  try{
    const res = await fetch(`/app/requests/${encodeURIComponent(requestId)}/attachments`);
    if(!res.ok) return;
    const items = await res.json();
    items.forEach(a => { wizUploadedFiles[a.attachmentType] = a; });
  } catch(err){
  }
  WIZ_ATTACHMENT_SLOTS.forEach(s=>{
    if(s.boxId) renderWizUploadBox(s.type, s.label);
  });
}
async function uploadStagedAttachments(requestId){
  const failedTypes = [];
  const hasFiles = Object.keys(wizStagedFiles).length > 0;
  const dismissProgressToast = hasFiles ? showToast('جاري رفع و فحص المرفقات', true) : null;
  const shownMessages = new Set();
  for(const [attachmentType, file] of Object.entries(wizStagedFiles)){
    const box = document.getElementById('uploadBox_'+attachmentType);
    try{
      const formData = new FormData();
      formData.append('file', file);
      const res = await fetch(`/app/requests/${encodeURIComponent(requestId)}/attachments/${encodeURIComponent(attachmentType)}`, {
        method: 'POST',
        headers: { 'X-CSRF-TOKEN': csrfToken() },
        body: formData
      });
      if(!res.ok){
        failedTypes.push(attachmentType);
        if(box) box.dataset.uploadFailed = '1';
        const data = await res.json().catch(()=>null);
        if(data?.message && !shownMessages.has(data.message)){
          shownMessages.add(data.message);
          showToast(data.message, 'warning');
        }
      } else {
        delete wizStagedFiles[attachmentType];
        if(box) delete box.dataset.uploadFailed;
      }
    } catch(err){
      failedTypes.push(attachmentType);
      if(box) box.dataset.uploadFailed = '1';
    }
  }
  dismissProgressToast?.();
  WIZ_ATTACHMENT_SLOTS.forEach(s=>{
    if(document.getElementById('uploadBox_'+s.type)) renderWizUploadBox(s.type, s.label);
  });
  return failedTypes;
}
