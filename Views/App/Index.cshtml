let snapScrollEndHandler = null;
let snapScrollHandler = null;
const SNAP_BREAKPOINT = '(max-width: 1024px)';
const SNAP_ORDER_OVERRIDES = {
  dashboard: ['dashNewReqSection', 'benQuickLinks']
};
const SNAP_MERGE_VIEWS = ['my-profile', 'notifications', 'activity'];
const SNAP_GROUP_OVERRIDES = {
  'account-settings': [['settingsPageHead', 'accountInfoCard']],
  'detail': [['detPageHead', 'detSummaryCard']]
};
const SNAP_EXCLUDED_VIEWS = [];
function findSnapSections(viewEl){
  const sections = [];
  let pendingChrome = [];
  Array.from(viewEl.children).forEach(child=>{
    const isAlreadyWrapped = el => el.parentElement && el.parentElement.classList.contains('snap-section');
    const isHidden = el => getComputedStyle(el).display === 'none';
    if(child.classList.contains('snap-section')) return;
    if(isHidden(child)) return;
    if(child.classList.contains('breadcrumb') || child.classList.contains('stepper')){
      if(!isAlreadyWrapped(child)) pendingChrome.push(child);
      return;
    }
    if(child.classList.contains('two-col')){
      const cards = Array.from(child.querySelectorAll('.card')).filter(c=>!isAlreadyWrapped(c) && !isHidden(c));
      cards.forEach((card,i)=>{
        sections.push({el:card, chrome: i===0 ? pendingChrome : []});
      });
      pendingChrome = [];
    } else if(child.classList.contains('card')){
      if(!isAlreadyWrapped(child)) sections.push({el:child, chrome:pendingChrome});
      pendingChrome = [];
    } else {
      sections.push({el:child, chrome:pendingChrome}); 
      pendingChrome = [];
    }
  });

  const overrideIds = SNAP_ORDER_OVERRIDES[viewEl.id.replace(/^view-/,'')];
  if(overrideIds && overrideIds.length){
    const pinned = [];
    overrideIds.forEach(id=>{
      const idx = sections.findIndex(s=>s.el.querySelector(`#${id}`) || s.el.id===id);
      if(idx!==-1) pinned.push(sections.splice(idx,1)[0]);
    });
    sections.push(...pinned);
  }

  if(SNAP_MERGE_VIEWS.includes(viewEl.id.replace(/^view-/,'')) && sections.length>1){
    const mergedChrome = sections.slice(0,-1).flatMap(s=>[...s.chrome, s.el]);
    const last = sections[sections.length-1];
    return [{el:last.el, chrome:[...mergedChrome, ...last.chrome]}];
  }

  const groups = SNAP_GROUP_OVERRIDES[viewEl.id.replace(/^view-/,'')];
  if(groups && groups.length){
    groups.forEach(ids=>{
      const idxs = ids.map(id=>sections.findIndex(s=>s.el.querySelector(`#${id}`) || s.el.id===id)).filter(i=>i!==-1);
      if(idxs.length<2) return; 
      idxs.sort((a,b)=>a-b);
      const members = idxs.map(i=>sections[i]);
      const mergedChrome = members.slice(0,-1).flatMap(s=>[...s.chrome, s.el]);
      const last = members[members.length-1];
      const merged = {el:last.el, chrome:[...mergedChrome, ...last.chrome]};
      for(let k=idxs.length-1;k>=0;k--) sections.splice(idxs[k],1);
      sections.splice(idxs[0],0,merged);
    });
  }

  return sections;
}
let snapAnchorSeq = 0;
function wrapSnapChildren(viewEl){
  const overridden = [];
  findSnapSections(viewEl).forEach(({el:card, chrome})=>{
    if(card.parentElement && card.parentElement.classList.contains('snap-section')) return; 
    const wrapper = document.createElement('div');
    wrapper.className = 'snap-section';
    if(chrome.length) wrapper.classList.add('snap-section-chrome');
    chrome.forEach(c=>{
      const anchorId = 'snap-anchor-'+(snapAnchorSeq++);
      c.before(document.createComment(anchorId));
      c.dataset.snapAnchor = anchorId;
    });
    card.replaceWith(wrapper);
    chrome.forEach(c=>wrapper.appendChild(c));
    wrapper.appendChild(card);
    if(SNAP_ORDER_OVERRIDES[viewEl.id.replace(/^view-/,'')]?.some(id=>card.querySelector(`#${id}`) || card.id===id)){
      const anchorId = 'snap-anchor-'+(snapAnchorSeq++);
      wrapper.before(document.createComment(anchorId));
      wrapper.dataset.snapAnchor = anchorId;
      overridden.push(wrapper);
    }
  });
  overridden.forEach(wrapper=>viewEl.appendChild(wrapper));
}
function unwrapSnapChildren(viewEl){
  const anchors = {};
  const it = document.createNodeIterator(viewEl, NodeFilter.SHOW_COMMENT);
  let n;
  while((n = it.nextNode())){ anchors[n.textContent] = n; }

  viewEl.querySelectorAll('.snap-section').forEach(wrapper=>{
    const wrapperAnchor = wrapper.dataset.snapAnchor ? anchors[wrapper.dataset.snapAnchor] : null;
    while(wrapper.firstElementChild){
      const child = wrapper.firstElementChild;
      const childAnchor = child.dataset.snapAnchor ? anchors[child.dataset.snapAnchor] : null;
      const target = childAnchor || wrapperAnchor;
      if(target) target.before(child);
      else wrapper.before(child);
      if(childAnchor){ childAnchor.remove(); delete anchors[child.dataset.snapAnchor]; delete child.dataset.snapAnchor; }
    }
    if(wrapperAnchor){ wrapperAnchor.remove(); delete anchors[wrapper.dataset.snapAnchor]; }
    wrapper.remove();
  });
}
function currentSnapSection(main, sections){
  const mainMid = main.getBoundingClientRect().top + main.clientHeight/2;
  return sections.find(sec=>{
    const r = sec.getBoundingClientRect();
    return r.top <= mainMid && r.bottom >= mainMid;
  }) || null;
}
function replaySnapSection(sec){}
let snapVisibilityRaf = null;
function updateSnapVisibility(main, sections, current){
  sections.forEach(sec=>sec.classList.toggle('snap-current', sec===current));
}
function initSnapSections(viewEl, opts){
  if(!viewEl) return;
  const preserveScroll = opts && opts.preserveScroll;
  const main = document.querySelector('.main');
  if(snapScrollEndHandler){ main.removeEventListener('scrollend', snapScrollEndHandler); snapScrollEndHandler = null; }
  if(snapScrollHandler){ main.removeEventListener('scroll', snapScrollHandler); snapScrollHandler = null; }
  if(SNAP_EXCLUDED_VIEWS.includes(viewEl.id.replace(/^view-/,''))){ unwrapSnapChildren(viewEl); if(!preserveScroll) main.scrollTop = 0; return; }
  if(!window.matchMedia(SNAP_BREAKPOINT).matches){ unwrapSnapChildren(viewEl); if(!preserveScroll) main.scrollTop = 0; return; }

  wrapSnapChildren(viewEl);
  const sections = Array.from(viewEl.querySelectorAll('.snap-section'));

  let lastCurrent = currentSnapSection(main, sections);
  updateSnapVisibility(main, sections, lastCurrent);
  snapScrollEndHandler = ()=>{
    const now = currentSnapSection(main, sections);
    if(now && now !== lastCurrent) replaySnapSection(now);
    lastCurrent = now;
    updateSnapVisibility(main, sections, now);
  };
  main.addEventListener('scrollend', snapScrollEndHandler);
  snapScrollHandler = ()=>{
    if(snapVisibilityRaf) return;
    snapVisibilityRaf = requestAnimationFrame(()=>{
      snapVisibilityRaf = null;
      updateSnapVisibility(main, sections, currentSnapSection(main, sections));
    });
  };
  main.addEventListener('scroll', snapScrollHandler, {passive:true});
}

