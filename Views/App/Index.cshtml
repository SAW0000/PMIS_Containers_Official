let pendingAccountInfo = null;
let acctPendingChannels = { email: false, mobile: false };
let acctVerifyIntervalId = null;

async function openAccountInfoVerify(form, btn){
  const changed = [];
  if(form.email !== (CURRENT_USER.email || '')) changed.push('البريد الإلكتروني');
  if(form.mobile !== (CURRENT_USER.mobile || '')) changed.push('رقم الجوال');

  const originalHtml = btn ? btn.innerHTML : null;
  if(btn){
    btn.disabled = true;
    btn.innerHTML = `${SPIN_RING}جارٍ الإرسال...`;
  }

  try{
    const res = await fetch('/app/account-settings/send-verification', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ email: form.email, mobile: form.mobile })
    });
    const data = await res.json().catch(()=>({}));

    if(!res.ok){
      showToast(data.message || 'توجد مشكلة في عملية التحقق', 'warning');
      return;
    }

    pendingAccountInfo = form;
    acctPendingChannels = { email: !!data.emailCodeSent, mobile: !!data.mobileCodeSent };
    document.getElementById('acctOtpEmailBlock').style.display = acctPendingChannels.email ? '' : 'none';
    document.getElementById('acctOtpMobileBlock').style.display = acctPendingChannels.mobile ? '' : 'none';

    document.getElementById('acctVerifyDesc').textContent =
      `لتأكيد تغيير ${changed.join(' و')}، أدخل رمز التحقق المرسل إلى ${changed.length > 1 ? 'بريدك الإلكتروني وجوالك' : (acctPendingChannels.email ? 'بريدك الإلكتروني' : 'جوالك')}.`;

    resetAccountVerifyPanel();
    document.getElementById('acctVerifyModal').classList.add('open');
    startAccountVerifyTimer(OTP_RESEND_COOLDOWN_SECONDS);

    const focusGroup = acctPendingChannels.email ? 'acctOtpEmailGroup' : 'acctOtpMobileGroup';
    const inputs = document.querySelectorAll(`#${focusGroup} input`);
    inputs[inputs.length - 1].focus();
  } catch(err){
    showToast('توجد مشكلة في عملية التحقق', 'warning');
  } finally {
    if(btn){
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  }
}

function closeAccountInfoVerify(){
  stopAccountVerifyTimer();
  document.getElementById('acctVerifyModal').classList.remove('open');
  pendingAccountInfo = null;
  acctPendingChannels = { email: false, mobile: false };
}

function resetAccountVerifyPanel(){
  const status = document.getElementById('acctVerifyStatusMsg');
  status.textContent = 'لم يصلك الرمز؟';
  status.classList.remove('err');
  document.querySelectorAll('#acctVerifyModal .otp-inputs input').forEach(inp=>{
    inp.value = '';
    inp.classList.remove('filled');
  });
  document.querySelectorAll('#acctVerifyModal .otp-inputs').forEach(g=>g.classList.remove('shake'));
}

function stopAccountVerifyTimer(){
  if(acctVerifyIntervalId){
    clearInterval(acctVerifyIntervalId);
    acctVerifyIntervalId = null;
  }
}

function startAccountVerifyTimer(seconds){
  stopAccountVerifyTimer();
  let remaining = seconds || OTP_RESEND_COOLDOWN_SECONDS;
  const resendBtn = document.getElementById('acctVerifyResendBtn');
  resendBtn.disabled = true;
  resendBtn.innerHTML = 'إعادة الإرسال خلال <span class="timer" id="acctVerifyResendTimer">00:00</span>';

  const render = ()=>{
    const el = document.getElementById('acctVerifyResendTimer');
    if(!el) return;
    const m = String(Math.floor(remaining / 60)).padStart(2, '0');
    const s = String(remaining % 60).padStart(2, '0');
    el.textContent = `${m}:${s}`;
  };
  render();

  acctVerifyIntervalId = setInterval(()=>{
    remaining--;
    if(remaining <= 0){
      stopAccountVerifyTimer();
      resendBtn.disabled = false;
      resendBtn.innerHTML = 'إعادة الإرسال';
      return;
    }
    render();
  }, 1000);
}

async function resendAccountInfoCodes(){
  const resendBtn = document.getElementById('acctVerifyResendBtn');
  if(resendBtn.disabled) return;
  const form = pendingAccountInfo;
  if(!form) return;

  const originalHtml = resendBtn.innerHTML;
  resendBtn.disabled = true;

  try{
    const res = await fetch('/app/account-settings/resend-verification', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ email: form.email, mobile: form.mobile })
    });
    const data = await res.json().catch(()=>({}));

    if(!res.ok){
      showToast(data.message || 'توجد مشكلة في عملية التحقق', 'warning');
      resendBtn.disabled = false;
      resendBtn.innerHTML = originalHtml;
      return;
    }

    startAccountVerifyTimer(OTP_RESEND_COOLDOWN_SECONDS);
    showToast(acctPendingChannels.email && acctPendingChannels.mobile
      ? 'تم إرسال رمزين جديدين إلى بريدك وجوالك'
      : 'تم إرسال رمز جديد');
  } catch(err){
