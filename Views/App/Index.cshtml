  if(!btn) { fn(); return; }
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}${label||'جارٍ المعالجة...'}`;
  setTimeout(fn, delay||650);
}

function showCardLoading(bodyId, label){
  const body = document.getElementById(bodyId);
  if(!body) return;
  body.classList.add('card-loading-host');
  let overlay = body.querySelector(':scope > .card-loading-overlay');
  if(!overlay){
    overlay = document.createElement('div');
    overlay.className = 'card-loading-overlay';
    overlay.innerHTML = `${SPIN_RING}<span></span>`;
    body.appendChild(overlay);
  }
  overlay.querySelector('span').textContent = label || 'جاري التحديث ...';
  overlay.hidden = false;
}
function hideCardLoading(bodyId){
  const overlay = document.querySelector(`#${CSS.escape(bodyId)} > .card-loading-overlay`);
  if(overlay) overlay.hidden = true;
}
