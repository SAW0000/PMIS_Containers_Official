let pendingPhotoRemoval = false;

function previewAccountPhoto(input){
  const file = input.files && input.files[0];
  if(!file) return;

  const extension = (file.name.split('.').pop() || '').toUpperCase();
  if(!ALLOWED_PROFILE_PHOTO_EXTENSIONS.includes(extension)){
    input.value = '';
    showToast(`نوع الملف غير مدعوم — الأنواع المسموحة: ${ALLOWED_PROFILE_PHOTO_EXTENSIONS.join('، ')}`, 'warning');
    return;
  }

  pendingPhotoRemoval = false;

  const reader = new FileReader();
  reader.onload = (e)=>{
    const el = document.getElementById('acctAvatar');
    if(!el) return;
    const img = document.createElement('img');
    img.className = 'avatar-photo';
    img.alt = '';
    img.src = e.target.result;
    el.replaceChildren(img);
  };
  reader.readAsDataURL(file);
}

