const paginationBtnCache = new WeakMap();
function renderPagination(containerId, totalItems, page, onPageChange, pageSize, clickedBtn, alwaysShow){
  const container = document.getElementById(containerId);
  const totalPages = Math.max(1, Math.ceil(totalItems / (pageSize || PAGE_SIZE)));
  if(totalPages<=1 && !alwaysShow){ container.innerHTML=''; paginationBtnCache.delete(container); return; }

  let btns = paginationBtnCache.get(container);
  if(!btns){
    container.innerHTML = `
      <button class="page-btn" data-role="first" title="الصفحة الأولى">${ICONS.chevronsRight}</button>
      <button class="page-btn" data-role="prev">${ICONS.chevronRight}</button>
      <button class="page-btn active" data-role="current"></button>
      <button class="page-btn" data-role="next">${ICONS.chevronLeft}</button>
      <button class="page-btn" data-role="last" title="الصفحة الأخيرة">${ICONS.chevronsLeft}</button>
    `;
    btns = {
      first: container.querySelector('[data-role="first"]'),
      prev:  container.querySelector('[data-role="prev"]'),
      current: container.querySelector('[data-role="current"]'),
      next:  container.querySelector('[data-role="next"]'),
      last:  container.querySelector('[data-role="last"]'),
    };
    paginationBtnCache.set(container, btns);
  }

  btns.current.textContent = page;
  btns.first.disabled = btns.prev.disabled = page<=1;
  btns.next.disabled = btns.last.disabled = page>=totalPages;
  btns.first.onclick = ()=>onPageChange(1, btns.first);
  btns.prev.onclick  = ()=>onPageChange(page-1, btns.prev);
  btns.next.onclick  = ()=>onPageChange(page+1, btns.next);
  btns.last.onclick  = ()=>onPageChange(totalPages, btns.last);

  if(clickedBtn) replaySvgAnimations(clickedBtn);
}

const carouselScrollHandlers = {};
const carouselResizeHandlers = {};
const carouselDragHandlers = {};
const CAROUSEL_ROW_INSET = 20;
const CAROUSEL_MAX_CARD_WIDTH = 480;
function sizeCarouselRows(tbody, rows){
  if(getComputedStyle(tbody).display !== 'flex'){
    rows.forEach(row=>{ row.style.width = ''; row.style.removeProperty('--carousel-inset'); });
    return;
  }
  const w = tbody.clientWidth;
  const inset = Math.max(CAROUSEL_ROW_INSET, (w - CAROUSEL_MAX_CARD_WIDTH) / 2);
  rows.forEach(row=>{
    row.style.width = w+'px';
    row.style.setProperty('--carousel-inset', inset+'px');
  });
}
function initRowVerticalScrollShadow(rows){
  rows.forEach(row=>{
    const sync = ()=>{
      const atEnd = row.scrollHeight - row.scrollTop - row.clientHeight <= 4;
      row.classList.toggle('at-scroll-end', atEnd);
    };
    sync();
    row.addEventListener('scroll', sync, {passive:true});
  });
}
function initCardCarousel(tbodyId, dotsId, itemSelector){
  itemSelector = itemSelector || 'tr';
  const tbody = document.getElementById(tbodyId);
  const dots = document.getElementById(dotsId);
  if(!tbody || !dots) return;

  if(carouselScrollHandlers[tbodyId]){
    tbody.removeEventListener('scroll', carouselScrollHandlers[tbodyId]);
    delete carouselScrollHandlers[tbodyId];
  }
  if(carouselResizeHandlers[tbodyId]){
    window.removeEventListener('resize', carouselResizeHandlers[tbodyId]);
    delete carouselResizeHandlers[tbodyId];
  }
  if(carouselDragHandlers[tbodyId]){
    carouselDragHandlers[tbodyId]();
    delete carouselDragHandlers[tbodyId];
  }

  const rows = Array.from(tbody.querySelectorAll(itemSelector)).filter(el=>!el.querySelector('td[colspan]'));
  if(rows.length<2){
    requestAnimationFrame(()=>sizeCarouselRows(tbody, rows));
    initRowVerticalScrollShadow(rows);
    dots.innerHTML='';
    return;
  }

  requestAnimationFrame(()=>{
    sizeCarouselRows(tbody, rows);
    if(rows[0]) tbody.scrollLeft = 0;
  });
  let resizeTimer = null;
  const resizeHandler = ()=>{ clearTimeout(resizeTimer); resizeTimer = setTimeout(()=>sizeCarouselRows(tbody, rows), 150); };
  window.addEventListener('resize', resizeHandler);
  carouselResizeHandlers[tbodyId] = resizeHandler;

  initRowVerticalScrollShadow(rows);

  dots.innerHTML = rows.map((_,i)=>`<button type="button" class="carousel-dot${i===0?' active':''}" aria-label="${i+1}"></button>`).join('');
  const dotEls = Array.from(dots.children);
  dotEls.forEach((dot,i)=>{
    dot.onclick = ()=>{
      const rowRect = rows[i].getBoundingClientRect();
      const tbodyRect = tbody.getBoundingClientRect();
      tbody.scrollBy({ left: rowRect.left - tbodyRect.left, behavior: 'smooth' });
    };
  });

  const syncActiveDot = ()=>{
    const mid = tbody.getBoundingClientRect().left + tbody.clientWidth/2;
    let closest = 0, closestDist = Infinity;
    rows.forEach((row,i)=>{
      const r = row.getBoundingClientRect();
      const dist = Math.abs((r.left+r.right)/2 - mid);
      if(dist<closestDist){ closestDist = dist; closest = i; }
    });
    dotEls.forEach((dot,i)=>dot.classList.toggle('active', i===closest));
  };
  let raf = null;
  const handler = ()=>{
    if(raf) return;
    raf = requestAnimationFrame(()=>{ raf = null; syncActiveDot(); });
  };
  tbody.addEventListener('scroll', handler, {passive:true});
  carouselScrollHandlers[tbodyId] = handler;

  const DRAG_CLICK_THRESHOLD = 6;
  let dragging = false, dragMoved = false, dragStartX = 0, dragStartScroll = 0;
  const onMouseDown = (e)=>{
    dragging = true; dragMoved = false;
    dragStartX = e.pageX;
    dragStartScroll = tbody.scrollLeft;
  };
  const onMouseMove = (e)=>{
    if(!dragging) return;
    const delta = e.pageX - dragStartX;
    if(Math.abs(delta) > DRAG_CLICK_THRESHOLD) dragMoved = true;
    if(dragMoved){
      e.preventDefault();
      tbody.scrollLeft = dragStartScroll - delta;
    }
  };
  const endDrag = ()=>{
    dragging = false;
    if(dragMoved) setTimeout(()=>{ dragMoved = false; }, 0);
  };
  const onClickCapture = (e)=>{ if(dragMoved){ e.preventDefault(); e.stopPropagation(); } };
  tbody.addEventListener('mousedown', onMouseDown);
  window.addEventListener('mousemove', onMouseMove);
  window.addEventListener('mouseup', endDrag);
  tbody.addEventListener('mouseleave', endDrag);
  tbody.addEventListener('click', onClickCapture, true);
  carouselDragHandlers[tbodyId] = ()=>{
    tbody.removeEventListener('mousedown', onMouseDown);
    window.removeEventListener('mousemove', onMouseMove);
    window.removeEventListener('mouseup', endDrag);
    tbody.removeEventListener('mouseleave', endDrag);
    tbody.removeEventListener('click', onClickCapture, true);
  };
}
function shrinkAttachNames(){
  const names = document.querySelectorAll('#detAttachments .upload-name');
  if(!names.length) return;
  requestAnimationFrame(()=>{
    names.forEach(el=>{
      el.style.fontSize = '';
      let size = parseFloat(getComputedStyle(el).fontSize);
      let guard = 0;
      while(el.scrollWidth > el.clientWidth && size > 8 && guard < 12){
        size -= 0.5;
        el.style.fontSize = size + 'px';
        guard++;
      }
    });
  });
}
