function getAccountOtpValue(groupId){
  return [...document.querySelectorAll(`#${groupId} input`)].map(inp=>inp.value).join('');
}

async function confirmAccountInfoVerification(btn){
  const status = document.getElementById('acctVerifyStatusMsg');

  const emailCode = acctPendingChannels.email ? getAccountOtpValue('acctOtpEmailGroup') : '';
  const mobileCode = acctPendingChannels.mobile ? getAccountOtpValue('acctOtpMobileGroup') : '';

  const emailIncomplete = acctPendingChannels.email && emailCode.length < 6;
  const mobileIncomplete = acctPendingChannels.mobile && mobileCode.length < 6;
  if(emailIncomplete || mobileIncomplete){
    status.textContent = acctPendingChannels.email && acctPendingChannels.mobile
      ? 'يرجى إدخال الرمزين المكونين من 6 أرقام كاملين'
      : 'يرجى إدخال الرمز المكون من 6 أرقام كاملاً';
    status.classList.add('err');
    document.querySelectorAll('#acctVerifyModal .otp-inputs').forEach(g=>{
      g.classList.remove('shake');
      void g.offsetWidth;            
      g.classList.add('shake');
    });
    return;
  }

  const form = pendingAccountInfo;
  if(!form){
    closeAccountInfoVerify();
    return;
  }
  form.emailCode = emailCode;
  form.mobileCode = mobileCode;

  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ الحفظ...`;
  try{
    const saved = await submitAccountInfo(form, null);
    if(saved) closeAccountInfoVerify();
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}

document.querySelectorAll('#acctVerifyModal .otp-inputs').forEach(group=>{
  const inputs = [...group.querySelectorAll('input')];
  inputs.forEach((inp, i)=>{
    inp.addEventListener('input', ()=>{
      inp.value = inp.value.replace(/[^0-9]/g, '').slice(0, 1);
      inp.classList.toggle('filled', inp.value.length > 0);
      if(inp.value && inputs[i - 1]) inputs[i - 1].focus();
    });
    inp.addEventListener('keydown', e=>{
      if(e.key === 'Backspace' && !inp.value && inputs[i + 1]) inputs[i + 1].focus();
      if(e.key === 'Enter'){
        e.preventDefault();
        confirmAccountInfoVerification(document.getElementById('acctVerifyConfirmBtn'));
      } else if(e.key === 'Tab' && !e.shiftKey){
        e.preventDefault();
        if(inputs[i - 1]) inputs[i - 1].focus();
      } else if(e.key === 'Tab' && e.shiftKey){
        e.preventDefault();
        if(inputs[i + 1]) inputs[i + 1].focus();
      }
    });
  });
});

async function renderAccountSettings(){
  fillAccountInfoFields();
  renderCurrentUserAvatar(document.getElementById('acctAvatar'));
  document.getElementById('acctPhotoInput').value = '';
  pendingPhotoRemoval = false;

  notifPrefs = NOTIF_PREFS_BY_ROLE[currentRole] || NOTIF_PREFS_BY_ROLE.beneficiary;
  const body = document.getElementById('notifPrefsBody');
  body.innerHTML = notifPrefs.map(p=>`
    <div class="toggle-row">
      <div class="t-lbl"><b>${p.label}</b></div>
      <label class="switch">
        <input type="checkbox" data-pref-key="${p.key}" checked disabled>
        <span class="track"></span>
      </label>
    </div>
  `).join('');

  let stored = null;
  try{
    const res = await fetch('/app/account-settings/notification-preferences');
    if(res.ok) stored = await res.json();
  } catch(err){  }

  if(stored === null){
    showToast('تعذر جلب إعدادات الإشعارات', 'warning');
  }
  const stateByKey = {};
  (stored || []).forEach(p => { stateByKey[p.key] = p.isEnabled; });

  body.querySelectorAll('input[data-pref-key]').forEach(input => {
    const key = input.getAttribute('data-pref-key');
    input.checked = stateByKey[key] !== false;
    input.disabled = false;
    input.onchange = () => saveNotificationPreference(key, input.checked, input);
  });
}
async function saveNotificationPreference(key, isEnabled, input){
  input.disabled = true;
  try{
    const res = await fetch('/app/account-settings/notification-preferences', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ preferences: [{ key: key, isEnabled: isEnabled }] })
    });
    if(!res.ok){
      const data = await res.json().catch(()=>({}));
      input.checked = !isEnabled;
      showToast(data.message || 'تعذر حفظ إعداد الإشعار', 'warning');
    }
  } catch(err){
    input.checked = !isEnabled;
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    input.disabled = false;
  }
}
