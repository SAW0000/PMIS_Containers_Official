async function refreshWizTargetSystems(){
  const res = await fetch('/app/target-systems');
  if(!res.ok) return;
  const all = await res.json();
  TARGET_SYSTEMS = all.filter(s => s.isActive).map(s => ({ id:s.id, systemName:s.systemName }));
}

function sysSummaryText(){
  const activeCount = ADMIN_TARGET_SYSTEMS.filter(s => s.isActive).length;
  const total = ADMIN_TARGET_SYSTEMS.length;
  return `<span style="unicode-bidi:isolate;">${activeCount}</span> من <span style="unicode-bidi:isolate;">${total}</span>`;
}

function renderSystemsPopover(){
  const pop = document.getElementById('sysPopover');
  const summary = document.getElementById('sysSummary');
  if(!pop) return;
  if(summary){
    summary.classList.add('ext-summary-rtl');
    summary.innerHTML = sysSummaryText();
  }

  pop.innerHTML = `<div class="sys-opt-list">` + ADMIN_TARGET_SYSTEMS.map(s => `
    <div class="sys-opt">
      <label class="ext-opt">
        <input type="checkbox" data-id="${escapeAttr(s.id)}"${s.isActive ? ' checked' : ''} onchange="toggleTargetSystemActive('${escapeAttr(s.id)}', this.checked)">
        <span class="box">${CHECK_TINY_SVG}</span>
        <span class="mono">${escapeHtml(s.systemName)}</span>
      </label>
      <button type="button" class="reason-icon-btn reason-icon-danger" title="حذف النظام"
              aria-label="حذف النظام" onclick="deleteTargetSystem('${escapeAttr(s.id)}')">${ICONS.reasonDelete}</button>
    </div>`).join('') + `</div>`
    + `<div class="sys-add-row">
        <input type="text" class="sys-add-input" id="sysAddInput" placeholder="اضف نظام جديد" maxlength="200"
               oninput="syncSysAddIcon()" onfocus="syncSysAddIcon()" onblur="syncSysAddIcon()"
               onkeydown="if(event.key==='Enter'){ event.preventDefault(); submitNewTargetSystem(); }">
        <button type="button" class="sys-add-send" id="sysAddSend" hidden
                title="إضافة" aria-label="إضافة" onclick="submitNewTargetSystem()">
          <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M0 0h24v24H0z" fill="none"/>
            <path fill="currentColor" fill-rule="evenodd" d="M3.402 6.673c-.26-2.334 2.143-4.048 4.266-3.042l11.944 5.658c2.288 1.083 2.288 4.339 0 5.422L7.668 20.37c-2.123 1.006-4.525-.708-4.266-3.042L3.882 13H12a1 1 0 1 0 0-2H3.883z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>`;
}

function syncSysAddIcon(){
  const input = document.getElementById('sysAddInput');
  const send = document.getElementById('sysAddSend');
  if(!input || !send) return;
  send.hidden = document.activeElement !== input && input.value.trim() === '';
}

async function toggleTargetSystemActive(id, isActive){
  const res = await fetch(`/app/target-systems/${encodeURIComponent(id)}/active`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
    body: JSON.stringify({ isActive })
  });
  const data = await res.json().catch(()=>({}));
  if(!res.ok){
    showToast(data.message || 'تعذر تحديث النظام', 'warning');
    renderSystemsPopover();  
    return;
  }
  const system = ADMIN_TARGET_SYSTEMS.find(s => s.id === id);
  if(system) system.isActive = isActive;
  renderSystemsPopover();
  await refreshWizTargetSystems();
}

async function submitNewTargetSystem(){
  const input = document.getElementById('sysAddInput');
  const name = input?.value.trim();
  if(!name) return;

  const send = document.getElementById('sysAddSend');
  if(send) send.disabled = true;

  const res = await fetch('/app/target-systems', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
    body: JSON.stringify({ systemName: name })
  });
  const data = await res.json().catch(()=>({}));
  if(!res.ok){
    showToast(data.message || 'تعذر إضافة النظام', 'warning');
    if(send) send.disabled = false;
    return;
  }
  ADMIN_TARGET_SYSTEMS.push(data);
  renderSystemsPopover();
  document.getElementById('sysAddInput')?.focus();
  await refreshWizTargetSystems();
}

async function deleteTargetSystem(id){
  const system = ADMIN_TARGET_SYSTEMS.find(s => s.id === id);
  const confirmed = await confirmDialog(
    `سيتم حذف "${system ? system.systemName : 'هذا النظام'}" نهائيًا من القائمة. الطلبات المرتبطة به سابقًا لن تتأثر.`,
    'حذف النظام؟'
  );
  if(!confirmed) return;

  const res = await fetch(`/app/target-systems/${encodeURIComponent(id)}`, {
    method: 'DELETE',
    headers: { 'X-CSRF-TOKEN': csrfToken() }
  });
  const data = await res.json().catch(()=>({}));
  if(!res.ok){
    showToast(data.message || 'تعذر حذف النظام', 'warning');
    return;
  }
  ADMIN_TARGET_SYSTEMS = ADMIN_TARGET_SYSTEMS.filter(s => s.id !== id);
  renderSystemsPopover();
  await refreshWizTargetSystems();
}

