let dashboardSummaryFetchToken = 0;
async function fetchDashboardSummary({period, actionPage, actionPageSize, licensesPage, licensesPageSize, activityPage, activityPageSize}){
  const myToken = ++dashboardSummaryFetchToken;
  const params = new URLSearchParams({
    period, actionPage, actionPageSize, licensesPage, licensesPageSize, activityPage, activityPageSize
  });
  let data = null;
  try{
    const res = await fetch(`/app/dashboard/summary?${params.toString()}`);
    if(res.ok) data = await res.json();
  } catch(err){
  }
  return { data, isStale: myToken !== dashboardSummaryFetchToken };
}
function renderBenStatsFromDto(stats){
  const cells = [
