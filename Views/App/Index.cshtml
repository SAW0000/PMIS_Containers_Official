function renderDetTimeline(r){
  const events = (r.history||[]).slice();
  if(r.status==='submitted' || r.status==='returned' || r.status==='awaiting_payment' || r.status==='approved'){
    const pendingLabel = r.status==='approved' ? 'بانتظار التفعيل' : (r.status==='awaiting_payment' ? 'بانتظار تأكيد وصول السداد' : 'بانتظار المراجعة / الاعتماد');
    events.push([pendingLabel, null]); 
  }
  events.reverse();
  const pageSize = detTimelinePageSize();
  const totalTimelinePages = Math.max(1, Math.ceil(events.length / pageSize));
  if(detTimelinePage>totalTimelinePages) detTimelinePage = totalTimelinePages;
  const timelinePage = events.slice((detTimelinePage-1)*pageSize, detTimelinePage*pageSize);
  renderPagination('detTimelinePagination', events.length, detTimelinePage, goDetTimelinePage, pageSize, undefined, true);
  document.getElementById('detTimeline').innerHTML = timelinePage.length ? timelinePage.map(h=>{
    if(h[1]===null){
      return `<div class="tl-item pending"><div class="tl-dot">${ICONS.alertCircleLoop}</div><div class="tl-content"><div class="ttl" style="color:var(--text-faint)">${h[0]}</div></div></div>`;
    }
    const isRejected = h[0].includes('رفض');
    return `<div class="tl-item ${isRejected?'rejected':''}">
      <div class="tl-dot">${isRejected?closeCircleIcon(26,26):confirmCircleIcon(26,26)}</div>
      <div class="tl-content"><div class="ttl">${h[0]}</div><div class="meta">${fmtDate(h[1])}</div></div>
    </div>`;
  }).join('') : `<div class="empty-state">${ICONS.activityEmpty()}<div>لا يوجد سجل بعد</div></div>`;
}

function syncDetTimelineHeight(){
  const body = document.getElementById('detTimelineBody');
  if(!body) return;
  if(window.matchMedia(SNAP_BREAKPOINT).matches){
    body.style.height = '';
    return;
  }
  const timelineEl = document.getElementById('detTimeline');
  if(timelineEl && timelineEl.querySelector(':scope > .empty-state:only-child')){
    body.style.height = '';
    return;
  }
  const summaryCard = document.getElementById('detSummaryCard');
  const timelineCard = document.getElementById('detTimelineCard');
  const timelineHead = timelineCard ? timelineCard.querySelector('.card-head') : null;
  if(!summaryCard || !timelineCard || !timelineHead) return;
  const targetCardH = summaryCard.offsetHeight;
  if(targetCardH<=0) return;
  body.style.height = Math.max(0, targetCardH - timelineHead.offsetHeight) + 'px';
}

function buildActionsHtml(r){
  let html = '';
  if(currentRole==='beneficiary'){
    const cancellable = ['submitted','returned','awaiting_payment','approved'].includes(r.status);
    if(r.status==='draft'){
      html += actionBtn('primary','إكمال الطلب','send',()=>resumeDraft(r.requestId, r.id));
      html += actionBtn('outline','حذف المسودة','reject',()=>cancelDraft(r.requestId), true);
    } else if(r.status==='returned'){
      html += actionBtn('primary','تعديل الطلب وإعادة الإرسال','send',()=>resumeReturnedRequest(r.requestId, r.id));
    }
    if(cancellable){
      html += actionBtn('outline','إلغاء الطلب','reject',()=>cancelRequest(r.requestId), true);
    }
    if(!cancellable && r.status!=='draft' && r.status!=='returned'){
      html += `<div class="empty-state" style="padding:20px;">${ICONS.actionsUnavailable()}<div>لا يوجد إجراء متاح حاليًا لهذه الحالة</div></div>`;
    }
  } else if(currentRole==='o3p'){
    if(r.status==='submitted'){
      html += actionBtn('success','<span class="btn-label-desktop">اعتماد الطلب ومتابعة إجراءات السداد</span><span class="btn-label-handheld">اعتماد الطلب</span>','check',()=>callRequestAction(r.id,'approve','تم اعتماد الطلب — بانتظار تأكيد السداد'), false, true);
      html += actionBtn('warning','<span class="btn-label-desktop">إعادة للمستفيد لاستكمال البيانات</span><span class="btn-label-handheld">إعادة للمستفيد</span>','back',()=>openActionModal('return', r.id), true, true);
      html += actionBtn('danger','رفض الطلب','reject',()=>openActionModal('reject', r.id), true, true);
    } else if(r.status==='awaiting_payment'){
      html += `<p style="font-size:13px;color:var(--text-mid);margin:0 0 12px;">تم اعتماد الطلب. عند التحقق الفعلي من وصول المبلغ إلى حساب الأمانة، أكّد السداد وسجّل تاريخه — وهو التاريخ المرجعي لبدء إجراءات التفعيل.</p>`;
