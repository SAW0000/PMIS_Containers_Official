let detAttachmentsCache = { requestId: null, items: null };
async function renderDetAttachments(r){
  const container = document.getElementById('detAttachments');
  const openBtn = document.getElementById('detAttachOpenBtn');
  if(openBtn && !openBtn.querySelector('svg')){
    openBtn.insertAdjacentHTML('afterbegin', ICONS.chevronLeft);
  }
  if(detAttachmentsCache.requestId !== r.requestId){
    container.innerHTML = `<div class="empty-state" style="padding:20px;">جارٍ التحميل...</div>`;
    document.getElementById('detAttachPagination').innerHTML = '';
    try{
      const res = await fetch(`/app/requests/${encodeURIComponent(r.requestId)}/attachments`);
      detAttachmentsCache = { requestId: r.requestId, items: res.ok ? await res.json() : [] };
    } catch(err){
      detAttachmentsCache = { requestId: r.requestId, items: [] };
    }
    if(currentDetailId !== r.id) return;
  }
  const items = detAttachmentsCache.items;
  const pageSize = detAttachPageSize();
  const totalAttachPages = Math.max(1, Math.ceil(items.length / pageSize));
  if(detAttachPage>totalAttachPages) detAttachPage = totalAttachPages;
  const attachPage = items.slice((detAttachPage-1)*pageSize, detAttachPage*pageSize);
  renderPagination('detAttachPagination', items.length, detAttachPage, goDetAttachPage, pageSize, undefined, true);
  if(!items.length){
    container.innerHTML = `<div class="empty-state" style="padding:20px;">${ICONS.attachEmpty()}<div>لا توجد مرفقات لهذا الطلب</div></div>`;
    return;
  }
  const sizeLabel = kb => { const k = Math.max(1, Math.round(kb/1024)); return k>=1024 ? `${(k/1024).toFixed(1)} MB` : `${k} KB`; };
  container.innerHTML = attachPage.map(a=>`
    <div class="upload-box filled" data-id="${a.id}" onclick="previewUploadedAttachment('${a.id}')" style="cursor:pointer;">
      <div class="upload-left">
        <div class="upload-ic upload-ic-bare">${ICONS.fileDoc}</div>
        <div><div class="upload-name">${ATTACHMENT_TYPE_LABELS[a.attachmentType] || a.attachmentType}</div><div class="upload-sub">${sizeLabel(a.fileSize)} · تم الرفع</div></div>
      </div>
      <span class="upload-view-btn" aria-hidden="true">${ICONS.chevronLeft}</span>
    </div>
  `).join('');
  initCardCarousel('detAttachments', 'detAttachDots', '.upload-box');
  shrinkAttachNames();
}
