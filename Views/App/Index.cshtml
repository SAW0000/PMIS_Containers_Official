function renderThemeIcon(){
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  document.getElementById('themeToggle').innerHTML = isDark ? ICON_THEME_DARK : iconThemeDay('Topbar');
  const ctxLabel = document.getElementById('ctxThemeLabel');
  if(ctxLabel) ctxLabel.textContent = isDark ? 'التبديل إلى المظهر الفاتح' : 'التبديل إلى المظهر الداكن';
  const ctxIcon = document.getElementById('ctxThemeIcon');
  if(ctxIcon) ctxIcon.innerHTML = isDark ? ICON_THEME_DARK_STATIC : ICON_THEME_DAY_STATIC;
  renderMenuThemeIcon();
  renderCtxBrandIcon();
  renderBtnDraftIcon();
}
function renderCtxBrandIcon(){
  const isAmana = document.documentElement.getAttribute('data-brand')==='amana';
  const ctxBrandLabel = document.getElementById('ctxBrandLabel');
  if(ctxBrandLabel) ctxBrandLabel.textContent = isAmana ? 'التبديل إلى ثيم الأزرق' : 'التبديل إلى ثيم الأمانه';
  const ctxBrandIcon = document.getElementById('ctxBrandIcon');
  if(ctxBrandIcon) ctxBrandIcon.innerHTML = ICON_BRAND_STATIC;
}
function renderMenuThemeIcon(){
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  const menuLabel = document.getElementById('menuThemeLabel');
  if(menuLabel) menuLabel.textContent = isDark ? 'التبديل إلى المظهر الفاتح' : 'التبديل إلى المظهر الداكن';
  const menuIcon = document.getElementById('menuThemeIcon');
  if(menuIcon) menuIcon.innerHTML = isDark ? ICON_THEME_DARK : iconThemeDay('Menu');
}
function renderBtnDraftIcon(){
  const el = document.getElementById('btnDraftIcon');
  if(!el) return;
  el.innerHTML = ICON_SAVE_DRAFT;
}
function toggleTheme(){
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  if(isDark){ document.documentElement.removeAttribute('data-theme'); localStorage.setItem('pmis-theme','light'); }
  else{ document.documentElement.setAttribute('data-theme','dark'); localStorage.setItem('pmis-theme','dark'); }
  renderThemeIcon();
}
function toggleBrand(){
  const isAmana = document.documentElement.getAttribute('data-brand')==='amana';
  const brand = isAmana ? 'blue' : 'amana';
  if(brand==='amana') document.documentElement.setAttribute('data-brand','amana');
  else document.documentElement.removeAttribute('data-brand');
  localStorage.setItem('pmis-brand', brand);
  document.querySelectorAll('.theme-swatch-opt').forEach(opt=>{
    opt.classList.toggle('active', opt.dataset.themeChoice===(brand==='amana' ? 'amanah' : 'blue'));
  });
  renderCtxBrandIcon();
  renderMenuBrandIcon();
}
renderThemeIcon();
document.getElementById('themeToggle').addEventListener('click', toggleTheme);
document.getElementById('ctxBrandBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  toggleBrand();
  closeCtxMenu();
});
document.getElementById('ctxRefreshIcon').innerHTML = ICON_REFRESH_STATIC;
document.getElementById('profileToggle').addEventListener('click', (e)=>{
  e.stopPropagation();
  closeNotifPopover();
  closeMenuPop();
  closeCtxMenu();
  closeThemePicker();
  closeAllFilterPopovers();
  const menu = document.getElementById('profileMenu');
  const willOpen = !menu.classList.contains('open');
  menu.classList.toggle('open', willOpen);
});
document.getElementById('topbarNotifBtn').addEventListener('click', toggleNotifPopover);

function closeCtxMenu(){
  document.getElementById('ctxMenu').classList.remove('open');
}
document.addEventListener('contextmenu', (e)=>{
  e.preventDefault();
  document.getElementById('profileMenu').classList.remove('open');
  closeThemePicker();
  closeNotifPopover();
  closeMenuPop();
  closeAllFilterPopovers();
  const menu = document.getElementById('ctxMenu');
  menu.classList.add('open');
  const menuRect = menu.getBoundingClientRect();
  const x = Math.min(e.clientX, window.innerWidth - menuRect.width - 8);
  const y = Math.min(e.clientY, window.innerHeight - menuRect.height - 8);
  menu.style.left = Math.max(8, x) + 'px';
  menu.style.top = Math.max(8, y) + 'px';
  replayAllSvgAnimations(menu);
});
document.getElementById('ctxThemeBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  toggleTheme();
  closeCtxMenu();
});
document.getElementById('ctxRefreshBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  closeCtxMenu();
  openView(currentView, {preserveScroll:true});
});

document.addEventListener('click', ()=>{
  document.getElementById('profileMenu').classList.remove('open');
  closeThemePicker();
  closeNotifPopover();
  closeCtxMenu();
});

(function init(){
  renderSidebar();
  openView(NAV[currentRole][0].view);
  wireWizLiveValidation();
  const profileIcons = {profileAccountBtn:'account', profileSettingsBtn:'settings', profileLogoutBtn:'logout'};
  Object.keys(profileIcons).forEach(id=>{
    const btn = document.getElementById(id);
    btn.innerHTML = `${ICONS[profileIcons[id]]}<span>${btn.textContent}</span>`;
  });
  document.getElementById('profileThemeIcon').innerHTML = ICONS.theme;
})();
</script>
