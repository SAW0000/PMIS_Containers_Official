function sidebarSectionOf(view){
  if(NAV[currentRole].some(it=>it.view===view)) return 'القائمة الرئيسية';
  const accountItems = currentRole==='beneficiary' ? ACCOUNT_NAV.concat(BENEFICIARY_ACCOUNT_NAV_EXTRA) : ACCOUNT_NAV;
  if(accountItems.some(it=>it.view===view)) return 'حسابي';
  return null;
}

function renderTopbarPath(view){
  const el = document.getElementById('topbarPath');
  if(!el) return;
  const meta = VIEW_META[view] || {label:''};
  const parentView = view==='detail' ? detailReturnView : meta.parent;
  const hasParent = parentView && parentView!==view;
  const section = sidebarSectionOf(hasParent ? parentView : view);

  const SECTION_DEFAULT_VIEW = {
    'القائمة الرئيسية': NAV[currentRole][0].view,
    'حسابي': 'my-profile'
  };
  const segments = [];
  if(section) segments.push({label:section, view:SECTION_DEFAULT_VIEW[section]});
  if(hasParent) segments.push({label:VIEW_META[parentView]?.label || '', view:parentView});
  segments.push({label:meta.label, view});

  el.innerHTML = segments.filter(s=>s.label).map((s,i,arr)=>{
    const isLeaf = i===arr.length-1;
    const cls = isLeaf ? 'tb-path-leaf' : 'tb-path-seg';
    const label = isLeaf ? `<span class="tb-path-leaf-text">${s.label}</span>` : s.label;
    const inner = s.view
      ? `<button type="button" class="${cls} tb-path-link" onclick="openView('${s.view}')">${label}</button>`
      : `<span class="${cls}">${label}</span>`;
    return isLeaf ? inner : `${inner}<span class="tb-path-sep">${ICONS.chevronLeft}</span>`;
  }).join('');
  syncTopbarPathMarquee();
}
function syncTopbarPathMarquee(){
  const leaf = document.querySelector('.tb-path-leaf');
  const text = leaf?.querySelector('.tb-path-leaf-text');
  if(!leaf || !text) return;
  leaf.classList.remove('marquee');
  text.style.removeProperty('--marquee-dist');
  text.style.removeProperty('--marquee-dur');
  if(!window.matchMedia(SNAP_BREAKPOINT).matches) return;
  const overflow = text.scrollWidth - leaf.clientWidth;
  if(overflow <= 2) return; 
  leaf.classList.add('marquee');
  text.style.setProperty('--marquee-dist', (overflow + 14) + 'px'); 
  text.style.setProperty('--marquee-dur', Math.max(4, overflow / 28) + 's');
}
window.addEventListener('resize', ()=>{
  clearTimeout(syncTopbarPathMarquee._t);
  syncTopbarPathMarquee._t = setTimeout(syncTopbarPathMarquee, 200);
});

function fmtDate(d){
  const parts = d.split('-');
  return parts[2]+'/'+parts[1]+'/'+parts[0];
}
function fmtDateOnly(d){
  const [y,m,day] = d.split('T')[0].split('-');
  return +y+'-'+ +m+'-'+ +day;
}
function fmtDateTime(d){
  const dt = new Date(d);
  const pad = n => String(n).padStart(2,'0');
  const hours24 = dt.getHours();
  const ampm = hours24 < 12 ? 'AM' : 'PM';
  const hours12 = hours24 % 12 || 12;
  return `${dt.getFullYear()}-${pad(dt.getMonth()+1)}-${pad(dt.getDate())} - ${pad(hours12)}:${pad(dt.getMinutes())} ${ampm}`;
}
function statusBadge(status){
  const s = STATUS[status];
  return `<span class="badge" style="color:var(--brand-800)"><span class="dot"></span>${s.label}</span>`;
}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[ch]));
}

function escapeJsString(value){
  return escapeHtml(String(value ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'"));
}

function cellClip(text, html){
  return `<span class="cell-clip" title="${escapeHtml(text)}">${html||escapeHtml(text)}</span>`;
}

function navItemsHtml(items){
  const hasUnread = notifPopoverUnread.length > 0;
  return items.map(it=>{
    let count = '';
    if(it.countKey==='notif') count = notifPopoverUnread.length;
    if(it.countKey==='review') count = submittedCount;
    const icon = it.icon==='bell' ? `<span class="sidebar-notif-icon"></span>` : ICONS[it.icon];
    return `<button type="button" class="nav-item" data-view="${it.view}" onclick="${it.action||`openView('${it.view}')`}">
      ${icon}<span class="nav-label">${it.label}</span>${count>0?`<span class="count">${count}</span>`:''}
    </button>`;
  }).join('');
}
