function positionThemePickerPopover(isHandheld){
  const pop = document.getElementById('themePickerPopover');
  if(isHandheld){
    const topbarH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--topbar-h')) || 56;
    pop.style.top = (topbarH + 8) + 'px';
    pop.style.left = '12px';
    return;
  }
  const btn = document.getElementById('profileThemeBtn');
  const r = btn.getBoundingClientRect();
  const popW = pop.offsetWidth || 240;
  const left = Math.min(r.right + 8, window.innerWidth - popW - 12);
  pop.style.left = Math.max(12, left) + 'px';
  pop.style.top = r.top + 'px';
}
