let reasonOptions = JSON.parse(document.getElementById('rejection-reasons-data').textContent);
const REASON_LABELS = new Proxy({}, { get:(_, key)=>{ const opt = reasonOptions.find(o=>o.id===key); return opt ? opt.label : key; } });
async function refreshReasonOptions(){
  const res = await fetch('/app/rejection-reasons');
  if(!res.ok) return;
  reasonOptions = await res.json();
}
function truncateReasonText(text, max){
  if(!text || text.length<=max) return text||'';
  return text.slice(0, max).trimEnd() + '…';
}
function escapeAttr(text){ return escapeHtml(text); }
function reasonOptionHtml(o){
  const previewSource = o.hint || o.defaultNote || '';
  const preview = truncateReasonText(previewSource, 60);
  const labelTitleAttr = o.label.length>40 ? ` title="${escapeAttr(o.label)}"` : '';
  const previewTitleAttr = previewSource && previewSource!==preview ? ` title="${escapeAttr(previewSource)}"` : '';
  return `<div class="reason-opt" data-value="${escapeAttr(o.id)}" onclick="pickReason(this)"><span class="swatch"></span><span class="lbl"><b${labelTitleAttr}>${escapeHtml(o.label)}</b><small${previewTitleAttr}>${escapeHtml(preview)}</small></span><span class="reason-opt-actions"><button type="button" class="reason-icon-btn" title="تعديل السبب" aria-label="تعديل السبب" onclick="event.stopPropagation();openEditReasonForm('${escapeAttr(o.id)}')">${ICONS.reasonEdit}</button><button type="button" class="reason-icon-btn reason-icon-danger" title="حذف السبب" aria-label="حذف السبب" onclick="event.stopPropagation();deleteReasonOption('${escapeAttr(o.id)}')">${ICONS.reasonDelete}</button></span></div>`;
}
function renderReasonPanel(){
  const panel = document.getElementById('modalReasonPanel');
  panel.innerHTML = reasonOptions.map(reasonOptionHtml).join('')
    + `<div class="reason-divider"></div>`
    + `<button type="button" class="reason-opt reason-opt-add" onclick="openAddReasonForm()"><span class="swatch swatch-add"></span><span class="lbl"><b>أضف سبب رفض جديد</b><small>يضاف إلى قائمة الأسباب الشائعة</small></span></button>`;
}
function toggleReasonPanel(){
  const panel = document.getElementById('modalReasonPanel');
  const open = panel.classList.toggle('open');
  document.getElementById('modalReasonTrigger').classList.toggle('open', open);
  if(open){
    const modalEl = panel.closest('.modal');
    const spaceBelow = modalEl.getBoundingClientRect().bottom - panel.getBoundingClientRect().top;
    panel.style.maxHeight = Math.min(260, Math.max(120, spaceBelow - 16)) + 'px';
  }
}
function closeReasonPanel(){
