function renderStatusBarChart(containerId, statusCounts){
  const barColor = 'var(--brand-800)';
  const byKey = Object.fromEntries(statusCounts.map(c=>[c.statusKey, c.count]));
  const counts = Object.keys(STATUS).map(k=>({key:k, label:STATUS[k].label, count: byKey[k]||0, color: barColor}));
  const maxCount = Math.max(1, ...counts.map(c=>c.count));
  const maxTrackHeight = 130; 
  const container = document.getElementById(containerId);
  container.innerHTML = `<div class="status-bar-chart" id="${containerId}Chart"></div>`;
  const chartEl = document.getElementById(containerId+'Chart');
  chartEl.innerHTML = counts.map(c=>{
    const trackH = Math.max(26, Math.round((c.count / maxCount) * maxTrackHeight));
    return `<div class="status-bar-col">
      <div class="status-bar-value">${c.count}</div>
      <div class="status-bar-track" data-len="${trackH}" style="--track-len:0px;background:color-mix(in srgb, ${c.color} 32%, transparent);">
