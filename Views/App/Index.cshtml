}

function readAccountInfoForm(){
  return {
    email:  document.getElementById('acctEmail').value.trim(),
    mobile: document.getElementById('acctMobile').value.trim()
  };
}

function validateAccountInfo(form){
  if(!form.email || !form.mobile){
    return 'جميع الحقول مطلوبة';
  }
  if(!WIZ_EMAIL_REGEX.test(form.email)){
    return 'صيغة البريد الإلكتروني غير صحيحة';
  }
  if(!WIZ_MOBILE_REGEX.test(form.mobile)){
    return 'رقم الجوال غير صحيح — يجب أن يبدأ بـ 05 ويتكون من 10 أرقام';
  }
  return null;
}

function buildAccountInfoFormData(form){
  const data = new FormData();
  data.append('email', form.email);
  data.append('mobile', form.mobile);
  if(form.emailCode) data.append('emailCode', form.emailCode);
  if(form.mobileCode) data.append('mobileCode', form.mobileCode);
  const photoInput = document.getElementById('acctPhotoInput');
  if(photoInput.files && photoInput.files[0]){
    data.append('photo', photoInput.files[0]);
  } else if(pendingPhotoRemoval){
    data.append('removePhoto', 'true');
  }
  return data;
}

async function saveAccountInfo(btn){
  const form = readAccountInfoForm();
  const error = validateAccountInfo(form);
  if(error){
    showToast(error, 'warning');
    return;
  }

  const contactChanged = form.email !== (CURRENT_USER.email || '')
                      || form.mobile !== (CURRENT_USER.mobile || '');

  if(contactChanged){
    await openAccountInfoVerify(form, btn);
    return;
  }

  await submitAccountInfo(form, btn);
}

async function submitAccountInfo(form, btn){
  const isHandheld = window.matchMedia(SNAP_BREAKPOINT).matches;
  const originalHtml = btn ? btn.innerHTML : null;
  let dismissLoadingToast = null;
  if(btn){
    btn.disabled = true;
    if(isHandheld){
      dismissLoadingToast = showToast('جارٍ الحفظ...', 'loading');
      btn.innerHTML = SPIN_RING;
    } else {
      btn.innerHTML = `${SPIN_RING}جارٍ الحفظ...`;
    }
  }

  try{
    const res = await fetch('/app/account-settings/info', {
      method: 'POST',
      headers: { 'X-CSRF-TOKEN': csrfToken() },   
      body: buildAccountInfoFormData(form)
    });

    if(!res.ok){
      const data = await res.json().catch(()=>({}));
      showToast(data.message || 'تعذر حفظ معلومات الحساب', 'warning');
      return false;
    }

    const saved = await res.json();
    applySavedAccountInfo(saved);
    showToast('تم حفظ معلومات الحساب بنجاح');
    return true;
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
    return false;
  } finally {
    if(dismissLoadingToast) dismissLoadingToast();
    if(btn){
      btn.disabled = false;
      btn.innerHTML = originalHtml;
    }
  }
}

function applySavedAccountInfo(saved){
  CURRENT_USER.name = saved.name;
  CURRENT_USER.email = saved.email;
  CURRENT_USER.mobile = saved.mobile;
  CURRENT_USER.avatar = saved.avatar;
  CURRENT_USER.hasPhoto = saved.hasPhoto;

