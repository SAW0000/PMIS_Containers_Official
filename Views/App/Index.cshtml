];

function renderExtOptions(selected){
  const pop = document.getElementById('extPopover');
  if(!pop) return;
  const chosen = new Set((selected || []).map(v => String(v).toUpperCase()));
  pop.innerHTML = `<div class="ext-opt-list">` + ATTACHMENT_EXT_OPTIONS.map(opt => `
    <label class="ext-opt">
      <input type="checkbox" value="${opt.value}"${chosen.has(opt.value) ? ' checked' : ''}>
      <span class="box">${CHECK_TINY_SVG}</span>
      <span class="mono">${opt.value}</span>
      ${opt.note ? `<span class="why">${opt.note}</span>` : ''}
    </label>`).join('') + `</div>`;
  pop.querySelectorAll('input[type=checkbox]').forEach(box => {
    box.addEventListener('change', syncExtSummary);
  });
  syncExtSummary();
}

function selectedExtensions(){
  return [...document.querySelectorAll('#extPopover input[type=checkbox]:checked')].map(b => b.value);
}

function syncExtSummary(){
  const chosen = selectedExtensions();
  const summary = document.getElementById('extSummary');
  if(summary){
    summary.textContent = chosen.join('  ·  ');
    const count = document.createElement('span');
    count.className = 'ext-count';
    count.textContent = `(${chosen.length})`;
    summary.appendChild(count);
  }
  document.querySelectorAll('#extPopover input[type=checkbox]').forEach(box => {
    const isLastChecked = chosen.length === 1 && box.checked;
    box.disabled = isLastChecked;
    box.closest('.ext-opt').classList.toggle('locked', isLastChecked);
  });
}

function toggleExtPopover(ev){
  ev.stopPropagation();
  const wrap = document.getElementById('extPopWrap');
  const pop = document.getElementById('extPopover');
  const trigger = document.getElementById('extTrigger');
  if(pop.classList.contains('open')){ closeExtPopover(); return; }

  closePhotoExtPopover();
  closeSystemsPopover();
  document.getElementById('profileMenu').classList.remove('open');
  closeThemePicker();
  closeNotifPopover();
  closeMenuPop();
  closeCtxMenu();
  closeAllPeriodPopovers();

  document.body.appendChild(pop);
  pop.classList.add('open');
  wrap.classList.add('open');
  trigger.setAttribute('aria-expanded','true');

  const r = trigger.getBoundingClientRect();
  pop.style.width = `${r.width}px`;
  pop.style.left = `${r.left}px`;
  const popHeight = pop.offsetHeight;
  const roomBelow = window.innerHeight - r.bottom;
  pop.style.top = `${roomBelow < popHeight + 12 ? Math.max(8, r.top - popHeight - 6) : r.bottom + 6}px`;
}

function closeExtPopover(){
  const pop = document.getElementById('extPopover');
  const wrap = document.getElementById('extPopWrap');
  if(!pop || !pop.classList.contains('open')) return;
  pop.classList.remove('open');
  if(wrap){
    wrap.classList.remove('open');
    wrap.appendChild(pop);   
    document.getElementById('extTrigger').setAttribute('aria-expanded','false');
  }
}

