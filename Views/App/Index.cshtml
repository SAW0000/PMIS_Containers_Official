async function confirmModalAction(){
  if(!modalAction.reason){
    showToast('يرجى اختيار السبب أولًا', 'warning');
    return;
  }
  const btn = document.getElementById('modalConfirmBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ التأكيد...`;

  const note = document.getElementById('modalNote').value.trim() || 'بدون ملاحظة إضافية';
  const action = modalAction.type==='return' ? 'return' : 'reject';
  const successMessage = modalAction.type==='return' ? 'تمت إعادة الطلب للمستفيد مع الملاحظة' : 'تم رفض الطلب وإشعار المستفيد';

  try{
    const res = await fetch(`/app/requests/${encodeURIComponent(modalAction.id)}/${action}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ note, reasonId: modalAction.reason })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(data.message || 'تعذر تنفيذ الإجراء', 'warning');
      return;
    }
    await refreshRequestsData();
    closeModal();
    showToast(successMessage);
  } catch(err){
    showToast('تعذر الاتصال بالخادم', 'warning');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
    renderDetail(true);
    await renderReviewList();
  }
}

