const PERIOD_OPTIONS = [
  {key:'today', label:'اليوم'},
  {key:'week',  label:'هذا الأسبوع'},
  {key:'month', label:'هذا الشهر'},
  {key:'year',  label:'هذا السنة'},
  {key:'all',   label:'كل الأوقات'},
];
let benPeriod = 'month';
let reportPeriod = 'month';
let reportsTotalFlaggedCount = 0;
const PERIOD_CHEVRON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"><path d="M6 9l6 6l6 -6"/></svg>';

let periodPopAnchorSeq = 0;
const openPeriodPopovers = new Set(); 
function openPeriodPopover(wrap, btn, pop){
  wrap.classList.add('open');
  pop.classList.add('open');
  if(!pop.dataset.periodAnchor){
    const anchorId = 'period-pop-anchor-'+(periodPopAnchorSeq++);
    const anchor = document.createElement('span');
    anchor.id = anchorId;
    anchor.style.display = 'none';
    pop.before(anchor);
    pop.dataset.periodAnchor = anchorId;
    document.body.appendChild(pop);
  }
  positionPeriodPopover(btn, pop);
  openPeriodPopovers.add({wrap, btn, pop});
}
function closePeriodPopover(entry){
  entry.wrap.classList.remove('open');
  entry.pop.classList.remove('open');
  if(entry.pop.dataset.periodAnchor){
    const anchor = document.getElementById(entry.pop.dataset.periodAnchor);
    if(anchor){ anchor.replaceWith(entry.pop); }
    delete entry.pop.dataset.periodAnchor;
  }
  entry.pop.style.top = ''; entry.pop.style.left = ''; entry.pop.style.bottom = '';
  openPeriodPopovers.delete(entry);
}
function closeAllPeriodPopovers(){
  openPeriodPopovers.forEach(closePeriodPopover);
}
function closeAllFilterPopovers(){
  closeAllPeriodPopovers();
  closeBenStatusPopover();
  closeBenPeriodPopover();
  closeReviewStatusPopover();
  closeReviewPeriodPopover();
  closeAdminUsersRolePopover();
  closeAdminUsersActivePopover();
  closeSystemsPopover();
  closeExtPopover();
  closePhotoExtPopover();
}
function positionPeriodPopover(btn, pop){
  const r = btn.getBoundingClientRect();
  const popW = pop.offsetWidth || 150;
  const popH = pop.offsetHeight || 200;
  const left = Math.min(r.left, window.innerWidth - popW - 12);
  const navH = window.matchMedia(SNAP_BREAKPOINT).matches
    ? (document.getElementById('bottomNav')?.getBoundingClientRect().height || 64)
    : 0;
  const safeBottom = window.innerHeight - navH - 8;
  const fitsBelow = (r.bottom + 6 + popH) <= safeBottom;
  pop.style.left = Math.max(12, left) + 'px';
  if(fitsBelow){
    pop.style.top = (r.bottom + 6) + 'px';
    pop.style.bottom = '';
  } else {
    pop.style.top = '';
    pop.style.bottom = (window.innerHeight - r.top + 6) + 'px';
  }
}
function renderPeriodControl(wrapId, btnId, popId, period, onSelect){
  const wrap = document.getElementById(wrapId);
  const btn = document.getElementById(btnId);
  const pop = document.getElementById(popId);
  if(!wrap || !btn || !pop) return;
  const current = PERIOD_OPTIONS.find(p=>p.key===period) || PERIOD_OPTIONS[2];
  btn.innerHTML = `${current.label}${PERIOD_CHEVRON}`;
  pop.innerHTML = PERIOD_OPTIONS.map(p=>
    `<button type="button" class="period-opt${p.key===period?' active':''}" data-period="${p.key}">${p.label}</button>`
  ).join('');
  pop.querySelectorAll('.period-opt').forEach(el=>{
    el.onclick = (e)=>{
      e.stopPropagation();
      const entry = Array.from(openPeriodPopovers).find(en=>en.pop===pop);
      if(entry) closePeriodPopover(entry);
      onSelect(el.dataset.period);
    };
  });
  btn.onclick = (e)=>{
    e.stopPropagation();
    const wasOpen = pop.classList.contains('open');
    closeAllPeriodPopovers();
    document.getElementById('profileMenu').classList.remove('open');
    closeThemePicker();
    closeNotifPopover();
    closeMenuPop();
    closeCtxMenu();
    if(!wasOpen) openPeriodPopover(wrap, btn, pop);
  };
}
