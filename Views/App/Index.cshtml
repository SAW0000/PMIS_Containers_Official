async function submitAddUser(){
  const firstName = document.getElementById('addUserFirstName').value.trim();
  const lastName = document.getElementById('addUserLastName').value.trim();
  const email = document.getElementById('addUserEmail').value.trim();
  const mobile = document.getElementById('addUserMobile').value.trim();
  const nationalId = document.getElementById('addUserNationalId').value.trim();
  const roles = getSelectedRoles('addUserRoleInput');
  const errorEl = document.getElementById('addUserError');
  errorEl.style.display = 'none';

  if(!firstName || !lastName || !email || !mobile || !nationalId){
    errorEl.textContent = 'جميع الحقول مطلوبة';
    errorEl.style.display = 'block';
    return;
  }
  if(!roles.length){
    errorEl.textContent = 'يجب اختيار صفة واحدة على الأقل';
    errorEl.style.display = 'block';
    return;
  }
  if(!WIZ_EMAIL_REGEX.test(email)){
    errorEl.textContent = 'صيغة البريد الإلكتروني غير صحيحة';
    errorEl.style.display = 'block';
    return;
  }
  if(!WIZ_MOBILE_REGEX.test(mobile)){
    errorEl.textContent = 'رقم الجوال غير صحيح — يجب أن يبدأ بـ 05 ويتكون من 10 أرقام';
    errorEl.style.display = 'block';
    return;
  }
  if(!/^[12]\d{9}$/.test(nationalId)){
    errorEl.textContent = 'رقم الهوية الوطنية/الإقامة غير صحيح — يجب أن يتكون من 10 أرقام ويبدأ بـ 1 أو 2';
    errorEl.style.display = 'block';
    return;
  }

  const btn = document.getElementById('addUserSubmitBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = `${SPIN_RING}جارٍ الإنشاء...`;

  try{
    const res = await fetch('/app/admin/users', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
      body: JSON.stringify({ firstName, lastName, email, mobile, nationalId, roles })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      errorEl.textContent = data.message || 'تعذر إنشاء الحساب';
      errorEl.style.display = 'block';
      return;
    }
    closeAddUserModal();
    await renderAdminUsers();
    showToast('تم إنشاء الحساب بنجاح');
  } catch(err){
    errorEl.textContent = 'تعذر الاتصال بالخادم';
    errorEl.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}

