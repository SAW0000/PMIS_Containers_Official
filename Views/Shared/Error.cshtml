@model ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>حدث خطأ ما — خدمة طلب شراء رخص نظام إدارة المشاريع</title>
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" asp-append-version="true">
<link rel="stylesheet" href="/assets/styles.css" asp-append-version="true">
<script src="/assets/lockdown.js" asp-append-version="true" defer></script>
<script>
  try{ if(localStorage.getItem('pmis-theme')==='dark') document.documentElement.setAttribute('data-theme','dark'); }catch(e){}
  try{ const b=localStorage.getItem('pmis-brand'); if(b!=='blue') document.documentElement.setAttribute('data-brand', 'amana'); }catch(e){}
</script>
<style>
  html{height:auto;min-height:100%;overflow-y:auto;touch-action:pan-y;overscroll-behavior:auto;}
  body{
    min-height:100vh;
    height:auto;overflow-y:auto;overflow-x:hidden;
    touch-action:pan-y;
    overscroll-behavior:auto;
    display:flex;
    align-items:safe center;
    justify-content:center;
    padding:28px 16px;
    background:var(--bg);
    position:relative;
  }
  body::before{
    content:"";position:fixed;z-index:0;pointer-events:none;
    border-radius:50%;
    will-change:transform,opacity;
    top:-10%;left:-10%;width:60vw;height:60vw;
    background:radial-gradient(circle, var(--bg-glow-a) 0%, transparent 70%);
    animation:bg-breathe-a 16s ease-in-out infinite;
  }
  @@keyframes bg-breathe-a{
    0%,100%{transform:scale(1) translate(0,0);opacity:.85;}
    50%{transform:scale(1.15) translate(-2%,2%);opacity:1;}
  }
  @@media (prefers-reduced-motion: reduce){
    body::before{animation:none;}
  }

  .err-shell{position:relative;z-index:1;width:100%;max-width:452px;}
  .err-card{
    direction:rtl;
    background:var(--glass-bg);backdrop-filter:var(--glass-blur);-webkit-backdrop-filter:var(--glass-blur);
    border-radius:22px;box-shadow:var(--shadow-lg);
    border:1px solid var(--glass-border);
    animation:err-card-fadein 1.1s ease;
    padding:40px 32px 32px;
    text-align:center;
  }
  @@keyframes err-card-fadein{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}

  .err-icon-wrap{display:flex;justify-content:center;margin-bottom:22px;}
  .err-icon-wrap svg{width:min(220px,72vw);height:auto;display:block;}

  .err-title{font-size:22px;font-weight:800;color:var(--text-dark);margin:0 0 10px;}
  .err-sub{font-size:13.5px;line-height:1.75;color:var(--text-mid);margin:0 0 26px;max-width:34ch;margin-inline:auto;}

  .btn-back{
    display:flex;flex-direction:row-reverse;align-items:center;justify-content:center;gap:8px;
    width:100%;padding:14px;border-radius:12px;border:none;
    background:var(--brand-800);color:#fff;
    font-family:inherit;font-size:14.5px;font-weight:700;cursor:pointer;
    transition:background .15s ease;
  }
  .btn-back:hover{background:var(--brand-900);}
  .btn-back svg{width:16px;height:16px;flex-shrink:0;}

  @@media (max-width:560px){
    .err-card{padding:32px 22px 24px;border-radius:18px;}
    .err-title{font-size:18px;}
    .err-sub{font-size:12.5px;}
  }
</style>
</head>
<body>
  <div class="err-shell">
    <div class="err-card">
      <div class="err-icon-wrap">
        <svg width="800" height="430.493" viewBox="0 0 800 430.493" role="img" aria-hidden="true">
          <style>
            @@keyframes dcFade{from{opacity:0}to{opacity:1}}
            @@keyframes dcRise{from{opacity:0;transform:translateY(26px) scale(.94)}to{opacity:1;transform:none}}
            @@keyframes dcWire{from{opacity:0;transform:translateX(-18px) scale(.97)}to{opacity:1;transform:none}}
            @@keyframes dcScreen{0%{opacity:0}18%{opacity:1}26%{opacity:.15}38%{opacity:1}46%{opacity:.35}60%{opacity:1}68%{opacity:.6}100%{opacity:1}}
            @@keyframes dcPop{0%{opacity:0;transform:scale(.2) rotate(-14deg)}60%{opacity:1;transform:scale(1.14) rotate(4deg)}80%{transform:scale(.96) rotate(-2deg)}100%{opacity:1;transform:none}}
            @@keyframes dcSlide{from{opacity:0;transform:translateX(-42px)}to{opacity:1;transform:none}}
            #dc-shadow{animation:.7s ease-out .05s both dcFade}
            #dc-wire{transform-box:fill-box;transform-origin:left center 0;animation:.8s cubic-bezier(.2,.7,.3,1) .55s both dcWire}
            #dc-monitor{transform-box:fill-box;transform-origin:center bottom 0;animation:.75s cubic-bezier(.2,.8,.25,1) .12s both dcRise}
            #dc-screen{animation:1.15s ease-out .5s both dcScreen}
            #dc-row1{transform-box:fill-box;transform-origin:left center 0;animation:.6s cubic-bezier(.2,.8,.25,1) .45s both dcSlide}
            #dc-row2{transform-box:fill-box;transform-origin:left center 0;animation:.6s cubic-bezier(.2,.8,.25,1) .57s both dcSlide}
            #dc-row3{transform-box:fill-box;transform-origin:left center 0;animation:.6s cubic-bezier(.2,.8,.25,1) .69s both dcSlide}
            #dc-badge{transform-box:fill-box;transform-origin:center center 0;animation:.7s cubic-bezier(.2,.9,.3,1.2) .95s both dcPop}
            @@media (prefers-reduced-motion: reduce){#dc-shadow,#dc-wire,#dc-monitor,#dc-screen,#dc-row1,#dc-row2,#dc-row3,#dc-badge{animation:none;opacity:1;transform:none}}
          </style>
          <g transform="translate(-368.866 -254.661)">
            <g id="dc-shadow">
              <ellipse cx="149.199" cy="26.107" rx="149.199" ry="26.107" transform="translate(368.866 481.453)" fill="#090814"/>
              <ellipse cx="191.906" cy="26.107" rx="191.906" ry="26.107" transform="translate(785.054 632.939)" fill="#090814"/>
            </g>
            <g id="dc-wire">
